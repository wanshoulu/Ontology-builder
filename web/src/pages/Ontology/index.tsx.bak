const { Title, Text } = Typography;

/** 从完整URI / 前缀名 / 尖括号形式中提取纯本地名 */
const extractLocalName = (iri: string | undefined | null): string => {
  if (!iri) return '';
  let cleaned = iri.replace(/^<\s*|\s*>$/g, '').trim();
  cleaned = cleaned.replace(/^[^:]*:/, '');
  const hashIdx = cleaned.lastIndexOf('#');
  const slashIdx = cleaned.lastIndexOf('/');
  const startIdx = Math.max(hashIdx, slashIdx);
  return startIdx >= 0 ? cleaned.substring(startIdx + 1) : cleaned;
};

/** 比较两个 IRI 是否指向同一实体（容忍命名空间前缀差异） */
const iriMatches = (iriA: string | undefined | null, iriB: string | undefined | null): boolean => {
  if (!iriA || !iriB) return false;
  if (iriA === iriB) return true;
  const localA = extractLocalName(iriA);
  const localB = extractLocalName(iriB);
  return localA !== '' && localA === localB;
};

interface OntologyVersion {
  id: string;
  version: string;
  versionName: string;
  name: string;
  description: string;
  status: string;
  classCount: number;
  propertyCount: number;
  ttlPath: string | null;
  instantiated: boolean;
  createdAt: string;
  updatedAt: string;
  current: boolean;
  ruleCount?: number;
  individualCount?: number;
  objectPropertyCount?: number;
  dataPropertyCount?: number;
  sourceMdFileName?: string;
  sourceMdFileId?: string;
  sourceModelName?: string;
  ttlGeneratedAt?: string;
}

const NODE_COLORS = [
  '#1677ff', '#722ed1', '#13c2c2', '#eb2f96', '#fa8c16',
  '#52c41a', '#2f54eb', '#faad14', '#f5222d', '#1d39c4',
  '#9254de', '#36cfc9', '#ff85c0', '#ffc53d', '#73d13d',
];

const VERSION_NAME_PATTERN = /^[\u4e00-\u9fa5a-zA-Z0-9_ \-]{1,50}$/;

// 默认提示词由后端 ontomind-agent 的 ONTOLOGY_EXTRACTION_SYSTEM_PROMPT 统一管理
// 前端传空字符串时，后端自动使用内置最新版本
// 用户可通过 UI "展开编辑" 自定义覆盖
const DEFAULT_SYSTEM_PROMPT = '';

// ===== LLM Wiki 结构化文档体系生成提示词 =====
// 指导 AI 将单一 Markdown 文档拆解为结构化的 Wiki 文档树
const OntologyPage: React.FC = () => {
  // 模型选择
  const [activeProviders, setActiveProviders] = useState<ModelProvider[]>([]);
  const [selectedModelKey, setSelectedModelKey] = useState<string>('');

  // 提取对话框
  const [extractModalVisible, setExtractModalVisible] = useState(false);
  const [extractPhase, setExtractPhase] = useState<'config' | 'extracting' | 'paused' | 'done'>('config');
  const [mdFileList, setMdFileList] = useState<FileUploadRecord[]>([]);
  const [mdFileLoading, setMdFileLoading] = useState(false);
  const [selectedFileId, setSelectedFileId] = useState<string>('');
  const [systemPrompt, setSystemPrompt] = useState<string>(DEFAULT_SYSTEM_PROMPT);
  const [showPromptEditor, setShowPromptEditor] = useState<boolean>(false);

  // 将 mdFileList 按存储类型 → tenantId 两级分组构建 TreeSelect 树形数据
  const buildMdFileTreeData = useCallback((files: FileUploadRecord[]) => {
    // 按存储类型分组：本地 / MinIO
    const localFiles = files.filter(f => (f.storageType || 'LOCAL').toUpperCase() === 'LOCAL');
    const minioFiles = files.filter(f => (f.storageType || 'LOCAL').toUpperCase() === 'MINIO');

    const buildTenantGroup = (fileList: FileUploadRecord[]) => {
      const folderMap = new Map<string, { title: string; value: string; key: string; selectable: boolean; children: any[] }>();
      fileList.forEach(f => {
        const folderKey = f.tenantId && f.tenantId !== 'default' ? f.tenantId : 'default';
        const folderLabel = f.tenantId && f.tenantId !== 'default' ? f.tenantId : '根目录';
        if (!folderMap.has(folderKey)) {
          folderMap.set(folderKey, {
            title: folderLabel,
            value: `__folder_${folderKey}`,
            key: `__folder_${folderKey}`,
            selectable: false,
            children: [],
          });
        }
        folderMap.get(folderKey)!.children.push({
          title: `${f.originalFilename} (${(f.fileSize / 1024).toFixed(1)} KB)`,
          value: f.id,
          key: f.id,
        });
      });
      if (folderMap.size === 1 && folderMap.has('default')) {
        return folderMap.get('default')!.children;
      }
      const nodes: any[] = [];
      folderMap.forEach(node => nodes.push(node));
      nodes.sort((a, b) => (a.key === '__folder_default' ? -1 : b.key === '__folder_default' ? 1 : 0));
      return nodes;
    };

    const result: any[] = [];
    const localChildren = buildTenantGroup(localFiles);
    if (localChildren.length > 0) {
      result.push({
        title: '本地存储',
        value: '__storage_local',
        key: '__storage_local',
        selectable: false,
        children: localChildren,
      });
    }
    const minioChildren = buildTenantGroup(minioFiles);
    if (minioChildren.length > 0) {
      result.push({
        title: 'MinIO对象存储',
        value: '__storage_minio',
        key: '__storage_minio',
        selectable: false,
        children: minioChildren,
      });
    }
    return result;
  }, []);

  // 流式输出
  const [streamContent, setStreamContent] = useState('');
  const [extractStatus, setExtractStatus] = useState<string>('');
  const streamEndRef = useRef<HTMLDivElement>(null);
  const abortControllerRef = useRef<AbortController | null>(null);

  // 提取结果
  const [extractionResult, setExtractionResult] = useState<OntologyExtractionResult | null>(null);

  // TTL文件导入对话框
  const [importTtlModalVisible, setImportTtlModalVisible] = useState(false);
  const [importTtlName, setImportTtlName] = useState('');
  const [importTtlVersionName, setImportTtlVersionName] = useState('');
  const [ttlUploadFile, setTtlUploadFile] = useState<File | null>(null);
  const [importTtlLoading, setImportTtlLoading] = useState(false);

  // 保存：本体名称 & 版本名称
  const [ontologyName, setOntologyName] = useState('');
  const [versionName, setVersionName] = useState('');
  const [saving, setSaving] = useState(false);

  // 所有本体版本列表
  const [allVersions, setAllVersions] = useState<OntologyVersion[]>([]);
  const [allVersionsLoading, setAllVersionsLoading] = useState(false);
  const [searchText, setSearchText] = useState('');
  const [selectedVersionId, setSelectedVersionId] = useState<string>('');
  const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[]>([]);

  // TTL 查看
  const [ttlContent, setTtlContent] = useState('');
  const [ttlVisible, setTtlVisible] = useState(false);
  const [ttlLoading, setTtlLoading] = useState(false);

  // TTL 在线编辑
  const [editTtlVisible, setEditTtlVisible] = useState(false);
  const [editTtlContent, setEditTtlContent] = useState('');
  const [editTtlId, setEditTtlId] = useState('');
  const [editTtlLoading, setEditTtlLoading] = useState(false);
  const [editTtlSaving, setEditTtlSaving] = useState(false);

  // 重命名
  const [renameVisible, setRenameVisible] = useState(false);
  const [renameId, setRenameId] = useState('');
  const [renameName, setRenameName] = useState('');
  const [renameVersionName, setRenameVersionName] = useState('');
  const [renameSaving, setRenameSaving] = useState(false);

  // 提取模型查看
  const [extractModelVisible, setExtractModelVisible] = useState(false);
  const [extractModelLoading, setExtractModelLoading] = useState(false);
  const [extractModelClasses, setExtractModelClasses] = useState<any[]>([]);
  const [extractModelObjProps, setExtractModelObjProps] = useState<any[]>([]);
  const [extractModelDataProps, setExtractModelDataProps] = useState<any[]>([]);

  // 本体模型列表面板宽度（可拖拽调整）
  const [leftPanelWidth, setLeftPanelWidth] = useState(620);
  const [leftDragging, setLeftDragging] = useState(false);
  const dragStartXRef = useRef(0);
  const dragStartWidthRef = useRef(620);

  const handlePanelMouseDown = useCallback((e: React.MouseEvent) => {
    e.preventDefault();
    setLeftDragging(true);
    dragStartXRef.current = e.clientX;
    dragStartWidthRef.current = leftPanelWidth;
  }, [leftPanelWidth]);

  useEffect(() => {
    if (!leftDragging) return;
    const handleMouseMove = (e: MouseEvent) => {
      const delta = e.clientX - dragStartXRef.current;
      const newWidth = Math.max(400, Math.min(900, dragStartWidthRef.current + delta));
      setLeftPanelWidth(newWidth);
    };
    const handleMouseUp = () => {
      setLeftDragging(false);
    };
    window.addEventListener('mousemove', handleMouseMove);
    window.addEventListener('mouseup', handleMouseUp);
    return () => {
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('mouseup', handleMouseUp);
    };
  }, [leftDragging]);
  const [extractModelRules, setExtractModelRules] = useState<any[]>([]);
  const [extractModelIndividuals, setExtractModelIndividuals] = useState<any[]>([]);
  const [extractModelName, setExtractModelName] = useState('');

  // 图可视化
  const graphContainerRef = useRef<HTMLDivElement>(null);
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const graphRef = useRef<any>(null);
  const [browseClasses, setBrowseClasses] = useState<any[]>([]);
  const [browseProperties, setBrowseProperties] = useState<any[]>([]);
  const [graphLoading, setGraphLoading] = useState(false);
  const [browseViewMode, setBrowseViewMode] = useState<'graph' | 'mindmap'>('graph');

  // TTL 校验 & 推理验证
  const [validateModalVisible, setValidateModalVisible] = useState(false);
  const [validateTarget, setValidateTarget] = useState<{ id: string; name: string; version: string; versionName: string } | null>(null);

  // 版本 Diff 和变更历史
  const [diffModalOpen, setDiffModalOpen] = useState(false);
  const [diffOntologyId, setDiffOntologyId] = useState('');
  const [diffOntologyName, setDiffOntologyName] = useState('');
  const [historyModalOpen, setHistoryModalOpen] = useState(false);
  const [historyOntologyName, setHistoryOntologyName] = useState('');
  const [validateActiveTab, setValidateActiveTab] = useState<string>('validate');
  const [validateLoading, setValidateLoading] = useState(false);
  const [validateResult, setValidateResult] = useState<any>(null);
  const [autoFixModalVisible, setAutoFixModalVisible] = useState(false);
  const [autoFixLoading, setAutoFixLoading] = useState(false);
  const [selectedFixIndices, setSelectedFixIndices] = useState<number[]>([]);
  const [selectedWarningIndices, setSelectedWarningIndices] = useState<number[]>([]);
  const [hermitResult, setHermitResult] = useState<any>(null);
  const [hermitLoading, setHermitLoading] = useState(false);
  const [pelletResult, setPelletResult] = useState<any>(null);
  const [pelletLoading, setPelletLoading] = useState(false);

  // Protégé 可视化精修
  const protegeGraphRef = useRef<HTMLDivElement>(null);
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const protegeGraphInstRef = useRef<any>(null);
  const [protegeClasses, setProtegeClasses] = useState<any[]>([]);
  const [protegeProperties, setProtegeProperties] = useState<any[]>([]);
  const [protegeLoading, setProtegeLoading] = useState(false);
  const [selectedNode, setSelectedNode] = useState<any>(null);
  const [selectedEdge, setSelectedEdge] = useState<any>(null);
  const [protegeViewMode, setProtegeViewMode] = useState<'graph' | 'mindmap'>('graph');
  const [graphZoom, setGraphZoom] = useState(1); // 画布缩放比例
  const [protegeActiveTab, setProtegeActiveTab] = useState<string>('graph');
  const [editClassModalVisible, setEditClassModalVisible] = useState(false);
  const [editLinkModalVisible, setEditLinkModalVisible] = useState(false);
  const [addClassModalVisible, setAddClassModalVisible] = useState(false);
  // 拖拽创建关系 Modal
  const [createEdgeModalVisible, setCreateEdgeModalVisible] = useState(false);
  const [edgeDraft, setEdgeDraft] = useState<{ sourceId: string; targetId: string } | null>(null);
  const [createEdgeForm] = Form.useForm();
  const [createEdgeSubmitting, setCreateEdgeSubmitting] = useState(false);
  // 双击编辑关系 Modal
  const [dblclickEditEdgeModalVisible, setDblclickEditEdgeModalVisible] = useState(false);
  const [dblclickSelectedEdge, setDblclickSelectedEdge] = useState<any>(null);
  const [dblclickEditEdgeForm] = Form.useForm();
  const [dblclickEditEdgeSubmitting, setDblclickEditEdgeSubmitting] = useState(false);
  const [addLinkModalVisible, setAddLinkModalVisible] = useState(false);
  const [editClassSaving, setEditClassSaving] = useState(false);
  const [editLinkSaving, setEditLinkSaving] = useState(false);
  const [protegeSaving, setProtegeSaving] = useState(false);
  // 业务规则管理
  const [protegeRules, setProtegeRules] = useState<any[]>([]);
  const [protegeIndividuals, setProtegeIndividuals] = useState<any[]>([]);
  const [rulesLoading, setRulesLoading] = useState(false);
  const [addRuleModalVisible, setAddRuleModalVisible] = useState(false);
  const [editRuleModalVisible, setEditRuleModalVisible] = useState(false);
  const [selectedRule, setSelectedRule] = useState<any>(null);
  const [ruleSaving, setRuleSaving] = useState(false);
  const [ruleForm] = Form.useForm();
  const [form] = Form.useForm();
  const [linkForm] = Form.useForm();
  const [dataPropForm] = Form.useForm();
  const [addDataPropModalVisible, setAddDataPropModalVisible] = useState(false);
  const [dataPropSaving, setDataPropSaving] = useState(false);
  const [editDataPropModalVisible, setEditDataPropModalVisible] = useState(false);
  const [editingDataProp, setEditingDataProp] = useState<any>(null);
  const [editingDataPropClassId, setEditingDataPropClassId] = useState<string>('');
  // 继承类(subClassOf)管理
  const [subClassForm] = Form.useForm();
  const [addSubClassModalVisible, setAddSubClassModalVisible] = useState(false);
  const [editingSubClassRecord, setEditingSubClassRecord] = useState<any>(null);
  const [subClassSaving, setSubClassSaving] = useState(false);

  // 右键菜单 - 添加关系连线
  const [contextMenuNode, setContextMenuNode] = useState<any>(null);
  const [contextMenuPosition, setContextMenuPosition] = useState<{ x: number; y: number } | null>(null);
  const [contextMenuVisible, setContextMenuVisible] = useState(false);
  const [edgeCreating, setEdgeCreating] = useState(false); // 是否正在创建连线状态

  // 使用 ref 存储这些状态，避免触发 renderProtegeGraph 重新渲染
  const edgeCreatingRef = useRef(false);
  const contextMenuNodeRef = useRef<any>(null);
  // 同步 state 和 ref
  useEffect(() => {
    edgeCreatingRef.current = edgeCreating;
  }, [edgeCreating]);

  useEffect(() => {
    contextMenuNodeRef.current = contextMenuNode;
  }, [contextMenuNode]);

  const loadActiveProviders = useCallback(async () => {
    try {
      const allProviders = await getProviderList();
      const active = (allProviders || []).filter(p => p.status?.toUpperCase() === 'ACTIVE');
      setActiveProviders(active);
      if (active.length > 0 && !selectedModelKey) {
        const firstWithModels = active.find(p => p.models?.length > 0);
        if (firstWithModels?.models?.[0]) {
          setSelectedModelKey(`${firstWithModels.id}::${firstWithModels.models[0].modelId}`);
        }
      }
    } catch { /* silent */ }
  }, [selectedModelKey]);

  useEffect(() => { loadActiveProviders(); }, [loadActiveProviders]);

  // 页面加载时获取所有本体版本
  const loadAllVersions = useCallback(async () => {
    setAllVersionsLoading(true);
    try {
      const data = await getAllOntologyVersions();
      setAllVersions(data || []);
    } catch {
      setAllVersions([]);
    } finally {
      setAllVersionsLoading(false);
    }
  }, []);

  useEffect(() => { loadAllVersions(); }, [loadAllVersions]);

  // 清理 G6 graph
  useEffect(() => {
    return () => {
      if (graphRef.current) {
        graphRef.current.destroy();
        graphRef.current = null;
      }
    };
  }, []);

  // 自动滚动到底部
  useEffect(() => {
    if (streamEndRef.current) {
      streamEndRef.current.scrollIntoView({ behavior: 'instant' });
    }
  }, [streamContent]);

  // ===== Markdown自动提取本体模型 =====
  const handleOpenExtractModal = async () => {
    setExtractModalVisible(true);
    setExtractPhase('config');
    setStreamContent('');
    setExtractionResult(null);
    setSelectedFileId('');
    setSystemPrompt('');  // 先置空，后端获取后再填充
    setShowPromptEditor(false);
    setOntologyName('');
    setVersionName('');
    // 加载已上传的 Markdown 文件列表（跨所有文件夹、所有存储类型）
    setMdFileLoading(true);
    try {
      const files = await listAllCompletedFiles();
      const mdFiles = (files || []).filter(
        f => f.originalFilename?.toLowerCase().endsWith('.md') || f.originalFilename?.toLowerCase().endsWith('.markdown'),
      );
      setMdFileList(mdFiles);
    } catch {
      setMdFileList([]);
    } finally {
      setMdFileLoading(false);
    }
    // 从后端获取默认提示词
    try {
      const defaultPrompt = await fetchDefaultOntologyExtractionPrompt();
      if (defaultPrompt) setSystemPrompt(defaultPrompt);
    } catch { /* 获取失败使用空字符串 */ }
  };

  const handleStartExtraction = async () => {
    if (!selectedFileId) { message.warning('请选择要转换的Markdown文件'); return; }
    if (!selectedModelKey) { message.warning('请先选择提取模型'); return; }
    if (!ontologyName.trim()) { message.warning('请定义本体模型名称'); return; }
    if (!versionName.trim()) { message.warning('请定义本体模型版本号名称'); return; }
    if (!VERSION_NAME_PATTERN.test(versionName.trim())) {
      message.warning('版本名称仅支持中英文/数字/空格/下划线/短横线，且不超过50个字符');
      return;
    }

    setExtractPhase('extracting');
    setStreamContent('');
    setExtractStatus('');
    setExtractionResult(null);

    try {
      const [providerId, modelId] = selectedModelKey.split('::');

      const abortController = new AbortController();
      abortControllerRef.current = abortController;

      // 直接传递 fileId，由后端读取文件内容（与文件转Markdown相同的方式）
      await importFromMarkdownStream(
        selectedFileId,
        providerId || '',
        modelId || '',
        systemPrompt.trim(),
        (content: string) => { setStreamContent(prev => prev + content); },
        (result: OntologyExtractionResult) => {
          const safeResult: OntologyExtractionResult = {
            name: result?.name || '',
            description: result?.description || '',
            classes: Array.isArray(result?.classes) ? result.classes : [],
            objectProperties: Array.isArray(result?.objectProperties) ? result.objectProperties : [],
            dataProperties: Array.isArray(result?.dataProperties) ? result.dataProperties : [],
            rules: Array.isArray(result?.rules) ? result.rules : [],
            ttlContent: result?.ttlContent || '',
          };
          setExtractionResult(safeResult);
          setExtractPhase('done');
          message.success('本体模型自动提取完成');
        },
        (error: string) => {
          message.error('本体提取失败: ' + error);
          setExtractPhase('paused');
        },
        abortController.signal,
        (status: string) => { setExtractStatus(status); },
        (warning: string) => { console.warn(`提取警告: ${warning}`); },
      );
    } catch (error: any) {
      if (error.name !== 'AbortError') {
        message.error('本体提取失败: ' + (error.message || '未知错误'));
        setExtractPhase('paused');
      }
    } finally {
      abortControllerRef.current = null;
    }
  };

  const handlePauseExtraction = () => {
    if (abortControllerRef.current) {
      abortControllerRef.current.abort();
      setExtractPhase('paused');
      message.info('已暂停提取');
    }
  };

  const handleRetryExtraction = () => {
    handleStartExtraction();
  };

  const handleSaveResult = async () => {
    if (!extractionResult) return;
    setSaving(true);
    try {
      // 查找源 MD 文件名
      const srcFile = mdFileList.find(f => f.id === selectedFileId);
      const sourceMdFileName = srcFile?.originalFilename || '';
      // 查找模型名称
      let sourceModelName = '';
      if (selectedModelKey) {
        const [pId, mId] = selectedModelKey.split('::');
        const provider = activeProviders.find(p => p.id === pId);
        const model = provider?.models?.find(m => m.modelId === mId);
        sourceModelName = model ? `${model.name} · ${provider?.name || ''}` : '';
      }
      const saved = await saveOntologyVersion({
        name: ontologyName.trim(),
        versionName: versionName.trim(),
        description: extractionResult.description || '',
        classes: extractionResult.classes || [],
        objectProperties: extractionResult.objectProperties || [],
        dataProperties: extractionResult.dataProperties || [],
        rules: extractionResult.rules || [],
        ttlContent: extractionResult.ttlContent || '',
        sourceMdFileName,
        sourceMdFileId: selectedFileId,
        sourceModelName,
      });
      message.success(`本体模型保存成功，版本 ${saved.versionName}`);
      setExtractModalVisible(false);
      setExtractionResult(null);
      setStreamContent('');
      setSelectedFileId('');
    setSystemPrompt('');
    setShowPromptEditor(false);
      setSelectedVersionId(saved.id);
      await loadAllVersions();
    } catch (error: any) {
      message.error('保存失败: ' + (error.message || '未知错误'));
    } finally {
      setSaving(false);
    }
  };

  // (wizard handlers removed — see WikiBuilder page)

  // ===== TTL文件直接导入 =====
  const handleOpenImportTtlModal = () => {
    setImportTtlModalVisible(true);
    setImportTtlName('');
    setImportTtlVersionName('');
    setTtlUploadFile(null);
  };

  const handleImportTtl = async () => {
    if (!importTtlName.trim()) { message.warning('请输入本体模型名称'); return; }
    if (!ttlUploadFile) { message.warning('请选择要导入的TTL文件'); return; }
    if (!importTtlVersionName.trim()) { message.warning('请输入版本号名称'); return; }
    if (!VERSION_NAME_PATTERN.test(importTtlVersionName.trim())) {
      message.warning('版本名称仅支持中英文/数字/空格/下划线/短横线，且不超过50个字符');
      return;
    }

    setImportTtlLoading(true);
    try {
      // 先上传文件到文件管理系统（使用当前选择的存储类型）
      const formData = new FormData();
      formData.append('file', ttlUploadFile);
      const currentStorageType = localStorage.getItem('ontomind_storage_type') || 'local';
      formData.append('configJson', JSON.stringify({ storageType: currentStorageType }));
      const uploaded = await uploadFile(formData);

      // 再调用导入接口
      const saved = await importTtlFile(uploaded.id, importTtlName.trim(), importTtlVersionName.trim());
      message.success(`TTL本体模型导入成功，版本 ${saved.versionName}`);
      setImportTtlModalVisible(false);
      setSelectedVersionId(saved.id);
      await loadAllVersions();
    } catch (error: any) {
      message.error('导入失败: ' + (error.message || '未知错误'));
    } finally {
      setImportTtlLoading(false);
    }
  };

  // ===== TTL 查看 =====
  const handleViewTtl = async (ontologyId: string) => {
    setTtlContent('');
    setTtlVisible(true);
    setTtlLoading(true);
    try {
      const content = await getTtlContent(ontologyId);
      setTtlContent(content || '暂无 TTL 内容');
    } catch {
      setTtlContent('加载失败');
    } finally {
      setTtlLoading(false);
    }
  };

  // ===== TTL 在线编辑 =====
  const handleEditTtl = async (ontologyId: string) => {
    setEditTtlId(ontologyId);
    setEditTtlContent('');
    setEditTtlVisible(true);
    setEditTtlLoading(true);
    try {
      const content = await getTtlContent(ontologyId);
      setEditTtlContent(content || '');
    } catch {
      setEditTtlContent('');
      message.error('加载TTL内容失败');
    } finally {
      setEditTtlLoading(false);
    }
  };

  const handleSaveEditTtl = async () => {
    if (!editTtlId) return;
    setEditTtlSaving(true);
    try {
      await updateTtlContent(editTtlId, editTtlContent);
      message.success('TTL文件保存成功');
      setEditTtlVisible(false);
      // 如果当前选中的版本就是编辑的版本，刷新图可视化
      if (selectedVersionId === editTtlId) {
        loadGraphData(editTtlId);
      }
      await loadAllVersions();
    } catch {
      message.error('TTL文件保存失败');
    } finally {
      setEditTtlSaving(false);
    }
  };

  // ===== TTL 导出 =====
  const handleExportTtl = async (ontologyId: string, name: string, versionName: string, systemVersion?: string) => {
    try {
      const blob = await exportOntology(ontologyId);
      if (!blob || !(blob instanceof Blob) || blob.size === 0) {
        message.error('导出失败：TTL 文件内容为空，请先完成本体提取');
        return;
      }
      const displayVersion = versionName || systemVersion || '1.0.0';
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${name || 'ontology'}_${displayVersion}.ttl`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      message.success('本体模型TTL导出成功');
    } catch (e: any) {
      console.error('导出TTL失败:', e);
      message.error('导出失败：' + (e?.response?.status === 404 ? 'TTL 文件不存在，请先完成本体提取' : (e.message || '未知错误')));
    }
  };

  // ===== MD 导出 =====
  const handleExportMd = async (ontologyId: string, name: string, versionName: string, systemVersion?: string) => {
    try {
      const blob = await exportOntologyMarkdown(ontologyId);
      if (!blob || !(blob instanceof Blob) || blob.size === 0) {
        message.error('导出失败：MD 文件内容为空');
        return;
      }
      const displayVersion = versionName || systemVersion || '1.0.0';
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${name || 'ontology'}_${displayVersion}.md`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      message.success('本体模型 MD 文档导出成功');
    } catch (e: any) {
      console.error('导出MD失败:', e);
      message.error('导出MD失败：' + (e?.response?.status === 404 ? 'MD 文件不存在' : (e.message || '未知错误')));
    }
  };

  // ===== 重命名 =====
  const handleOpenRename = (ver: OntologyVersion) => {
    setRenameId(ver.id);
    setRenameName(ver.name || '');
    setRenameVersionName(ver.versionName || '');
    setRenameVisible(true);
  };

  const handleSaveRename = async () => {
    if (!renameId) return;
    setRenameSaving(true);
    try {
      await renameOntologyVersion(renameId, {
        name: renameName.trim(),
        versionName: renameVersionName.trim(),
      });
      message.success('重命名成功');
      setRenameVisible(false);
      await loadAllVersions();
      if (selectedVersionId === renameId) {
        setSelectedVersionId(renameId);
      }
    } catch (e: any) {
      message.error('重命名失败: ' + (e.message || '未知错误'));
    } finally {
      setRenameSaving(false);
    }
  };

  // ===== 提取模型查看 =====
  const handleViewExtractModel = async (ontologyId: string, name: string) => {
    setExtractModelVisible(true);
    setExtractModelName(name);
    setExtractModelLoading(true);
    setExtractModelClasses([]);
    setExtractModelObjProps([]);
    setExtractModelDataProps([]);
    setExtractModelRules([]);
    setExtractModelIndividuals([]);
    try {
      const [classes, linkTypes, rules, individuals] = await Promise.all([
        getObjectTypes(ontologyId),
        getLinkTypes(ontologyId),
        getRulesByOntology(ontologyId),
        getIndividuals(ontologyId),
      ]);
      const objProps = (linkTypes || []).filter((lt: any) => {
        return lt.sourceType || lt.targetType;
      });
      const dataProps = (linkTypes || []).filter((lt: any) => {
        return !lt.sourceType && !lt.targetType;
      });
      setExtractModelClasses(classes || []);
      setExtractModelObjProps(objProps);
      setExtractModelDataProps(dataProps);
      setExtractModelRules(rules || []);
      setExtractModelIndividuals(individuals || []);
    } catch (e: any) {
      message.error('加载提取模型失败: ' + (e.message || '未知错误'));
    } finally {
      setExtractModelLoading(false);
    }
  };

  // ===== TTL 校验 & 推理验证 =====

  // 获取某层校验的 Steps 状态
  const getLayerStatus = (result: any, layerIdx: number): 'finish' | 'error' | 'wait' | 'process' => {
    if (!Array.isArray(result.layers) || result.layers.length <= layerIdx) return 'wait';
    const layer = result.layers[layerIdx];
    if (layer.passed) return 'finish';
    return 'error';
  };

  const handleOpenValidate = (ver: OntologyVersion) => {
    setValidateTarget({ id: ver.id, name: ver.name, version: ver.version, versionName: ver.versionName });
    setValidateResult(null);
    setAutoFixModalVisible(false);
    setSelectedFixIndices([]);
    setHermitResult(null);
    setPelletResult(null);
    setValidateActiveTab('validate');
    setProtegeActiveTab('graph');
    setValidateModalVisible(true);
  };

  // ===== Protégé 可视化精修 =====
  const loadProtegeData = useCallback(async (options?: { skipTtlSync?: boolean }) => {
    if (!validateTarget) return;
    setProtegeLoading(true);
    setSelectedNode(null);
    setSelectedEdge(null);
    try {
      const [classes, properties] = await Promise.all([
        getObjectTypes(validateTarget.id),
        getLinkTypes(validateTarget.id),
      ]);
      setProtegeClasses(classes || []);
      setProtegeProperties(properties || []);
    } catch (e: any) {
      message.error('加载本体数据失败: ' + (e.message || '未知错误'));
    } finally {
      setProtegeLoading(false);
    }
    // 加载规则列表（仅在首次打开或手动刷新时从 TTL 同步到 DB）
    try {
      setRulesLoading(true);
      if (!options?.skipTtlSync) {
        await syncSwrlRules(validateTarget.id).catch(() => {});
      }
      const rules = await getRulesByOntology(validateTarget.id);
      setProtegeRules(rules || []);
    } catch {
      setProtegeRules([]);
    } finally {
      setRulesLoading(false);
    }
    // 加载个体（Named Individuals）通过 SPARQL 查询
    try {
      const individualsResult = await executeSparqlQuery(validateTarget.id,
        `PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?individual ?label ?type WHERE {
  ?individual a owl:NamedIndividual .
  OPTIONAL { ?individual rdfs:label ?label }
  OPTIONAL { ?individual rdf:type ?type . FILTER(?type != owl:NamedIndividual) }
}`);
      const bindings = individualsResult?.bindings || [];
      // 合并同一个体可能有的多个 type
      const individualMap = new Map<string, any>();
      for (const row of bindings) {
        const iri = row.individual || '';
        if (!iri) continue;
        if (!individualMap.has(iri)) {
          individualMap.set(iri, { iri, label: row.label || '', types: [] });
        }
        if (row.type && !individualMap.get(iri)!.types.includes(row.type)) {
          individualMap.get(iri)!.types.push(row.type);
        }
      }
      setProtegeIndividuals(Array.from(individualMap.values()));
    } catch {
      setProtegeIndividuals([]);
    }
  }, [validateTarget]);

  const renderProtegeGraph = useCallback(async () => {
    if (!protegeGraphRef.current) return;
    if (protegeGraphInstRef.current) {
      // 清理事件监听器
      const oldGraph = protegeGraphInstRef.current;
      if (oldGraph.__contextMenuClickHandler) {
        document.removeEventListener('click', oldGraph.__contextMenuClickHandler, true);
      }
      oldGraph.destroy();
      protegeGraphInstRef.current = null;
    }
    if (protegeClasses.length === 0 && protegeProperties.length === 0) return;

    try {
      const { Graph: G6Graph } = await import('@antv/g6');
      const hasInheritance = protegeClasses.some((c: any) => c.parentIri);

      // 构建颜色映射（不同对象类型使用不同颜色）
      const classColorMap: Record<string, string> = {};
      protegeClasses.forEach((cls: any, i: number) => {
        classColorMap[cls.iri || cls.id] = NODE_COLORS[i % NODE_COLORS.length];
      });

      const isMindmap = protegeViewMode === 'mindmap';

      // 构建节点 — 圆形节点
      const nodes: any[] = protegeClasses.map((cls: any, i: number) => {
        const label = cls.label || cls.iri?.split('/').pop() || `Class${i}`;
        const color = NODE_COLORS[i % NODE_COLORS.length];
        const isRoot = !cls.parentIri;

        if (isMindmap) {
          // 思维导图模式：圆形，节点内嵌标签
          const nodeSize = isRoot ? 56 : 40;
          return {
            id: cls.iri || cls.id || `class-${i}`,
            label,
            data: { ...cls, colorIndex: i, color },
            style: {
              fill: '#fff',
              stroke: color,
              lineWidth: 2.5,
              shadowColor: 'rgba(0,0,0,0.08)',
              shadowBlur: 8,
              labelText: label,
              labelFill: '#333',
              labelFontSize: isRoot ? 12 : 11,
              labelFontWeight: 'normal',
              labelLineHeight: 14,
              labelWordWrap: true,
              size: nodeSize,
            },
            type: 'circle',
          };
        }

        // 图形模式：圆形，标签居中
        const nodeSize = isRoot ? 50 : 36;
        return {
          id: cls.iri || cls.id || `class-${i}`,
          label,
          data: { ...cls, colorIndex: i, color },
          style: {
            fill: '#fff',
            stroke: color,
            lineWidth: isRoot ? 2.5 : 1.5,
            shadowColor: 'rgba(0,0,0,0.08)',
            shadowBlur: 6,
            labelText: label,
            labelFill: '#1a1a1a',
            labelFontSize: isRoot ? 14 : 12,
            labelFontWeight: isRoot ? 700 : 500,
            labelPlacement: 'center' as const,
            size: nodeSize,
          },
          type: 'circle',
        };
      });

      // 构建边：对象属性 + 继承关系
      const edges: any[] = [];
      protegeProperties.forEach((prop: any, i: number) => {
        const sourceLabel = prop.sourceType || prop.domain;
        const targetLabel = prop.targetType || prop.range;
        if (!sourceLabel || !targetLabel) return;
        const sourceNode = protegeClasses.find((c: any) =>
          c.label === sourceLabel || iriMatches(c.iri, sourceLabel)
        );
        const targetNode = protegeClasses.find((c: any) =>
          c.label === targetLabel || iriMatches(c.iri, targetLabel)
        );
        if (!sourceNode || !targetNode) return;
        const edgeColor = classColorMap[sourceNode.iri || sourceNode.id] || '#666';
        edges.push({
          id: `edge-${i}-${prop.id || i}`,
          source: sourceNode.iri || sourceNode.id,
          target: targetNode.iri || targetNode.id,
          label: prop.label || prop.iri?.split('/').pop() || '',
          data: { ...prop },
          style: {
            stroke: edgeColor,
            lineWidth: isMindmap ? 1 : 1.5,
            opacity: isMindmap ? 0.4 : 0.7,
            endArrow: true,
            endArrowFill: edgeColor,
            endArrowSize: 6,
            labelText: isMindmap ? '' : (prop.label || prop.iri?.split('/').pop() || ''),
            labelFill: '#555',
            labelFontSize: 10,
            labelAutoRotate: true,
            labelBackground: true,
            labelBackgroundFill: '#fff',
            labelBackgroundOpacity: 0.95,
            labelPadding: [2, 6, 2, 6],
            labelBackgroundRadius: 3,
          },
        });
      });

      // 继承边
      protegeClasses.forEach((cls: any, i: number) => {
        if (cls.parentIri) {
          const parentNode = protegeClasses.find((c: any) => iriMatches(c.iri, cls.parentIri) || c.label === cls.parentIri);
          if (parentNode && (parentNode.iri || parentNode.id) !== (cls.iri || cls.id)) {
            if (isMindmap) {
              // 思维导图模式：有机曲线连接
              const childColor = NODE_COLORS[i % NODE_COLORS.length];
              edges.push({
                id: `inherit-${i}`,
                source: parentNode.iri || parentNode.id,
                target: cls.iri || cls.id,
                data: { isInherit: true },
                type: 'cubic-horizontal',
                style: {
                  stroke: childColor,
                  lineWidth: 2,
                  opacity: 0.6,
                  endArrow: false,
                },
              });
            } else {
              edges.push({
                id: `inherit-${i}`,
                source: cls.iri || cls.id,
                target: parentNode.iri || parentNode.id,
                data: { isInherit: true },
                type: 'line',
                style: {
                  stroke: '#888',
                  lineWidth: 1.2,
                  lineDash: [6, 4],
                  opacity: 0.6,
                  endArrow: true,
                  endArrowSize: 10,
                  endArrowFill: '#fff',
                  endArrowStroke: '#888',
                  labelText: '',
                },
              });
            }
          }
        }
      });


      const container = protegeGraphRef.current;
      if (!container) return;

      // 获取外层滚动容器
      const scrollContainer = container.parentElement;
      const containerWidth = scrollContainer?.offsetWidth || 800;
      const containerHeight = scrollContainer?.offsetHeight || 650;

      // 根据视图模式选择布局
      let layoutConfig: any;
      if (isMindmap) {
        // 思维导图：DAG 从左到右的层次布局
        if (hasInheritance) {
          layoutConfig = {
            type: 'dagre',
            rankdir: 'LR',
            nodesep: 50,
            ranksep: 65,
            preventOverlap: true,
          };
        } else {
          layoutConfig = {
            type: 'dagre',
            rankdir: 'LR',
            nodesep: 100,
            ranksep: 165,
            preventOverlap: true,
          };
        }
      } else {
        // 本体视图：DAG 从上到下的层次布局，体现思维链
        if (hasInheritance) {
          // 有继承关系：层次布局
          layoutConfig = {
            type: 'dagre',
            rankdir: 'TB',
            nodesep: 40,
            ranksep: 55,
            preventOverlap: true,
            align: 'UL',
          };
        } else {
          // 无继承关系：dagre DAG 布局，大间距保证边线长
          layoutConfig = {
            type: 'dagre',
            rankdir: 'TB',
            nodesep: 100,
            ranksep: 165,
            preventOverlap: true,
          };
        }
      }
      layoutConfig.animate = false;

            // 计算初始画布尺寸，确保足够大以容纳所有节点
      const minCanvasSize = 600;
      const nodeSizeFactor = isMindmap ? 80 : 70;
      const estimatedSize = Math.max(minCanvasSize, Math.sqrt(protegeClasses.length) * nodeSizeFactor * 2);
      const initialWidth = Math.max(containerWidth, estimatedSize);
      const initialHeight = Math.max(containerHeight, estimatedSize);

      // 渲染前隐藏画布，避免布局计算过程中的视觉跳动
      container.style.visibility = 'hidden';

      const graph: any = new G6Graph({
        container,
        width: initialWidth,
        height: initialHeight,
        autoFit: 'view',
        animation: false,
        data: { nodes, edges },
        layout: layoutConfig,
        node: {
          style: {
            labelText: (d: any) => d.label || '',
            labelPlacement: 'center',
            cursor: 'move',
          },
          state: {
            selected: { lineWidth: 3, shadowBlur: 12, shadowColor: 'rgba(22,119,255,0.4)' },
            hover: { lineWidth: 3, shadowBlur: 12, shadowColor: 'rgba(22,119,255,0.3)' },
          },
        },
        edge: {
          type: isMindmap ? 'cubic-horizontal' : 'quadratic',
          style: { endArrow: true, cursor: 'pointer' },
          state: {
            selected: { lineWidth: 3, stroke: '#1677ff' },
            hover: { lineWidth: 2, stroke: '#1677ff' },
          },
        },
        behaviors: [
          'drag-canvas',
          {
            type: 'zoom-canvas',
            sensitivity: 2,
            trigger: 'wheel',
          },
          {
            type: 'drag-element',
            key: 'drag-element',
            enable: (evt: any) => evt.targetType === 'node',
          },
          'click-select',
          {
            type: 'create-edge',
            key: 'create-edge',
            trigger: 'click',
            style: {
              stroke: '#1677ff',
              lineWidth: 2,
              lineDash: [6, 4],
              endArrow: true,
            },
            enable: (evt: any) => {
              if (!edgeCreatingRef.current || !contextMenuNodeRef.current) return false;
              if (evt.targetType !== 'node') return false;
              return true;
            },
            onCreate: (edgeData: any) => {
              if (!contextMenuNodeRef.current) return undefined;
              if (edgeData.source !== contextMenuNodeRef.current.id) return undefined;
              return edgeData;
            },
            onFinish: (edgeData: any) => {
              const sourceId = edgeData.source;
              const targetId = edgeData.target;

              // 清除源节点的选中状态
              if (contextMenuNodeRef.current?.id) {
                graph.setElementState(contextMenuNodeRef.current.id, 'selected', false);
              }

              setEdgeDraft({ sourceId, targetId });
              setCreateEdgeModalVisible(true);
              setEdgeCreating(false);
              setContextMenuNode(null);

              // 基于关联的两个类自动推导默认值
              const sourceNode = protegeClasses.find((c: any) => c.iri === sourceId || c.id === sourceId);
              const targetNode = protegeClasses.find((c: any) => c.iri === targetId || c.id === targetId);

              const sourceLabel = sourceNode?.label || '';
              const targetLabel = targetNode?.label || '';
              const cleanLabel = (label: string) => (label || '').replace(/[^a-zA-Z0-9一-鿿]/g, '');

              const autoLabel = targetLabel ? `has${targetLabel}` : 'hasRelation';
              const autoIri = `http://ontomind.org/ontology/${validateTarget?.id}#${cleanLabel(sourceLabel)}To${cleanLabel(targetLabel)}`;
              const autoDescription = sourceLabel && targetLabel ? `${sourceLabel} 到 ${targetLabel} 的关系` : '';

              createEdgeForm.setFieldsValue({
                label: autoLabel,
                iri: autoIri,
                description: autoDescription,
              });

              // 删除临时创建的边
              setTimeout(() => {
                if (edgeData.id) graph.deleteData(edgeData.id);
              }, 100);
            },
          },
        ],
        plugins: [
          {
            type: 'tooltip',
            key: 'tooltip',
            enterable: true,
            getContent: (evt: any, items: any[]) => {
              const { targetType } = evt;
              if (!items || items.length === 0) return '';

              const item = items[0]; // 获取元素数据

              // 边的tooltip
              if (targetType === 'edge') {
                const edgeId = item.id || '';

                if (edgeId.startsWith('inherit-')) {
                  // 继承线
                  const result: string[] = ['<b style="color:#888">继承关系</b>'];
                  const sourceId = item.source;
                  const targetId = item.target;
                  const sourceClass = protegeClasses.find((c: any) => c.iri === sourceId || c.id === sourceId);
                  const targetClass = protegeClasses.find((c: any) => c.iri === targetId || c.id === targetId);
                  const sourceLabel = sourceClass?.label || sourceId?.split('/').pop() || '';
                  const targetLabel = targetClass?.label || targetId?.split('/').pop() || '';
                  result.push(`<span>${sourceLabel} 继承自 ${targetLabel}</span>`);
                  return `<div style="padding:8px 12px;font-size:12px;line-height:1.8">${result.join('<br/>')}</div>`;
                }

                // 对象属性关系线
                const d = item.data || {};
                const result: string[] = [];
                // 显示关系名称
                if (d.label) {
                  result.push(`<b>${d.label}</b>`);
                }
                // 显示定义域→值域
                if (d.sourceType && d.targetType) {
                  result.push(`<span style="color:#888">${d.sourceType} → ${d.targetType}</span>`);
                }
                // 显示IRI
                if (d.iri) {
                  result.push(`<span style="color:#999">IRI: ${d.iri}</span>`);
                }
                // 显示描述
                if (d.description) {
                  result.push(d.description);
                }
                // 如果没有任何信息，显示默认
                if (result.length === 0) {
                  result.push('<span style="color:#888">对象属性关系</span>');
                }
                return `<div style="padding:8px 12px;font-size:12px;line-height:1.8">${result.join('<br/>')}</div>`;
              }

              // 节点tooltip
              if (targetType === 'node') {
                const d = item.data || {};
                const result: string[] = [];
                // 显示类名称
                const label = d.label || item.label;
                if (label) {
                  result.push(`<b>${label}</b>`);
                }
                // 显示IRI
                if (d.iri) {
                  result.push(`<span style="color:#999">IRI: ${d.iri}</span>`);
                }
                // 显示描述
                if (d.description) {
                  result.push(d.description);
                }
                if (result.length === 0) {
                  result.push('<span style="color:#888">对象类型</span>');
                }
                return `<div style="padding:8px 12px;font-size:12px;line-height:1.8">${result.join('<br/>')}</div>`;
              }

              return '';
            },
          },
          {
            type: 'contextmenu',
            key: 'contextmenu',
            trigger: 'contextmenu',
            offset: [0, 0],
            getContent: (evt: any) => {
              const { targetType } = evt;
              if (targetType !== 'node') return '';
              const nodeId = evt.target?.id || '';
              return `<ul class="g6-contextmenu-ul" style="list-style:none;padding:4px 0;margin:0;min-width:100px;">
                <li class="g6-contextmenu-li" value="add-edge" data-node-id="${nodeId}" style="padding:8px 12px;cursor:pointer;font-size:13px;">+新建关系</li>
              </ul>`;
            },
            onOpenChange: (open: boolean) => {
              setContextMenuVisible(open);
            },
          },
        ],
      });

      // 右键菜单点击处理 - 使用 document 事件委托
      const handleContextMenuClick = (evt: MouseEvent) => {
        const target = evt.target as HTMLElement;
        const value = target?.getAttribute?.('value');
        const nodeId = target?.getAttribute?.('data-node-id');
        if (value === 'add-edge' && nodeId) {
          evt.preventDefault();
          evt.stopPropagation();
          // 立即设置 ref 确保 create-edge 行为的 enable 能通过
          edgeCreatingRef.current = true;
          contextMenuNodeRef.current = { id: nodeId };
          setEdgeCreating(true);
          setContextMenuNode({ id: nodeId });
          try {
            graph.setElementState(nodeId, 'selected', true);
          } catch {}
          // 立即触发 create-edge 行为的第一阶段：从源节点引出引导线
          try {
            graph.emit('node:click', {
              targetType: 'node',
              target: { id: nodeId },
            });
          } catch {}
        }
      };

      document.addEventListener('click', handleContextMenuClick, true);

      // 保存事件处理器引用，用于清理
      (graph as any).__contextMenuClickHandler = handleContextMenuClick;

      // 画布点击取消连线创建模式
      graph.on('canvas:click', () => {
        if (edgeCreatingRef.current) {
          // 取消源节点的选中状态
          if (contextMenuNodeRef.current?.id) {
            graph.setElementState(contextMenuNodeRef.current.id, 'selected', false);
          }
          setEdgeCreating(false);
          setContextMenuNode(null);
        }
        setSelectedNode(null);
        setSelectedEdge(null);
      });

      // 监听布局完成后确保内容完整可见并居中（节点拖拽后重新布局时触发）
      graph.on('afterlayout', () => {
        try {
          if (scrollContainer) {
            graph.setSize(scrollContainer.offsetWidth, scrollContainer.offsetHeight);
          }
        } catch { /* ignore */ }
      });

      await graph.render();

      // 渲染完成后显示画布
      container.style.visibility = 'visible';

      // 监听鼠标滚轮缩放事件，同步更新状态
      graph.on('wheel', (evt: any) => {
        const zoom = graph.getZoom();
        setGraphZoom(zoom);
      });

      // 单击节点 - 仅选中，不弹编辑框
      graph.on('node:click', (evt: any) => {
        const nodeId = evt.target?.id || evt.itemId;
        const nodeData = graph.getNodeData(nodeId);
        if (nodeData?.data) {
          setSelectedNode(nodeData.data);
          setSelectedEdge(null);
        }
      });

      // 单击边 - 在右侧面板显示对象属性详情（继承线不处理）
      graph.on('edge:click', (evt: any) => {
        const edgeId = evt.target?.id || evt.itemId;
        if (!edgeId) return;

        // 继承边（ID 以 inherit- 开头）不处理
        if (edgeId.startsWith('inherit-')) {
          return;
        }

        const edgeData = graph.getEdgeData(edgeId);
        if (edgeData?.data && edgeData.data.id) {
          setSelectedEdge(edgeData.data);
          setSelectedNode(null);
        }
      });

      // 双击节点 - 弹出对象编辑框
      graph.on('node:dblclick', (evt: any) => {
        const nodeId = evt.target?.id || evt.itemId;
        const nodeData = graph.getNodeData(nodeId);
        if (nodeData?.data) {
          setSelectedNode(nodeData.data);
          setSelectedEdge(null);
          // 打开编辑类对话框
          form.setFieldsValue({
            iri: nodeData.data.iri || '',
            label: nodeData.data.label || '',
            parentIri: nodeData.data.parentIri || '',
            description: nodeData.data.description || '',
          });
          setEditClassModalVisible(true);
        }
      });

      // 双击边 - 显示关系编辑框（继承线不处理）
      graph.on('edge:dblclick', (evt: any) => {
        const edgeId = evt.target?.id || evt.itemId;
        if (!edgeId) return;

        // 继承边（ID 以 inherit- 开头）不处理
        if (edgeId.startsWith('inherit-')) {
          return;
        }

        const edgeData = graph.getEdgeData(edgeId);
        if (edgeData?.data && edgeData.data.id) {
          setSelectedEdge(edgeData.data);
          setSelectedNode(null);
          dblclickEditEdgeForm.setFieldsValue({
            label: edgeData.data.label,
            iri: edgeData.data.iri,
            description: edgeData.data.description,
          });
          setDblclickEditEdgeModalVisible(true);
        }
      });

      // 节点拖拽结束 - 保存位置到后端
      graph.on('node:dragend', async (evt: any) => {
        const nodeId = evt.target?.id || evt.itemId;
        const nodeData = graph.getNodeData(nodeId);
        if (nodeData && validateTarget) {
          // 使用数据库 id 而不是 IRI
          const dbId = nodeData.data?.id;
          if (!dbId) return;

          // 获取节点位置
          const position = { x: nodeData.data?.x || 0, y: nodeData.data?.y || 0 };

          try {
            await updateObjectPosition(validateTarget.id, dbId, position);
            message.success('位置已保存');
          } catch (e) {
            console.error('保存位置失败', e);
          }
        }
      });

      protegeGraphInstRef.current = graph;
    } catch (e) {
      console.error('G6 初始化失败:', e);
    }
  }, [protegeClasses, protegeProperties, protegeViewMode, validateTarget, createEdgeForm, dblclickEditEdgeForm, form]);

  useEffect(() => {
    if (validateTarget && protegeClasses.length >= 0) {
      renderProtegeGraph();
    }
    return () => {
      if (protegeGraphInstRef.current) {
        protegeGraphInstRef.current.destroy();
        protegeGraphInstRef.current = null;
      }
    };
  }, [validateTarget, protegeClasses, protegeProperties, renderProtegeGraph, protegeViewMode]);

  // 当详情面板显示/隐藏导致 Col 宽度变化时，调整 G6 画布大小
  useEffect(() => {
    const timer = setTimeout(() => {
      const graph = protegeGraphInstRef.current;
      const container = protegeGraphRef.current;
      if (graph && container) {
        const scrollContainer = container.parentElement;
        if (scrollContainer) {
          graph.setSize(scrollContainer.offsetWidth, scrollContainer.offsetHeight);
        }
      }
    }, 100);
    return () => clearTimeout(timer);
  }, [selectedNode, selectedEdge]);

  // 画布缩放控制
  const handleZoomIn = useCallback(() => {
    const graph = protegeGraphInstRef.current;
    if (!graph) return;
    const currentZoom = graph.getZoom();
    const newZoom = Math.min(currentZoom * 1.2, 3);
    graph.zoomTo(newZoom);
    setGraphZoom(newZoom);
  }, []);

  const handleZoomOut = useCallback(() => {
    const graph = protegeGraphInstRef.current;
    if (!graph) return;
    const currentZoom = graph.getZoom();
    const newZoom = Math.max(currentZoom / 1.2, 0.3);
    graph.zoomTo(newZoom);
    setGraphZoom(newZoom);
  }, []);

  const handleZoomReset = useCallback(() => {
    const graph = protegeGraphInstRef.current;
    if (!graph) return;
    graph.zoomTo(1);
    graph.fitView(20);
    setGraphZoom(1);
  }, []);

  // 编辑类
  const handleEditClass = () => {
    if (!selectedNode) return;
    form.setFieldsValue({
      iri: selectedNode.iri || '',
      label: selectedNode.label || '',
      parentIri: selectedNode.parentIri || '',
      description: selectedNode.description || '',
    });
    setEditClassModalVisible(true);
  };

  const handleDeleteClass = async () => {
    if (!validateTarget || !selectedNode) return;
    try {
      await deleteObjectType(validateTarget.id, selectedNode.id);
      message.success('对象类型已删除');
      setSelectedNode(null);
      await loadProtegeData();
    } catch (e: any) {
      message.error('删除失败: ' + (e.message || '未知错误'));
    }
  };

  const handleDeleteClassById = async (id: string) => {
    if (!validateTarget) return;
    try {
      await deleteObjectType(validateTarget.id, id);
      message.success('对象类型已删除');
      await loadProtegeData();
    } catch (e: any) {
      message.error('删除失败: ' + (e.message || '未知错误'));
    }
  };

  // 拖拽创建关系
  const handleCreateEdge = async () => {
    if (!validateTarget || !edgeDraft) return;
    try {
      const values = await createEdgeForm.validateFields();
      setCreateEdgeSubmitting(true);
      const sourceNode = protegeClasses.find((c: any) => c.iri === edgeDraft.sourceId);
      const targetNode = protegeClasses.find((c: any) => c.iri === edgeDraft.targetId);

      await createLinkType(validateTarget.id, {
        iri: values.iri,
        label: values.label,
        sourceType: sourceNode?.label || edgeDraft.sourceId,
        targetType: targetNode?.label || edgeDraft.targetId,
        description: values.description,
      });

      message.success('关系创建成功');
      setCreateEdgeModalVisible(false);
      createEdgeForm.resetFields();
      setEdgeDraft(null);
      await loadProtegeData();
    } catch (e: any) {
      message.error('创建失败: ' + (e.message || '未知错误'));
    } finally {
      setCreateEdgeSubmitting(false);
    }
  };

  // 双击编辑关系
  const handleDblclickEditEdge = async () => {
    if (!validateTarget || !dblclickSelectedEdge) return;
    try {
      const values = await dblclickEditEdgeForm.validateFields();
      setDblclickEditEdgeSubmitting(true);

      await updateLinkType(validateTarget.id, dblclickSelectedEdge.id, {
        label: values.label,
        iri: values.iri,
        description: values.description,
      });

      message.success('关系已更新');
      setDblclickEditEdgeModalVisible(false);
      await loadProtegeData();
    } catch (e: any) {
      message.error('更新失败: ' + (e.message || '未知错误'));
    } finally {
      setDblclickEditEdgeSubmitting(false);
    }
  };

  const handleSaveEditClass = async () => {
    if (!validateTarget || !selectedNode) return;
    try {
      const values = await form.validateFields();
      setEditClassSaving(true);
      await updateObjectType(validateTarget.id, selectedNode.id, values);
      message.success('对象类型更新成功');
      setEditClassModalVisible(false);
      await loadProtegeData();
    } catch (e: any) {
      if (e.errorFields) return;
      message.error('更新失败: ' + (e.message || '未知错误'));
    } finally {
      setEditClassSaving(false);
    }
  };

  // 类层次表格列定义
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const buildClassColumns = (classList: any[]): any => {
    // 构建合并数据源
    const groupMap: Record<string, any[]> = {};
    const order: string[] = [];
    (classList || []).forEach((cls: any) => {
      const pKey = cls.parentIri || '__top__';
      if (!groupMap[pKey]) { groupMap[pKey] = []; order.push(pKey); }
      groupMap[pKey].push({ ...cls, _parentKey: pKey, _rowSpan: 0 });
    });
    // 计算每个分组的行数
    const allRows: any[] = [];
    order.forEach((pKey) => {
      const rows = groupMap[pKey] || [];
      rows.forEach((r, idx) => {
        r._rowSpan = idx === 0 ? rows.length : 0;
      });
      allRows.push(...rows);
    });

    const columns = [
      {
        title: '父类', key: 'parent', width: 180,
        onCell: (record: any) => ({ rowSpan: record._rowSpan }),
        render: (_: any, record: any) => {
          if (record._parentKey === '__top__') return <Tag color="gold">顶级类</Tag>;
          const parent = classList.find((c: any) => c.iri === record._parentKey || c.label === record._parentKey);
          const colorIdx = classList.indexOf(parent);
          return <Tag color={NODE_COLORS[colorIdx % NODE_COLORS.length]}>{parent?.label || record._parentKey?.split('/').pop() || '-'}</Tag>;
        },
      },
      {
        title: '子类', dataIndex: 'label', key: 'label', width: 160,
        render: (text: string, record: any) => (
          <Tag color={NODE_COLORS[classList.indexOf(record) % NODE_COLORS.length]}>{text || '-'}</Tag>
        ),
      },
      {
        title: 'IRI', dataIndex: 'iri', key: 'iri', ellipsis: true,
        render: (text: string) => <Tooltip title={text}><Text copyable style={{ fontSize: 12 }}>{text}</Text></Tooltip>,
      },
      {
        title: '描述', dataIndex: 'description', key: 'description', ellipsis: true,
        render: (text: string) => <Text type="secondary" style={{ fontSize: 12 }}>{text || '-'}</Text>,
      },
      {
        title: '操作', key: 'actions', width: 140,
        render: (_: any, record: any) => (
          <Space size="small">
            <Button size="small" type="link" onClick={() => { setSelectedNode(record); handleEditClass(); }}>编辑</Button>
            <Popconfirm title={`确认删除类「${record.label}」？`} onConfirm={() => handleDeleteClassById(record.id)} okText="删除" cancelText="取消">
              <Button size="small" type="link" danger>删除</Button>
            </Popconfirm>
          </Space>
        ),
      },
    ];
    return { columns, dataSource: allRows };
  };

  // 添加类
  const handleAddClass = () => {
    form.resetFields();
    if (validateTarget) {
      form.setFieldsValue({ iri: `http://example.org/ontology#NewClass` });
    }
    setAddClassModalVisible(true);
  };

  const handleSaveAddClass = async () => {
    if (!validateTarget) return;
    try {
      const values = await form.validateFields();
      setEditClassSaving(true);
      await createObjectType(validateTarget.id, values);
      message.success('对象类型创建成功');
      setAddClassModalVisible(false);
      await loadProtegeData();
    } catch (e: any) {
      if (e.errorFields) return;
      message.error('创建失败: ' + (e.message || '未知错误'));
    } finally {
      setEditClassSaving(false);
    }
  };

  // 编辑关系
  const handleEditLink = () => {
    if (!selectedEdge) return;
    linkForm.setFieldsValue({
      iri: selectedEdge.iri || '',
      label: selectedEdge.label || '',
      sourceType: selectedEdge.sourceType || '',
      targetType: selectedEdge.targetType || '',
      description: selectedEdge.description || '',
    });
    setEditLinkModalVisible(true);
  };

  const handleSaveEditLink = async () => {
    if (!validateTarget || !selectedEdge) return;
    try {
      const values = await linkForm.validateFields();
      setEditLinkSaving(true);
      await updateLinkType(validateTarget.id, selectedEdge.id, values);
      message.success('关系更新成功');
      setEditLinkModalVisible(false);
      await loadProtegeData();
    } catch (e: any) {
      if (e.errorFields) return;
      message.error('更新失败: ' + (e.message || '未知错误'));
    } finally {
      setEditLinkSaving(false);
    }
  };

  const handleDeleteLink = async () => {
    if (!validateTarget || !selectedEdge) return;
    try {
      await deleteLinkType(validateTarget.id, selectedEdge.id);
      message.success('关系已删除');
      setSelectedEdge(null);
      await loadProtegeData();
    } catch (e: any) {
      message.error('删除失败: ' + (e.message || '未知错误'));
    }
  };

  const handleDeleteLinkById = async (id: string) => {
    if (!validateTarget) return;
    try {
      await deleteLinkType(validateTarget.id, id);
      message.success('关系已删除');
      await loadProtegeData();
    } catch (e: any) {
      message.error('删除失败: ' + (e.message || '未知错误'));
    }
  };

  // 添加关系
  const handleAddLink = () => {
    linkForm.resetFields();
    setAddLinkModalVisible(true);
  };

  const handleSaveAddLink = async () => {
    if (!validateTarget) return;
    try {
      const values = await linkForm.validateFields();
      setEditLinkSaving(true);
      await createLinkType(validateTarget.id, values);
      message.success('关系创建成功');
      setAddLinkModalVisible(false);
      await loadProtegeData();
    } catch (e: any) {
      if (e.errorFields) return;
      message.error('创建失败: ' + (e.message || '未知错误'));
    } finally {
      setEditLinkSaving(false);
    }
  };

  // 导出本体视图为JPG图片（白色背景，包含图例，裁剪空白）
  const handleExportProtegeGraph = useCallback(async () => {
    const graph = protegeGraphInstRef.current;
    const container = protegeGraphRef.current;
    if (!graph || !container) {
      message.warning('请先加载本体视图');
      return;
    }

    try {
      message.loading({ content: '正在导出本体视图...', key: 'exportGraph' });

      // 先让图形自适应视图，确保所有内容可见
      try {
        graph.fitView(40);
      } catch { /* ignore */ }

      // 等待一帧确保渲染完成
      await new Promise(resolve => setTimeout(resolve, 100));

      // 获取G6渲染的canvas
      const canvasList = container.querySelectorAll('canvas');
      if (!canvasList || canvasList.length === 0) {
        message.error('无法获取画布元素');
        return;
      }

      // 找到主canvas（通常是最大的那个）
      let mainCanvas: HTMLCanvasElement | null = null;
      let maxArea = 0;
      canvasList.forEach((canvas: Element) => {
        const htmlCanvas = canvas as HTMLCanvasElement;
        const area = htmlCanvas.width * htmlCanvas.height;
        if (area > maxArea) {
          maxArea = area;
          mainCanvas = htmlCanvas;
        }
      });

      if (!mainCanvas) {
        message.error('无法获取主画布');
        return;
      }

      // 获取原始canvas尺寸
      const origWidth = mainCanvas.width;
      const origHeight = mainCanvas.height;

      // 创建导出用的canvas
      const exportCanvas = document.createElement('canvas');
      const exportCtx = exportCanvas.getContext('2d');

      if (!exportCtx) {
        message.error('无法创建导出画布');
        return;
      }

      // 填充白色背景
      exportCanvas.width = origWidth;
      exportCanvas.height = origHeight;
      exportCtx.fillStyle = '#ffffff';
      exportCtx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);

      // 将所有G6 canvas层绘制到导出canvas上
      canvasList.forEach((canvas: Element) => {
        const htmlCanvas = canvas as HTMLCanvasElement;
        try {
          exportCtx.drawImage(htmlCanvas, 0, 0);
        } catch { /* ignore */ }
      });

      // 绘制图例
      const legendY = 20;
      const legendX = exportCanvas.width - 250;
      exportCtx.fillStyle = 'rgba(255,255,255,0.95)';
      exportCtx.strokeStyle = '#e0e0e0';
      exportCtx.lineWidth = 1;
      // 绘制圆角矩形（兼容性写法）
      const legendWidth = 240;
      const legendHeight = 40;
      const radius = 6;
      exportCtx.beginPath();
      exportCtx.moveTo(legendX - 10 + radius, legendY - 10);
      exportCtx.lineTo(legendX - 10 + legendWidth - radius, legendY - 10);
      exportCtx.arcTo(legendX - 10 + legendWidth, legendY - 10, legendX - 10 + legendWidth, legendY - 10 + radius, radius);
      exportCtx.lineTo(legendX - 10 + legendWidth, legendY - 10 + legendHeight - radius);
      exportCtx.arcTo(legendX - 10 + legendWidth, legendY - 10 + legendHeight, legendX - 10 + legendWidth - radius, legendY - 10 + legendHeight, radius);
      exportCtx.lineTo(legendX - 10 + radius, legendY - 10 + legendHeight);
      exportCtx.arcTo(legendX - 10, legendY - 10 + legendHeight, legendX - 10, legendY - 10 + legendHeight - radius, radius);
      exportCtx.lineTo(legendX - 10, legendY - 10 + radius);
      exportCtx.arcTo(legendX - 10, legendY - 10, legendX - 10 + radius, legendY - 10, radius);
      exportCtx.closePath();
      exportCtx.fill();
      exportCtx.stroke();

      exportCtx.font = '12px Arial';
      exportCtx.fillStyle = '#555';
      exportCtx.textBaseline = 'middle';

      // 对象图例
      exportCtx.beginPath();
      exportCtx.arc(legendX + 7, legendY + 10, 6, 0, Math.PI * 2);
      exportCtx.fillStyle = '#ffffff';
      exportCtx.fill();
      exportCtx.strokeStyle = '#1677ff';
      exportCtx.lineWidth = 2;
      exportCtx.stroke();
      exportCtx.fillStyle = '#555';
      exportCtx.fillText('对象', legendX + 20, legendY + 10);

      // 对象关系图例
      const lineX1 = legendX + 70;
      const lineX2 = legendX + 95;
      exportCtx.beginPath();
      exportCtx.moveTo(lineX1, legendY + 10);
      exportCtx.lineTo(lineX2 - 5, legendY + 10);
      exportCtx.strokeStyle = '#666';
      exportCtx.lineWidth = 1.5;
      exportCtx.stroke();
      // 箭头
      exportCtx.beginPath();
      exportCtx.moveTo(lineX2, legendY + 10);
      exportCtx.lineTo(lineX2 - 6, legendY + 6);
      exportCtx.lineTo(lineX2 - 6, legendY + 14);
      exportCtx.closePath();
      exportCtx.fillStyle = '#666';
      exportCtx.fill();
      exportCtx.fillStyle = '#555';
      exportCtx.fillText('对象关系', lineX2 + 5, legendY + 10);

      // 继承图例
      const dashX1 = legendX + 165;
      const dashX2 = legendX + 190;
      exportCtx.beginPath();
      exportCtx.setLineDash([4, 3]);
      exportCtx.moveTo(dashX1, legendY + 10);
      exportCtx.lineTo(dashX2, legendY + 10);
      exportCtx.strokeStyle = '#888';
      exportCtx.lineWidth = 1.2;
      exportCtx.stroke();
      exportCtx.setLineDash([]);
      exportCtx.fillStyle = '#555';
      exportCtx.fillText('继承', dashX2 + 5, legendY + 10);

      // 导出为JPG
      const dataUrl = exportCanvas.toDataURL('image/jpeg', 0.95);

      // 创建下载链接
      const link = document.createElement('a');
      link.download = `本体视图_${new Date().toISOString().slice(0, 10)}.jpg`;
      link.href = dataUrl;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      message.success({ content: '导出成功', key: 'exportGraph' });
    } catch (e: any) {
      console.error('导出失败:', e);
      message.error({ content: '导出失败: ' + (e.message || '未知错误'), key: 'exportGraph' });
    }
  }, []);

  // 导出思维导图为JPG图片（白色背景，包含图例）
  const handleExportProtegeMindmap = useCallback(async () => {
    const graph = protegeGraphInstRef.current;
    const container = protegeGraphRef.current;
    if (!graph || !container) {
      message.warning('请先加载本体视图');
      return;
    }

    try {
      message.loading({ content: '正在导出思维导图...', key: 'exportMindmap' });

      // 切换到思维导图模式
      const originalMode = protegeViewMode;
      setProtegeViewMode('mindmap');

      // 等待重新渲染
      await new Promise(resolve => setTimeout(resolve, 300));

      // 重新获取graph实例（可能已经更新）
      const currentGraph = protegeGraphInstRef.current;

      // 先让图形自适应视图，确保所有内容可见
      try {
        currentGraph?.fitView(40);
      } catch { /* ignore */ }

      // 等待一帧确保渲染完成
      await new Promise(resolve => setTimeout(resolve, 100));

      // 获取G6渲染的canvas
      const canvasList = container.querySelectorAll('canvas');
      if (!canvasList || canvasList.length === 0) {
        message.error('无法获取画布元素');
        return;
      }

      // 找到主canvas（通常是最大的那个）
      let mainCanvas: HTMLCanvasElement | null = null;
      let maxArea = 0;
      canvasList.forEach((canvas: Element) => {
        const htmlCanvas = canvas as HTMLCanvasElement;
        const area = htmlCanvas.width * htmlCanvas.height;
        if (area > maxArea) {
          maxArea = area;
          mainCanvas = htmlCanvas;
        }
      });

      if (!mainCanvas) {
        message.error('无法获取主画布');
        return;
      }

      // 获取原始canvas尺寸
      const origWidth = mainCanvas.width;
      const origHeight = mainCanvas.height;

      // 创建导出用的canvas
      const exportCanvas = document.createElement('canvas');
      const exportCtx = exportCanvas.getContext('2d');

      if (!exportCtx) {
        message.error('无法创建导出画布');
        return;
      }

      // 填充白色背景
      exportCanvas.width = origWidth;
      exportCanvas.height = origHeight;
      exportCtx.fillStyle = '#ffffff';
      exportCtx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);

      // 将所有G6 canvas层绘制到导出canvas上
      canvasList.forEach((canvas: Element) => {
        const htmlCanvas = canvas as HTMLCanvasElement;
        try {
          exportCtx.drawImage(htmlCanvas, 0, 0);
        } catch { /* ignore */ }
      });

      // 绘制图例
      const legendY = 20;
      const legendX = exportCanvas.width - 250;
      exportCtx.fillStyle = 'rgba(255,255,255,0.95)';
      exportCtx.strokeStyle = '#e0e0e0';
      exportCtx.lineWidth = 1;
      // 绘制圆角矩形（兼容性写法）
      const legendWidth = 240;
      const legendHeight = 40;
      const radius = 6;
      exportCtx.beginPath();
      exportCtx.moveTo(legendX - 10 + radius, legendY - 10);
      exportCtx.lineTo(legendX - 10 + legendWidth - radius, legendY - 10);
      exportCtx.arcTo(legendX - 10 + legendWidth, legendY - 10, legendX - 10 + legendWidth, legendY - 10 + radius, radius);
      exportCtx.lineTo(legendX - 10 + legendWidth, legendY - 10 + legendHeight - radius);
      exportCtx.arcTo(legendX - 10 + legendWidth, legendY - 10 + legendHeight, legendX - 10 + legendWidth - radius, legendY - 10 + legendHeight, radius);
      exportCtx.lineTo(legendX - 10 + radius, legendY - 10 + legendHeight);
      exportCtx.arcTo(legendX - 10, legendY - 10 + legendHeight, legendX - 10, legendY - 10 + legendHeight - radius, radius);
      exportCtx.lineTo(legendX - 10, legendY - 10 + radius);
      exportCtx.arcTo(legendX - 10, legendY - 10, legendX - 10 + radius, legendY - 10, radius);
      exportCtx.closePath();
      exportCtx.fill();
      exportCtx.stroke();

      exportCtx.font = '12px Arial';
      exportCtx.fillStyle = '#555';
      exportCtx.textBaseline = 'middle';

      // 对象图例
      exportCtx.beginPath();
      exportCtx.arc(legendX + 7, legendY + 10, 6, 0, Math.PI * 2);
      exportCtx.fillStyle = '#ffffff';
      exportCtx.fill();
      exportCtx.strokeStyle = '#1677ff';
      exportCtx.lineWidth = 2;
      exportCtx.stroke();
      exportCtx.fillStyle = '#555';
      exportCtx.fillText('对象', legendX + 20, legendY + 10);

      // 对象关系图例
      const lineX1 = legendX + 70;
      const lineX2 = legendX + 95;
      exportCtx.beginPath();
      exportCtx.moveTo(lineX1, legendY + 10);
      exportCtx.lineTo(lineX2 - 5, legendY + 10);
      exportCtx.strokeStyle = '#666';
      exportCtx.lineWidth = 1.5;
      exportCtx.stroke();
      // 箭头
      exportCtx.beginPath();
      exportCtx.moveTo(lineX2, legendY + 10);
      exportCtx.lineTo(lineX2 - 6, legendY + 6);
      exportCtx.lineTo(lineX2 - 6, legendY + 14);
      exportCtx.closePath();
      exportCtx.fillStyle = '#666';
      exportCtx.fill();
      exportCtx.fillStyle = '#555';
      exportCtx.fillText('对象关系', lineX2 + 5, legendY + 10);

      // 继承图例
      const dashX1 = legendX + 165;
      const dashX2 = legendX + 190;
      exportCtx.beginPath();
      exportCtx.setLineDash([4, 3]);
      exportCtx.moveTo(dashX1, legendY + 10);
      exportCtx.lineTo(dashX2, legendY + 10);
      exportCtx.strokeStyle = '#888';
      exportCtx.lineWidth = 1.2;
      exportCtx.stroke();
      exportCtx.setLineDash([]);
      exportCtx.fillStyle = '#555';
      exportCtx.fillText('继承', dashX2 + 5, legendY + 10);

      // 导出为JPG
      const dataUrl = exportCanvas.toDataURL('image/jpeg', 0.95);

      // 创建下载链接
      const link = document.createElement('a');
      link.download = `思维导图_${new Date().toISOString().slice(0, 10)}.jpg`;
      link.href = dataUrl;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      // 恢复原来的视图模式
      if (originalMode !== 'mindmap') {
        setProtegeViewMode(originalMode);
      }

      message.success({ content: '导出成功', key: 'exportMindmap' });
    } catch (e: any) {
      console.error('导出失败:', e);
      message.error({ content: '导出失败: ' + (e.message || '未知错误'), key: 'exportMindmap' });
    }
  }, [protegeViewMode]);

  // ===== 业务规则 CRUD =====
  const handleAddRule = () => {
    ruleForm.resetFields();
    ruleForm.setFieldsValue({
      ontologyId: validateTarget?.id,
      type: 'CONDITION',
      priority: 'MEDIUM',
      confidence: 1.0,
      source: '人工',
      status: 'DRAFT',
    });
    setAddRuleModalVisible(true);
  };

  const handleSaveAddRule = async () => {
    if (!validateTarget) return;
    try {
      const values = await ruleForm.validateFields();
      setRuleSaving(true);
      await createRule({ ...values, ontologyId: validateTarget.id });
      await syncRulesToTtl(validateTarget.id).catch(() => {});
      message.success('规则创建成功');
      setAddRuleModalVisible(false);
      await loadProtegeData({ skipTtlSync: true });
    } catch (e: any) {
      if (e.errorFields) return;
      message.error('创建失败: ' + (e.message || '未知错误'));
    } finally {
      setRuleSaving(false);
    }
  };

  // ===== 数据属性添加 =====
  const handleAddDataProperty = () => {
    dataPropForm.resetFields();
    dataPropForm.setFieldsValue({ range: 'xsd:string' });
    setAddDataPropModalVisible(true);
  };

  const handleSaveAddDataProperty = async () => {
    if (!validateTarget) return;
    try {
      const values = await dataPropForm.validateFields();
      const classId = values.domainClassId;
      const selectedClass = protegeClasses.find((c: any) => c.id === classId || c.iri === classId);
      if (!selectedClass) {
        message.error('未找到对应的类');
        return;
      }
      setDataPropSaving(true);

      // Parse existing propertiesJson and append new entry
      let existingProps: any[] = [];
      if (selectedClass.propertiesJson) {
        try {
          existingProps = typeof selectedClass.propertiesJson === 'string'
            ? JSON.parse(selectedClass.propertiesJson)
            : [...(selectedClass.propertiesJson || [])];
        } catch { /* ignore */ }
      }
      const newProp = {
        iri: values.iri,
        label: values.label,
        range: values.range || 'xsd:string',
        description: values.description || '',
      };
      existingProps.push(newProp);
      await updateObjectType(validateTarget.id, selectedClass.id, {
        propertiesJson: JSON.stringify(existingProps),
      });
      message.success('数据属性添加成功');
      setAddDataPropModalVisible(false);
      await loadProtegeData();
    } catch (e: any) {
      if (e.errorFields) return;
      message.error('添加失败: ' + (e.message || '未知错误'));
    } finally {
      setDataPropSaving(false);
    }
  };

  // ===== 数据属性编辑 =====
  const handleEditDataProperty = (prop: any, classId: string) => {
    setEditingDataProp(prop);
    setEditingDataPropClassId(classId);
    dataPropForm.setFieldsValue({
      domainClassId: classId,
      iri: prop.iri || '',
      label: prop.label || '',
      range: prop.range || 'xsd:string',
      description: prop.description || '',
    });
    setEditDataPropModalVisible(true);
  };

  const handleSaveEditDataProperty = async () => {
    if (!validateTarget || !editingDataProp) return;
    try {
      const values = await dataPropForm.validateFields();
      const classId = editingDataPropClassId;
      const selectedClass = protegeClasses.find((c: any) => c.id === classId || c.iri === classId);
      if (!selectedClass) {
        message.error('未找到对应的类');
        return;
      }
      setDataPropSaving(true);

      // Parse existing propertiesJson
      let existingProps: any[] = [];
      if (selectedClass.propertiesJson) {
        try {
          existingProps = typeof selectedClass.propertiesJson === 'string'
            ? JSON.parse(selectedClass.propertiesJson)
            : [...(selectedClass.propertiesJson || [])];
        } catch { /* ignore */ }
      }

      // Find and update the target property (match by iri since that's the stable identifier)
      const targetIri = editingDataProp.iri;
      const idx = existingProps.findIndex((p: any) => p.iri === targetIri);
      if (idx >= 0) {
        existingProps[idx] = {
          iri: values.iri,
          label: values.label,
          range: values.range || 'xsd:string',
          description: values.description || '',
        };
      }
      await updateObjectType(validateTarget.id, selectedClass.id, {
        propertiesJson: JSON.stringify(existingProps),
      });
      message.success('数据属性更新成功');
      setEditDataPropModalVisible(false);
      setEditingDataProp(null);
      setEditingDataPropClassId('');
      await loadProtegeData();
    } catch (e: any) {
      if (e.errorFields) return;
      message.error('更新失败: ' + (e.message || '未知错误'));
    } finally {
      setDataPropSaving(false);
    }
  };

  const handleDeleteDataProperty = async (prop: any, classId: string) => {
    if (!validateTarget) return;
    try {
      const selectedClass = protegeClasses.find((c: any) => c.id === classId || c.iri === classId);
      if (!selectedClass) {
        message.error('未找到对应的类');
        return;
      }
      setDataPropSaving(true);

      // Parse existing propertiesJson
      let existingProps: any[] = [];
      if (selectedClass.propertiesJson) {
        try {
          existingProps = typeof selectedClass.propertiesJson === 'string'
            ? JSON.parse(selectedClass.propertiesJson)
            : [...(selectedClass.propertiesJson || [])];
        } catch { /* ignore */ }
      }

      // Remove the target property
      const targetIri = prop.iri;
      const filteredProps = existingProps.filter((p: any) => p.iri !== targetIri);
      await updateObjectType(validateTarget.id, selectedClass.id, {
        propertiesJson: JSON.stringify(filteredProps),
      });
      message.success('数据属性已删除');
      await loadProtegeData();
    } catch (e: any) {
      message.error('删除失败: ' + (e.message || '未知错误'));
    } finally {
      setDataPropSaving(false);
    }
  };

  // ===== 继承类(subClassOf)管理 =====
  const handleAddSubClassOf = () => {
    setEditingSubClassRecord(null);
    subClassForm.resetFields();
    setAddSubClassModalVisible(true);
  };

  const handleEditSubClassOf = (record: any) => {
    setEditingSubClassRecord(record);
    subClassForm.setFieldsValue({
      childIri: record.childIri || record.childId,
      parentIri: record.parentIri || '',
    });
    setAddSubClassModalVisible(true);
  };

  const handleSaveAddSubClassOf = async () => {
    if (!validateTarget) return;
    try {
      const values = await subClassForm.validateFields();
      const childIri = values.childIri;
      const parentIri = values.parentIri;
      if (!parentIri) {
        message.warning('请选择父类');
        return;
      }
      const selectedClass = protegeClasses.find((c: any) => c.iri === childIri || c.id === childIri);
      if (!selectedClass) {
        message.error('未找到对应的子类');
        return;
      }
      // 编辑模式：跳过"已有父类"的确认（用户正在主动修改）
      if (!editingSubClassRecord && selectedClass.parentIri && selectedClass.parentIri !== parentIri) {
        // 已经有父类，确认是否覆盖
        try {
          await new Promise<void>((resolve, reject) => {
            Modal.confirm({
              title: '确认修改继承关系',
              content: `该类已继承自 "${protegeClasses.find((c: any) => iriMatches(c.iri, selectedClass.parentIri))?.label || selectedClass.parentIri}"，是否修改为新的父类？`,
              okText: '确认修改',
              cancelText: '取消',
              onOk: () => resolve(),
              onCancel: () => reject(new Error('cancel')),
            });
          });
        } catch { return; }
      }
      setSubClassSaving(true);
      await updateObjectType(validateTarget.id, selectedClass.id, { parentIri });
      message.success(editingSubClassRecord ? '继承关系更新成功' : '继承关系添加成功');
      setAddSubClassModalVisible(false);
      setEditingSubClassRecord(null);
      await loadProtegeData();
    } catch (e: any) {
      if (e.errorFields) return;
      if (e.message === 'cancel') return;
      message.error((editingSubClassRecord ? '更新' : '添加') + '失败: ' + (e.message || '未知错误'));
    } finally {
      setSubClassSaving(false);
    }
  };

  const handleDeleteSubClassOf = async (record: any) => {
    if (!validateTarget) return;
    try {
      const selectedClass = protegeClasses.find((c: any) => c.iri === record.childIri || c.id === record.childIri);
      if (!selectedClass) {
        message.error('未找到对应的类');
        return;
      }
      await new Promise<void>((resolve, reject) => {
        Modal.confirm({
          title: '确认删除继承关系',
          content: `确定要删除 "${record.childLabel}" 到 "${record.parentLabel}" 的继承关系吗？`,
          okText: '确认删除',
          cancelText: '取消',
          okButtonProps: { danger: true },
          onOk: () => resolve(),
          onCancel: () => reject(new Error('cancel')),
        });
      });
      await updateObjectType(validateTarget.id, selectedClass.id, { parentIri: '' });
      message.success('继承关系已删除');
      await loadProtegeData();
    } catch (e: any) {
      if (e.message === 'cancel') return;
      message.error('删除失败: ' + (e.message || '未知错误'));
    }
  };

  const handleEditRule = (rule: any) => {
    setSelectedRule(rule);
    ruleForm.setFieldsValue({
      name: rule.name || '',
      description: rule.description || '',
      type: rule.type || 'CONDITION',
      priority: rule.priority || 'MEDIUM',
      conditionJson: rule.conditionJson || '',
      actionJson: rule.actionJson || '',
      swrlRule: rule.swrlRule || '',
      source: rule.source || '人工',
      confidence: rule.confidence ?? 1.0,
    });
    setEditRuleModalVisible(true);
  };

  const handleSaveEditRule = async () => {
    if (!selectedRule || !validateTarget) return;
    try {
      const values = await ruleForm.validateFields();
      setRuleSaving(true);
      await updateRule(selectedRule.id, values);
      await syncRulesToTtl(validateTarget.id).catch(() => {});
      message.success('规则更新成功');
      setEditRuleModalVisible(false);
      setSelectedRule(null);
      await loadProtegeData({ skipTtlSync: true });
    } catch (e: any) {
      if (e.errorFields) return;
      message.error('更新失败: ' + (e.message || '未知错误'));
    } finally {
      setRuleSaving(false);
    }
  };

  const handleDeleteRule = async (id: string) => {
    if (!validateTarget) return;
    try {
      await deleteRule(id);
      await syncRulesToTtl(validateTarget.id).catch(() => {});
      message.success('规则已删除');
      await loadProtegeData({ skipTtlSync: true });
    } catch (e: any) {
      message.error('删除失败: ' + (e.message || '未知错误'));
    }
  };

  const handleToggleRuleStatus = async (rule: any) => {
    if (!validateTarget) return;
    try {
      if (rule.status === 'ACTIVE') {
        await deactivateRule(rule.id);
      } else {
        await activateRule(rule.id);
      }
      await syncRulesToTtl(validateTarget.id).catch(() => {});
      message.success(rule.status === 'ACTIVE' ? '规则已停用' : '规则已激活');
      await loadProtegeData({ skipTtlSync: true });
    } catch (e: any) {
      message.error('操作失败: ' + (e.message || '未知错误'));
    }
  };

  const handleRunValidate = async () => {
    if (!validateTarget) return;
    setValidateLoading(true);
    setValidateResult(null);
    try {
      const result = await validateOntology(validateTarget.id);
      setValidateResult(result);
    } catch (e: any) {
      message.error('校验失败: ' + (e.message || '未知错误'));
    } finally {
      setValidateLoading(false);
    }
  };

  const handleHermitReason = async () => {
    if (!validateTarget) return;
    setHermitLoading(true);
    setHermitResult(null);
    try {
      const result = await hermitReason(validateTarget.id);
      if (!result) {
        setHermitResult({ error: true, message: '后端返回数据为空' });
        message.error('HermiT 推理失败: 后端返回数据为空');
        return;
      }
      // 确保 result 是对象而不是字符串
      if (typeof result === 'string') {
        setHermitResult({ error: true, message: result });
        return;
      }
      console.log('[HermiT] 推理结果:', result);
      setHermitResult(result);
    } catch (e: any) {
      setHermitResult({ error: true, message: e.message || '推理失败' });
      message.error('HermiT 推理失败: ' + (e.message || '未知错误'));
    } finally {
      setHermitLoading(false);
    }
  };

  const handlePelletReason = async () => {
    if (!validateTarget) return;
    setPelletLoading(true);
    setPelletResult(null);
    try {
      const result = await pelletReason(validateTarget.id);
      if (!result) {
        setPelletResult({ error: true, message: '后端返回数据为空' });
        message.error('Pellet 推理失败: 后端返回数据为空');
        return;
      }
      if (typeof result === 'string') {
        setPelletResult({ error: true, message: result });
        return;
      }
      console.log('[Pellet] 推理结果:', result);
      setPelletResult(result);
    } catch (e: any) {
      setPelletResult({ error: true, message: e.message || '推理失败' });
      message.error('Pellet 推理失败: ' + (e.message || '未知错误'));
    } finally {
      setPelletLoading(false);
    }
  };


  const handleExportForProtege = async () => {
    if (!validateTarget) return;
    try {
      const blob = await exportOntology(validateTarget.id);
      if (!blob || !(blob instanceof Blob) || blob.size === 0) {
        message.error('导出失败：TTL 文件内容为空');
        return;
      }
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${validateTarget.name || 'ontology'}_${validateTarget.versionName || validateTarget.version}.ttl`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      message.success('TTL 文件已导出，可直接用 Protégé 打开进行精修');
    } catch (e: any) {
      message.error('导出失败: ' + (e.message || '未知错误'));
    }
  };

  const handleSaveTtl = async () => {
    if (!validateTarget) return;
    setProtegeSaving(true);
    try {
      await regenerateTtl(validateTarget.id);
      message.success('TTL 文件已从当前精修数据重新生成并保存');
    } catch (e: any) {
      message.error('保存 TTL 失败: ' + (e.message || '未知错误'));
    } finally {
      setProtegeSaving(false);
    }
  };

  // ===== 删除本体 =====
  const handleDelete = async (version: OntologyVersion) => {
    try {
      await deleteOntology(version.id);
      message.success('删除成功');
      if (selectedVersionId === version.id) {
        setSelectedVersionId('');
      }
      await loadAllVersions();
    } catch {
      // 错误消息已由 axios 拦截器统一展示，此处仅做静默处理
    }
  };

  const handleBatchDelete = () => {
    if (selectedRowKeys.length === 0) {
      message.warning('请先勾选要删除的本体版本');
      return;
    }
    Modal.confirm({
      title: '确认批量删除',
      content: `已选择 ${selectedRowKeys.length} 个本体版本，删除后将移除版本相关的类、属性、规则等数据，确认删除吗？`,
      okText: '确认删除',
      cancelText: '取消',
      okButtonProps: { danger: true },
      onOk: async () => {
        try {
          const result = await batchDeleteOntologies(selectedRowKeys as string[]);
          if (result.failed > 0) {
            message.warning(`删除完成：成功 ${result.deleted} 个，失败 ${result.failed} 个`);
          } else {
            message.success(`已成功删除 ${result.deleted} 个版本`);
          }
          setSelectedRowKeys([]);
          if (selectedVersionId && selectedRowKeys.includes(selectedVersionId)) {
            setSelectedVersionId('');
          }
          await loadAllVersions();
        } catch {
          // 错误消息已由 axios 拦截器统一展示
        }
      },
    });
  };

  // ===== 图谱可视化 =====
  const renderGraphViz = useCallback(async (classes: any[], properties: any[]) => {
    if (!graphContainerRef.current) return;
    if (graphRef.current) {
      graphRef.current.destroy();
      graphRef.current = null;
    }
    if (classes.length === 0 && properties.length === 0) return;

    try {
      const { Graph: G6Graph } = await import('@antv/g6');
      const hasInheritance = classes.some((c: any) => c.parentIri);

      const classColorMap: Record<string, string> = {};
      classes.forEach((cls: any, i: number) => {
        classColorMap[cls.iri || cls.id] = NODE_COLORS[i % NODE_COLORS.length];
      });

      const isMindmap = browseViewMode === 'mindmap';

      // 构建节点
      const nodes: any[] = classes.map((cls: any, i: number) => {
        const label = cls.label || cls.iri?.split('/').pop() || `Class${i}`;
        const color = NODE_COLORS[i % NODE_COLORS.length];
        const isRoot = !cls.parentIri;

        if (isMindmap) {
          const nodeSize = isRoot ? 56 : 40;
          return {
            id: cls.iri || cls.id || `class-${i}`,
            label,
            data: { ...cls, colorIndex: i, color },
            style: {
              fill: '#fff',
              stroke: color,
              lineWidth: 2.5,
              shadowColor: 'rgba(0,0,0,0.08)',
              shadowBlur: 8,
              labelText: label,
              labelFill: '#333',
              labelFontSize: isRoot ? 12 : 11,
              labelFontWeight: 'normal',
              labelLineHeight: 14,
              labelWordWrap: true,
              size: nodeSize,
            },
            type: 'circle',
          };
        }

        // 图形模式
        const nodeSize = isRoot ? 50 : 36;
        return {
          id: cls.iri || cls.id || `class-${i}`,
          label,
          data: { ...cls, colorIndex: i },
          style: {
            fill: '#fff',
            stroke: color,
            lineWidth: isRoot ? 2.5 : 1.5,
            shadowColor: 'rgba(0,0,0,0.08)',
            shadowBlur: 6,
            labelText: label,
            labelFill: '#1a1a1a',
            labelFontSize: isRoot ? 14 : 12,
            labelFontWeight: isRoot ? 700 : 500,
            labelPlacement: 'center' as const,
            size: nodeSize,
          },
          type: 'circle',
        };
      });

      // 构建边：对象属性 + 继承关系
      const edges: any[] = [];

      properties.forEach((prop: any, i: number) => {
        const sourceLabel = prop.sourceType || prop.domain;
        const targetLabel = prop.targetType || prop.range;
        if (!sourceLabel || !targetLabel) return;
        const sourceNode = classes.find((c: any) =>
          c.label === sourceLabel || iriMatches(c.iri, sourceLabel)
        );
        const targetNode = classes.find((c: any) =>
          c.label === targetLabel || iriMatches(c.iri, targetLabel)
        );
        if (!sourceNode || !targetNode) return;
        const edgeColor = classColorMap[sourceNode.iri || sourceNode.id] || '#666';
        edges.push({
          id: `edge-${i}-${prop.id || i}`,
          source: sourceNode.iri || sourceNode.id,
          target: targetNode.iri || targetNode.id,
          label: prop.label || prop.iri?.split('/').pop() || '',
          data: { ...prop },
          style: {
            stroke: edgeColor,
            lineWidth: isMindmap ? 1 : 1.5,
            opacity: isMindmap ? 0.4 : 0.7,
            endArrow: true,
            endArrowFill: edgeColor,
            endArrowSize: 6,
            labelText: isMindmap ? '' : (prop.label || prop.iri?.split('/').pop() || ''),
            labelFill: '#555',
            labelFontSize: 10,
            labelAutoRotate: true,
            labelBackground: true,
            labelBackgroundFill: '#fff',
            labelBackgroundOpacity: 0.95,
            labelPadding: [2, 6, 2, 6],
            labelBackgroundRadius: 3,
          },
        });
      });

      // 继承边
      classes.forEach((cls: any, i: number) => {
        if (cls.parentIri) {
          const parentNode = classes.find((c: any) => iriMatches(c.iri, cls.parentIri) || c.label === cls.parentIri);
          if (parentNode && (parentNode.iri || parentNode.id) !== (cls.iri || cls.id)) {
            if (isMindmap) {
              const childColor = NODE_COLORS[i % NODE_COLORS.length];
              edges.push({
                id: `inherit-${i}`,
                source: parentNode.iri || parentNode.id,
                target: cls.iri || cls.id,
                data: { isInherit: true },
                type: 'cubic-horizontal',
                style: {
                  stroke: childColor,
                  lineWidth: 2,
                  opacity: 0.6,
                  endArrow: false,
                },
              });
            } else {
              edges.push({
                id: `inherit-${i}`,
                source: cls.iri || cls.id,
                target: parentNode.iri || parentNode.id,
                data: { isInherit: true },
                type: 'line',
                style: {
                  stroke: '#888',
                  lineWidth: 1.2,
                  lineDash: [6, 4],
                  opacity: 0.6,
                  endArrow: true,
                  endArrowSize: 10,
                  endArrowFill: '#fff',
                  endArrowStroke: '#888',
                  labelText: '',
                },
              });
            }
          }
        }
      });


      const container = graphContainerRef.current;
      if (!container) return;

      let layoutConfig: any;
      if (isMindmap) {
        if (hasInheritance) {
          layoutConfig = {
            type: 'dagre',
            rankdir: 'LR',
            nodesep: 50,
            ranksep: 65,
            preventOverlap: true,
          };
        } else {
          layoutConfig = {
            type: 'dagre',
            rankdir: 'LR',
            nodesep: 100,
            ranksep: 165,
            preventOverlap: true,
          };
        }
      } else {
        layoutConfig = hasInheritance
          ? { type: 'dagre', rankdir: 'TB', nodesep: 40, ranksep: 55, preventOverlap: true }
          : { type: 'dagre', rankdir: 'TB', nodesep: 100, ranksep: 165, preventOverlap: true };
      }
      layoutConfig.animate = false;

      // 获取外层滚动容器
      const scrollContainer = container.parentElement;
      const containerWidth = scrollContainer?.offsetWidth || 800;
      const containerHeight = scrollContainer?.offsetHeight || 600;

      // 计算内容边界
      const minCanvasSize = 600;
      const nodeSizeFactor = isMindmap ? 80 : 70;
      const estimatedSize = Math.max(minCanvasSize, Math.sqrt(nodes.length) * nodeSizeFactor * 2);

      // 初始画布尺寸
      const initialWidth = Math.max(containerWidth, estimatedSize);
      const initialHeight = Math.max(containerHeight, estimatedSize);

      // 渲染前隐藏画布，避免布局计算过程中的视觉跳动
      container.style.visibility = 'hidden';

      // 初始画布尺寸设为容器尺寸
      const graph: any = new G6Graph({
        container,
        width: initialWidth,
        height: initialHeight,
        autoFit: 'view',
        animation: false,
        data: { nodes, edges },
        layout: layoutConfig,
        node: {
          style: {
            labelText: (d: any) => d.label || '',
            labelPlacement: 'center',
            cursor: 'move',
          },
          state: {
            selected: { lineWidth: 3, shadowBlur: 12, shadowColor: 'rgba(22,119,255,0.4)' },
            hover: { lineWidth: 3, shadowBlur: 12, shadowColor: 'rgba(22,119,255,0.3)' },
          },
        },
        edge: {
          type: isMindmap ? 'cubic-horizontal' : 'quadratic',
          style: { endArrow: true, cursor: 'pointer' },
          state: {
            selected: { lineWidth: 3, stroke: '#1677ff' },
            hover: { lineWidth: 2, stroke: '#1677ff' },
          },
        },
        behaviors: [
          'drag-canvas',
          'zoom-canvas',
          {
            type: 'drag-element',
            key: 'drag-element',
            enable: (evt: any) => evt.targetType === 'node',
          },
          'click-select',
        ],
        plugins: [
          {
            type: 'tooltip',
            key: 'tooltip',
            enterable: true,
            getContent: (evt: any, items: any[]) => {
              const { targetType } = evt;
              if (!items || items.length === 0) return '';

              const item = items[0];

              // 边的tooltip
              if (targetType === 'edge') {
                const edgeId = item.id || '';

                if (edgeId.startsWith('inherit-')) {
                  // 继承线
                  const result: string[] = ['<b style="color:#888">继承关系</b>'];
                  const sourceId = item.source;
                  const targetId = item.target;
                  const sourceClass = classes.find((c: any) => c.iri === sourceId || c.id === sourceId);
                  const targetClass = classes.find((c: any) => c.iri === targetId || c.id === targetId);
                  const sourceLabel = sourceClass?.label || sourceId?.split('/').pop() || '';
                  const targetLabel = targetClass?.label || targetId?.split('/').pop() || '';
                  result.push(`<span>${sourceLabel} 继承自 ${targetLabel}</span>`);
                  return `<div style="padding:8px 12px;font-size:12px;line-height:1.8">${result.join('<br/>')}</div>`;
                }

                // 对象属性关系线
                const d = item.data || {};
                const result: string[] = [];
                if (d.label) result.push(`<b>${d.label}</b>`);
                if (d.sourceType && d.targetType) result.push(`<span style="color:#888">${d.sourceType} → ${d.targetType}</span>`);
                if (d.iri) result.push(`<span style="color:#999">IRI: ${d.iri}</span>`);
                if (d.description) result.push(d.description);
                if (result.length === 0) result.push('<span style="color:#888">对象属性关系</span>');
                return `<div style="padding:8px 12px;font-size:12px;line-height:1.8">${result.join('<br/>')}</div>`;
              }

              // 节点tooltip
              if (targetType === 'node') {
                const d = item.data || {};
                const result: string[] = [];
                const label = d.label || item.label;
                if (label) result.push(`<b>${label}</b>`);
                if (d.iri) result.push(`<span style="color:#999">IRI: ${d.iri}</span>`);
                if (d.description) result.push(d.description);
                if (result.length === 0) result.push('<span style="color:#888">对象类型</span>');
                return `<div style="padding:8px 12px;font-size:12px;line-height:1.8">${result.join('<br/>')}</div>`;
              }

              return '';
            },
          },
        ],
      });

      await graph.render();

      // 渲染完成后显示画布
      container.style.visibility = 'visible';

      // 渲染后根据实际内容边界更新画布尺寸
      const updateCanvasSize = (zoomLevel: number = 1) => {
        try {
          const bounds = graph.getBounds();
          if (bounds) {
            const padding = 80;
            const contentWidth = bounds.max[0] - bounds.min[0] + padding * 2;
            const contentHeight = bounds.max[1] - bounds.min[1] + padding * 2;

            // 计算缩放后的实际尺寸，但不小于容器尺寸
            const actualWidth = Math.max(containerWidth, contentWidth * zoomLevel);
            const actualHeight = Math.max(containerHeight, contentHeight * zoomLevel);

            // 更新画布和容器尺寸
            graph.setSize(actualWidth, actualHeight);
            container.style.width = `${actualWidth}px`;
            container.style.height = `${actualHeight}px`;
          }
        } catch { /* ignore */ }
      };

      // 监听布局完成后更新尺寸（节点拖拽后重新布局时）
      graph.on('afterlayout', () => updateCanvasSize(1));

      graphRef.current = graph;
    } catch (e) {
      console.error('G6 初始化失败:', e);
    }
  }, [browseViewMode]);

  // 用 ref 持有最新的 renderGraphViz，避免 loadGraphData 因 view mode 变化而重建
  const renderGraphVizRef = useRef(renderGraphViz);
  renderGraphVizRef.current = renderGraphViz;

  const loadGraphData = useCallback(async (ontologyId: string) => {
    if (!ontologyId) return;
    setGraphLoading(true);
    try {
      const [classes, properties] = await Promise.all([
        getObjectTypes(ontologyId),
        getLinkTypes(ontologyId),
      ]);
      setBrowseClasses(classes || []);
      setBrowseProperties(properties || []);
      // 不在此处直接调用 renderGraphViz，因为 graphLoading=true 时画布 DOM 被卸载
      // 由下方 useEffect 在 browseClasses 更新且画布挂载后触发渲染
    } catch (e: any) {
      console.error('加载本体数据失败:', e);
      message.error('加载本体数据失败');
    } finally {
      setGraphLoading(false);
    }
  }, []);

  useEffect(() => {
    if (selectedVersionId) {
      loadGraphData(selectedVersionId);
    }
  }, [selectedVersionId, loadGraphData]);

  // 数据加载完成或切换视图模式时重新渲染（此时 graphLoading=false，画布已挂载）
  useEffect(() => {
    if (browseClasses.length > 0 && graphContainerRef.current) {
      renderGraphViz(browseClasses, browseProperties);
    }
  }, [browseClasses, browseViewMode, renderGraphViz]);

  useEffect(() => {
    const handleResize = () => {
      // 窗口大小变化时重新渲染图谱以重新计算画布尺寸
      if (browseClasses.length > 0 && graphContainerRef.current) {
        renderGraphVizRef.current(browseClasses, browseProperties);
      }
    };
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, [browseClasses, browseProperties]);

  // 按名称分组版本（支持搜索过滤）
  const groupedVersions: Record<string, OntologyVersion[]> = {};
  allVersions.forEach(v => {
    if (!groupedVersions[v.name]) groupedVersions[v.name] = [];
    groupedVersions[v.name].push(v);
  });
  const allOntologyNames = Object.keys(groupedVersions).sort();
  // 搜索过滤：按本体名称、描述、版本名匹配
  const filteredNames = allOntologyNames.filter(name => {
    if (!searchText.trim()) return true;
    const kw = searchText.toLowerCase().trim();
    const group = groupedVersions[name];
    return name.toLowerCase().includes(kw) ||
      group.some(v =>
        (v.description && v.description.toLowerCase().includes(kw)) ||
        (v.versionName && v.versionName.toLowerCase().includes(kw)) ||
        (v.sourceModelName && v.sourceModelName.toLowerCase().includes(kw))
      );
  });
  const ontologyNames = filteredNames;
  // 搜索时，组内也过滤匹配的版本
  const filteredGroupedVersions: Record<string, OntologyVersion[]> = {};
  if (searchText.trim()) {
    const kw = searchText.toLowerCase().trim();
    filteredNames.forEach(name => {
      const group = groupedVersions[name];
      filteredGroupedVersions[name] = group.filter(v =>
        name.toLowerCase().includes(kw) ||
        (v.description && v.description.toLowerCase().includes(kw)) ||
        (v.versionName && v.versionName.toLowerCase().includes(kw)) ||
        (v.sourceModelName && v.sourceModelName.toLowerCase().includes(kw))
      );
    });
  }
  const selectedVersion = allVersions.find(v => v.id === selectedVersionId);

  // ===== 渲染结构化 Wiki 文档 =====
  const renderStructuredWiki = (result: OntologyExtractionResult) => {
    if (!result) return '';
    const mdParts: string[] = [];

    mdParts.push(`# ${result.name || '未命名本体模型'}\n`);
    if (result.description) mdParts.push(`> ${result.description}\n`);

    // 类清单
    mdParts.push(`## 本体类 (${result.classes.length} 个)\n`);
    if (result.classes.length === 0) {
      mdParts.push('_暂无_\n');
    } else {
      result.classes.forEach(cls => {
        mdParts.push(`- **${cls.label || cls.iri}**`);
        if (cls.parentIri) mdParts.push(`  - 父类: \`${cls.parentIri}\``);
        if (cls.description) mdParts.push(`  - ${cls.description}`);
        mdParts.push('');
      });
    }

    // 对象属性
    mdParts.push(`## 对象属性 (${result.objectProperties.length} 个)\n`);
    if (result.objectProperties.length === 0) {
      mdParts.push('_暂无_\n');
    } else {
      mdParts.push('| 名称 | 定义域 (Domain) | 值域 (Range) | 描述 |');
      mdParts.push('|------|----------------|-------------|------|');
      result.objectProperties.forEach(prop => {
        const domain = (prop as any).domain || (prop as any).sourceType || '-';
        const range = (prop as any).range || (prop as any).targetType || '-';
        mdParts.push(`| ${prop.label || prop.iri} | ${domain} | ${range} | ${prop.description || '-'} |`);
      });
      mdParts.push('');
    }

    // 数据属性
    mdParts.push(`## 数据属性 (${result.dataProperties.length} 个)\n`);
    if (result.dataProperties.length === 0) {
      mdParts.push('_暂无_\n');
    } else {
      mdParts.push('| 名称 | 数据类型 | 描述 |');
      mdParts.push('|------|---------|------|');
      result.dataProperties.forEach(prop => {
        const dataType = (prop as any).range || '-';
        mdParts.push(`| ${prop.label || prop.iri} | ${dataType} | ${prop.description || '-'} |`);
      });
      mdParts.push('');
    }

    // 业务规则
    mdParts.push(`## 业务规则 (${result.rules.length} 条)\n`);
    if (result.rules.length === 0) {
      mdParts.push('_暂无_\n');
    } else {
      result.rules.forEach((rule, idx) => {
        mdParts.push(`### 规则 ${idx + 1}: ${rule.name || `规则${idx + 1}`}\n`);
        if (rule.description) mdParts.push(`${rule.description}\n`);
        if (rule.condition) mdParts.push(`- **条件**: ${rule.condition}`);
        if (rule.action) mdParts.push(`- **动作**: ${rule.action}`);
        if ((rule as any).swrlRule) mdParts.push(`- **SWRL**: \`${(rule as any).swrlRule}\``);
        mdParts.push('');
      });
    }

    // TTL 代码块
    if (result.ttlContent) {
      mdParts.push('## TTL 本体定义\n');
      mdParts.push('```turtle\n' + result.ttlContent + '\n```\n');
    }

    return mdParts.join('\n');
  };

  return (
    <div>
      <Title level={4}>本体建模</Title>
      <Space style={{ marginBottom: 8 }} wrap>
        <Text type="secondary">
          从 Wiki 文档或 Markdown 提取 W3C OWL2 本体模型，支持可视化编辑和多版本管理。
        </Text>
        <Button size="small" icon={<SwapOutlined />}
          onClick={() => {
            if (selectedVersionId) {
              const v = allVersions.find((ver: OntologyVersion) => ver.id === selectedVersionId);
              if (v) { setDiffOntologyId(v.id); setDiffOntologyName(v.name + ' ' + (v.versionName || '')); }
            } else if (ontologyNames.length > 0) {
              const name = ontologyNames[0];
              const group = groupedVersions[name];
              if (group && group.length >= 2) {
                // Pick the two most recent versions
                setDiffOntologyId(group[0].id);
                setDiffOntologyName(name + ' ' + (group[0].versionName || '') + ' vs ' + (group[1].versionName || group[1].version));
              } else if (group && group.length > 0) {
                setDiffOntologyId(group[0].id);
                setDiffOntologyName(name + ' ' + (group[0].versionName || ''));
              }
            }
            setDiffModalOpen(true);
          }}>
          版本对比
        </Button>
        <Button size="small" icon={<HistoryOutlined />}
          onClick={() => {
            const name = ontologyNames.length > 0 ? ontologyNames[0] : '';
            setHistoryOntologyName(name);
            setHistoryModalOpen(true);
          }}>
          变更历史
        </Button>
      </Space>

      <style>{`
        .markdown-wiki { font-size: 14px; line-height: 1.8; color: #333; }
        .markdown-wiki h1 { font-size: 22px; font-weight: 700; border-bottom: 2px solid #1677ff; padding-bottom: 8px; margin: 20px 0 12px; color: #111; }
        .markdown-wiki h2 { font-size: 18px; font-weight: 600; border-bottom: 1px solid #e8e8e8; padding-bottom: 6px; margin: 16px 0 10px; color: #222; }
        .markdown-wiki h3 { font-size: 15px; font-weight: 600; margin: 12px 0 8px; color: #333; }
        .markdown-wiki p { margin: 6px 0; }
        .markdown-wiki table { border-collapse: collapse; width: 100%; margin: 10px 0; }
        .markdown-wiki th, .markdown-wiki td { border: 1px solid #d9d9d9; padding: 6px 10px; text-align: left; }
        .markdown-wiki th { background: #fafafa; font-weight: 600; color: #333; font-size: 13px; }
        .markdown-wiki td { color: #555; font-size: 13px; }
        .markdown-wiki code { background: #f5f5f5; padding: 2px 5px; border-radius: 3px; font-size: 12px; color: #c7254e; }
        .markdown-wiki pre { background: #f5f5f5; padding: 12px; border-radius: 6px; overflow-x: auto; border: 1px solid #e8e8e8; }
        .markdown-wiki pre code { background: none; color: #333; padding: 0; font-size: 12px; }
        .markdown-wiki ul, .markdown-wiki ol { padding-left: 22px; margin: 6px 0; }
        .markdown-wiki li { margin: 3px 0; }
        .markdown-wiki blockquote { border-left: 4px solid #1677ff; padding: 6px 14px; margin: 10px 0; background: #f0f5ff; color: #555; }
        .markdown-wiki strong { color: #111; }
      `}</style>
      {/* Markdown自动提取本体模型 */}
      <Card size="small" style={{ marginTop: 16 }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 16, flexWrap: 'wrap' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
            <ThunderboltOutlined style={{ color: '#1677ff', fontSize: 16 }} />
            <Text strong style={{ whiteSpace: 'nowrap' }}>本体提取:</Text>
          </div>
          <Button
            type="primary"
            icon={<ThunderboltOutlined />}
            onClick={handleOpenExtractModal}
          >
            Markdown自动提取本体模型
          </Button>
          <Button
            icon={<PlusOutlined />}
            onClick={handleOpenImportTtlModal}
          >
            直接导入TTL本体文件
          </Button>
        </div>
      </Card>

      {/* Markdown自动提取本体模型对话框 */}
      <Modal
        open={extractModalVisible}
        title={
          <Space>
            <ThunderboltOutlined />
            <span>Markdown自动提取本体模型</span>
            {extractPhase === 'extracting' && <Tag color="processing">提取中...</Tag>}
            {extractPhase === 'done' && <Tag color="success">提取完成</Tag>}
            {extractPhase === 'paused' && <Tag color="warning">已暂停</Tag>}
          </Space>
        }
        width="80%"
        maskClosable={false}
        onCancel={() => {
          if (extractPhase === 'extracting') {
            Modal.confirm({
              title: '确认关闭？',
              content: '提取正在进行中，关闭后当前进度将丢失。',
              onOk: () => {
                if (abortControllerRef.current) abortControllerRef.current.abort();
                setExtractModalVisible(false);
              },
            });
          } else {
            setExtractModalVisible(false);
          }
        }}
        footer={
          <Space>
            {extractPhase === 'config' && (
              <>
                <Button onClick={() => setExtractModalVisible(false)}>取消</Button>
                <Button
                  type="primary"
                  icon={<ThunderboltOutlined />}
                  loading={mdFileLoading}
                  disabled={!selectedFileId || !selectedModelKey || !ontologyName.trim() || !versionName.trim()}
                  onClick={handleStartExtraction}
                >
                  开始提取
                </Button>
              </>
            )}
            {extractPhase === 'extracting' && (
              <Button
                danger
                icon={<PauseCircleOutlined />}
                onClick={handlePauseExtraction}
              >
                暂停
              </Button>
            )}
            {extractPhase === 'paused' && (
              <>
                <Button onClick={() => setExtractModalVisible(false)}>关闭</Button>
                <Button
                  type="primary"
                  icon={<RedoOutlined />}
                  onClick={handleRetryExtraction}
                >
                  重新提取
                </Button>
              </>
            )}
            {extractPhase === 'done' && (
              <>
                <Button onClick={() => setExtractModalVisible(false)}>取消</Button>
                <Button
                  type="primary"
                  icon={<SaveOutlined />}
                  loading={saving}
                  onClick={handleSaveResult}
                >
                  保存为TTL文件
                </Button>
              </>
            )}
          </Space>
        }
      >
        <Space direction="vertical" style={{ width: '100%' }} size={16}>
          {/* 配置区域：文件选择、模型选择、本体名称、版本名称 */}
          <Card size="small" styles={{ body: { background: '#fafafa' } }}>
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
              <div>
                <Text strong>选择要转换的Markdown文件 <span style={{ color: '#ff4d4f' }}>*</span></Text>
                <TreeSelect
                  style={{ width: '100%', marginTop: 4 }}
                  placeholder="从知识提炼中选择 Markdown 文件"
                  value={selectedFileId || undefined}
                  onChange={setSelectedFileId}
                  loading={mdFileLoading}
                  disabled={extractPhase === 'extracting'}
                  showSearch
                  treeNodeFilterProp="title"
                  notFoundContent={mdFileLoading ? '加载中...' : mdFileList.length === 0 ? '暂无 Markdown 文件，请先在知识提炼中上传' : '无匹配文件'}
                  treeData={buildMdFileTreeData(mdFileList)}
                  allowClear
                />
              </div>
              <div>
                <Text strong>选择提取模型 <span style={{ color: '#ff4d4f' }}>*</span></Text>
                <Select
                  style={{ width: '100%', marginTop: 4 }}
                  placeholder="选择用于本体提取的 AI 模型"
                  value={selectedModelKey || undefined}
                  onChange={setSelectedModelKey}
                  disabled={extractPhase === 'extracting'}
                  allowClear
                  showSearch
                  optionFilterProp="label"
                  notFoundContent={activeProviders.length === 0 ? '暂无可用模型，请先在模型管理中配置' : '无匹配模型'}
                  options={activeProviders.flatMap(p =>
                    (p.models || []).map(m => ({
                      value: `${p.id}::${m.modelId}`,
                      label: `${m.name} · ${p.name}`,
                    })),
                  )}
                />
              </div>
              <div>
                <Text strong>本体模型名称 <span style={{ color: '#ff4d4f' }}>*</span></Text>
                <Input
                  style={{ marginTop: 4 }}
                  placeholder="定义本体模型名称（相同名称的版本将归为一组）"
                  value={ontologyName}
                  onChange={e => setOntologyName(e.target.value)}
                  disabled={extractPhase === 'extracting'}
                />
              </div>
              <div>
                <Text strong>版本号名称 <span style={{ color: '#ff4d4f' }}>*</span></Text>
                <Input
                  style={{ marginTop: 4 }}
                  placeholder="定义版本号名称，支持中英文/数字/空格/_/-"
                  value={versionName}
                  onChange={e => setVersionName(e.target.value)}
                  maxLength={50}
                  disabled={extractPhase === 'extracting'}
                  status={versionName && !VERSION_NAME_PATTERN.test(versionName) ? 'error' : undefined}
                />
                {versionName && !VERSION_NAME_PATTERN.test(versionName) && (
                  <Text type="danger" style={{ fontSize: 12 }}>版本名称仅支持中英文/数字/空格/_/-，且不超过50个字符</Text>
                )}
              </div>
            </div>
            {/* 自定义提示词区域 */}
            <div style={{ marginTop: 12 }}>
              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text strong>系统提示词 (System Prompt)</Text>
                <Button
                  type="link"
                  size="small"
                  onClick={() => setShowPromptEditor(!showPromptEditor)}
                  disabled={extractPhase === 'extracting'}
                >
                  {showPromptEditor ? '收起' : '展开编辑'}
                </Button>
              </div>
              {showPromptEditor ? (
                <Input.TextArea
                  style={{ marginTop: 4 }}
                  rows={4}
                  value={systemPrompt}
                  onChange={e => setSystemPrompt(e.target.value)}
                  disabled={extractPhase === 'extracting'}
                  placeholder="输入自定义系统提示词，将作为大模型 system prompt 的一部分"
                />
              ) : (
                <div
                  style={{
                    marginTop: 4,
                    padding: '8px 12px',
                    background: '#fff',
                    border: '1px solid #d9d9d9',
                    borderRadius: 6,
                    color: '#666',
                    fontSize: 13,
                    cursor: 'pointer',
                    whiteSpace: 'nowrap',
                    overflow: 'hidden',
                    textOverflow: 'ellipsis',
                  }}
                  onClick={() => setShowPromptEditor(true)}
                >
                  {systemPrompt || '点击展开编辑提示词'}
                </div>
              )}
              {showPromptEditor && (
                <Button
                  size="small"
                  style={{ marginTop: 4 }}
                  onClick={async () => {
                    try {
                      const defaultPrompt = await fetchDefaultOntologyExtractionPrompt();
                      if (defaultPrompt) setSystemPrompt(defaultPrompt);
                    } catch { setSystemPrompt(''); }
                  }}
                  disabled={extractPhase === 'extracting'}
                >
                  恢复默认
                </Button>
              )}
            </div>
          </Card>

          {/* 初始提示 */}
          {extractPhase === 'config' && (
            <Alert
              type="info"
              showIcon
              message="请选择要转换的Markdown文件，定义本体模型名称和版本号，选择AI提取模型后，点击「开始提取」按钮。系统将调用大模型对Markdown文件进行TTL转换，生成符合W3C标准的RDF/OWL本体模型文件。"
            />
          )}

          {/* 流式输出区域 */}
          {(extractPhase === 'extracting' || extractPhase === 'done' || extractPhase === 'paused') && (
            <div>
              <div style={{ marginBottom: 8, display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text strong>AI模型转换结果</Text>
                {extractPhase === 'done' && extractionResult && (
                  <Tag color="success" style={{ fontSize: 12 }}>
                    提取完成: {(extractionResult.classes || []).length} 个本体类, {(extractionResult.objectProperties || []).length} 个对象属性, {(extractionResult.dataProperties || []).length} 个数据属性, {(extractionResult.rules || []).length} 条规则
                  </Tag>
                )}
                {extractPhase === 'paused' && (
                  <Tag color="warning" style={{ fontSize: 12 }}>提取已暂停</Tag>
                )}
              </div>
              {extractPhase === 'extracting' && extractStatus && (
                <div style={{
                  background: '#e6f7ff',
                  border: '1px solid #91d5ff',
                  borderRadius: 6,
                  padding: '6px 12px',
                  marginBottom: 8,
                  fontSize: 13,
                  color: '#1677ff',
                }}>
                  {extractStatus}
                </div>
              )}
              {extractPhase === 'extracting' && !extractStatus && (
                <div style={{
                  background: '#f6ffed',
                  border: '1px solid #b7eb8f',
                  borderRadius: 6,
                  padding: '6px 12px',
                  marginBottom: 8,
                  fontSize: 13,
                  color: '#52c41a',
                }}>
                  AI 模型正在生成本体模型内容...
                </div>
              )}
              <div style={{
                background: '#fafafa',
                color: '#333',
                padding: 16,
                borderRadius: 8,
                fontSize: 13,
                lineHeight: 1.7,
                maxHeight: '50vh',
                overflow: 'auto',
                border: '1px solid #e8e8e8',
                fontFamily: 'Consolas, Monaco, "Courier New", monospace',
                whiteSpace: 'pre-wrap',
                wordBreak: 'break-all',
              }}>
                {streamContent || <span style={{ color: '#bbb' }}>等待 AI 模型响应...</span>}
                {extractPhase === 'extracting' && <span style={{ borderRight: '2px solid #1677ff', marginLeft: 2 }}>&nbsp;</span>}
                <div ref={streamEndRef} />
              </div>
            </div>
          )}
        </Space>
      </Modal>

      {/* 直接导入TTL本体文件对话框 */}
      <Modal
        open={importTtlModalVisible}
        title={
          <Space>
            <PlusOutlined />
            <span>直接导入TTL本体文件</span>
          </Space>
        }
        width={560}
        maskClosable={false}
        onCancel={() => setImportTtlModalVisible(false)}
        footer={
          <Space>
            <Button onClick={() => setImportTtlModalVisible(false)}>取消</Button>
            <Button
              type="primary"
              icon={<PlusOutlined />}
              loading={importTtlLoading}
              disabled={!importTtlName.trim() || !ttlUploadFile || !importTtlVersionName.trim()}
              onClick={handleImportTtl}
            >
              导入
            </Button>
          </Space>
        }
      >
        <Space direction="vertical" style={{ width: '100%' }} size={16}>
          <Alert
            type="info"
            showIcon
            message="支持上传 .ttl 格式的本体文件，系统将自动解析并创建本体模型记录。"
          />
          <div>
            <Text strong>本体模型名称 <span style={{ color: '#ff4d4f' }}>*</span></Text>
            <Input
              style={{ marginTop: 4 }}
              placeholder="输入本体模型名称（相同名称的版本将归为一组）"
              value={importTtlName}
              onChange={e => setImportTtlName(e.target.value)}
            />
          </div>
          <div>
            <Text strong>版本号名称 <span style={{ color: '#ff4d4f' }}>*</span></Text>
            <Input
              style={{ marginTop: 4 }}
              placeholder="输入版本号名称，支持中英文/数字/空格/_/-"
              value={importTtlVersionName}
              onChange={e => setImportTtlVersionName(e.target.value)}
              maxLength={50}
              status={importTtlVersionName && !VERSION_NAME_PATTERN.test(importTtlVersionName) ? 'error' : undefined}
            />
            {importTtlVersionName && !VERSION_NAME_PATTERN.test(importTtlVersionName) && (
              <Text type="danger" style={{ fontSize: 12 }}>版本名称仅支持中英文/数字/空格/_/-，且不超过50个字符</Text>
            )}
          </div>
          <div>
            <Text strong>选择TTL文件 <span style={{ color: '#ff4d4f' }}>*</span></Text>
            <div style={{ marginTop: 4 }}>
              <Upload
                accept=".ttl"
                maxCount={1}
                beforeUpload={(file) => {
                  if (!file.name.toLowerCase().endsWith('.ttl')) {
                    message.error('仅支持 .ttl 格式文件');
                    return Upload.LIST_IGNORE;
                  }
                  setTtlUploadFile(file);
                  return false; // 阻止自动上传
                }}
                onRemove={() => setTtlUploadFile(null)}
                fileList={ttlUploadFile ? [{
                  uid: '-1',
                  name: ttlUploadFile.name,
                  size: ttlUploadFile.size,
                  status: 'done' as const,
                }] : []}
              >
                <Button icon={<UploadOutlined />}>选择文件</Button>
              </Upload>
            </div>
          </div>
        </Space>
      </Modal>

      {/* ===== 本体模型多版本管理：左右布局 ===== */}
      <div style={{ display: 'flex', marginTop: 16, minHeight: 600 }}>
        {/* 左侧：本体模型列表 */}
        <Card
          title={
            <Space>
              <HistoryOutlined />
              <span>本体模型列表</span>
              <Tag>{ontologyNames.length} 个本体</Tag>
            </Space>
          }
          extra={
            <Button danger icon={<DeleteOutlined />} size="small" onClick={handleBatchDelete}>
              批量删除{selectedRowKeys.length > 0 ? ` (${selectedRowKeys.length})` : ''}
            </Button>
          }
          size="small"
          style={{ width: leftPanelWidth, flexShrink: 0 }}
          styles={{ body: { padding: 0, maxHeight: 560, overflow: 'auto' } }}
        >
          {allVersionsLoading ? (
            <div style={{ textAlign: 'center', padding: 40 }}><Spin tip="加载中..."><div style={{ padding: 20 }}>加载中...</div></Spin></div>
          ) : (
            <>
              {/* 搜索框 */}
              <div style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0', position: 'sticky', top: 0, background: '#fff', zIndex: 1 }}>
                <Input.Search
                  placeholder="搜索本体名称、描述、版本..."
                  allowClear
                  value={searchText}
                  onChange={e => setSearchText(e.target.value)}
                  onSearch={val => setSearchText(val)}
                  size="small"
                />
              </div>
              {ontologyNames.length === 0 ? (
            <Empty
              description={searchText.trim() ? `未找到匹配 "${searchText}" 的本体` : '暂无本体模型'}
              image={Empty.PRESENTED_IMAGE_SIMPLE}
              style={{ marginTop: 40 }}
            />
          ) : (
            <div style={{ padding: '4px 0' }}>
              {ontologyNames.map(name => {
                const group = searchText.trim() ? filteredGroupedVersions[name] : groupedVersions[name];
                return (
                  <div key={name} style={{ borderBottom: '1px solid #f5f5f5', paddingBottom: 8 }}>
                    {/* 本体名称标题 */}
                    <div style={{
                      padding: '8px 16px',
                      background: '#fafbfc',
                      fontWeight: 600,
                      fontSize: 13,
                      display: 'flex',
                      alignItems: 'center',
                      gap: 8,
                    }}>
                      <FileTextOutlined style={{ color: '#1677ff' }} />
                      <span style={{ flex: 1, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                        {name}
                      </span>
                      <Tag style={{ fontSize: 11 }}>{group.length} 个版本</Tag>
                    </div>
                    {/* 版本表格 */}
                    <Table
                      dataSource={group}
                      rowKey="id"
                      size="small"
                      showHeader={false}
                      pagination={false}
                      rowSelection={{
                        selectedRowKeys,
                        onChange: (keys) => {
                          // 合并跨表格的选择：保留其他表格已选项，加上当前表格的选项
                          setSelectedRowKeys(prev => {
                            const thisTableKeys = new Set(group.map(v => v.id));
                            const otherKeys = prev.filter(k => !thisTableKeys.has(k));
                            return [...new Set([...otherKeys, ...keys])];
                          });
                        },
                      }}
                      rowClassName={(r: OntologyVersion) => selectedVersionId === r.id ? 'ant-table-row-selected' : ''}
                      onRow={(r: OntologyVersion) => ({
                        onClick: () => setSelectedVersionId(r.id),
                        style: { cursor: 'pointer' },
                      })}
                      columns={[
                        {
                          title: '版本号',
                          render: (_: any, r: OntologyVersion) => (
                            <Space size={4}>
                              {r.versionName && <Tag color={r.current ? 'success' : 'default'} style={{ fontSize: 11, margin: 0 }}>{r.versionName}</Tag>}
                              {r.current && <span style={{ color: '#52c41a', fontSize: 11 }}>最新</span>}
                            </Space>
                          ),
                        },
                        {
                          title: '摘要',
                          render: (_: any, r: OntologyVersion) => (
                            <Tooltip title={`${r.classCount || 0} 类 · ${r.objectPropertyCount ?? 0} 对象属性 · ${r.dataPropertyCount ?? 0} 数据属性 · ${r.ruleCount ?? 0} 规则 · ${r.individualCount ?? 0} 个体`}>
                              <div style={{
                                fontSize: 12, color: '#666',
                                display: '-webkit-box',
                                WebkitLineClamp: 2,
                                WebkitBoxOrient: 'vertical',
                                overflow: 'hidden',
                                lineHeight: '20px',
                                maxHeight: 40,
                              }}>
                                {r.classCount || 0}类 · {r.objectPropertyCount ?? 0}对象 · {r.dataPropertyCount ?? 0}数据 · {r.ruleCount ?? 0}规则 · {r.individualCount ?? 0}个体
                              </div>
                            </Tooltip>
                          ),
                        },
                        {
                          title: '生成时间',
                          render: (_: any, r: OntologyVersion) => {
                            if (r.ttlGeneratedAt) {
                              const formatted = r.ttlGeneratedAt.replace('T', ' ').substring(0, 19);
                              return (
                                <Tooltip title={formatted}>
                                  <span style={{ fontSize: 12, color: '#666' }}>
                                    {formatted}
                                  </span>
                                </Tooltip>
                              );
                            }
                            return <span style={{ fontSize: 12, color: '#bbb' }}>-</span>;
                          },
                        },
                        {
                          title: '源文件',
                          render: (_: any, r: OntologyVersion) => {
                            if (r.sourceMdFileName) {
                              const lineClampStyle = {
                                fontSize: 12,
                                display: '-webkit-box',
                                WebkitLineClamp: 2,
                                WebkitBoxOrient: 'vertical',
                                overflow: 'hidden',
                                lineHeight: '20px',
                                maxHeight: 40,
                                wordBreak: 'break-all' as const,
                              };
                              // MD文件：显示为下载链接
                              if (r.sourceMdFileId) {
                                return (
                                  <a
                                    style={lineClampStyle}
                                    onClick={e => e.stopPropagation()}
                                    href={`/ontomind/api/v1/file-uploads/${r.sourceMdFileId}/download`}
                                    download={r.sourceMdFileName}
                                  >
                                    {r.sourceMdFileName}
                                  </a>
                                );
                              }
                              // TTL文件：显示为纯文本文件名
                              return (
                                <span style={lineClampStyle}>
                                  {r.sourceMdFileName}
                                </span>
                              );
                            }
                            return <span style={{ fontSize: 12, color: '#bbb' }}>-</span>;
                          },
                        },
                        {
                          title: '关联大模型',
                          render: (_: any, r: OntologyVersion) => (
                            <span style={{
                              fontSize: 12,
                              color: r.sourceModelName ? '#666' : '#bbb',
                              display: '-webkit-box',
                              WebkitLineClamp: 2,
                              WebkitBoxOrient: 'vertical',
                              overflow: 'hidden',
                              lineHeight: '20px',
                              maxHeight: 40,
                              wordBreak: 'break-all',
                            }}>
                              {r.sourceModelName || '-'}
                            </span>
                          ),
                        },
                        {
                          title: '操作',
                          render: (_: any, r: OntologyVersion) => (
                            <Space size={0} wrap>
                              <Tooltip title="查看 TTL"><Button size="small" type="text" icon={<CodeOutlined style={{ fontSize: 12 }} />} onClick={e => { e.stopPropagation(); handleViewTtl(r.id); }} /></Tooltip>
                              <Tooltip title="编辑 TTL"><Button size="small" type="text" icon={<EditOutlined style={{ fontSize: 12 }} />} onClick={e => { e.stopPropagation(); handleEditTtl(r.id); }} /></Tooltip>
                              <Tooltip title="导出 TTL"><Button size="small" type="text" icon={<ExportOutlined style={{ fontSize: 12 }} />} onClick={e => { e.stopPropagation(); handleExportTtl(r.id, r.name, r.versionName, r.version); }} /></Tooltip>
                              <Tooltip title="校验 & 推理"><Button size="small" type="text" style={{ color: '#fa8c16' }} icon={<SafetyCertificateOutlined style={{ fontSize: 12 }} />} onClick={e => { e.stopPropagation(); handleOpenValidate(r); }} /></Tooltip>
                              <Tooltip title="重命名"><Button size="small" type="text" style={{ fontSize: 11, color: '#666' }} onClick={e => { e.stopPropagation(); handleOpenRename(r); }}>重命名</Button></Tooltip>
                              <Popconfirm title="确认删除此版本？" onConfirm={e => { e?.stopPropagation(); handleDelete(r); }}>
                                <Button size="small" type="text" danger icon={<DeleteOutlined style={{ fontSize: 12 }} />} onClick={e => e.stopPropagation()} />
                              </Popconfirm>
                            </Space>
                          ),
                        },
                      ]}
                    />
                  </div>
                );
              })}
            </div>
          )}
            </>
          )}
        </Card>

        {/* 拖拽分隔条 */}
        <div
          onMouseDown={handlePanelMouseDown}
          style={{
            width: 6, flexShrink: 0, cursor: 'col-resize',
            background: leftDragging ? '#1677ff' : '#f0f0f0',
            transition: leftDragging ? 'none' : 'background 0.2s',
            borderLeft: '1px solid #e8e8e8', borderRight: '1px solid #e8e8e8',
            userSelect: 'none', alignSelf: 'stretch',
          }}
          onMouseEnter={(e) => { if (!leftDragging) (e.target as HTMLElement).style.background = '#d9d9d9'; }}
          onMouseLeave={(e) => { if (!leftDragging) (e.target as HTMLElement).style.background = '#f0f0f0'; }}
        />

        {/* 右侧：本体可视化 */}
        <Card
          title={
            <Space>
              <ApartmentOutlined />
              <span>本体模型可视化</span>
              {selectedVersion && (
                <>
                  <Tag color="blue">{selectedVersion.name}</Tag>
                  {selectedVersion.versionName && <Tag>{selectedVersion.versionName}</Tag>}
                </>
              )}
            </Space>
          }
          extra={
            browseClasses.length > 0 ? (
              <Segmented
                size="small"
                value={browseViewMode}
                onChange={(v) => setBrowseViewMode(v as 'graph' | 'mindmap')}
                options={[
                  { label: '本体视图', value: 'graph' },
                  { label: '思维导图', value: 'mindmap' },
                ]}
              />
            ) : undefined
          }
          size="small"
          style={{ flex: 1, paddingLeft: 8 }}
          styles={{ body: { padding: 12, position: 'relative' } }}
        >
          {!selectedVersionId ? (
            <div style={{
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              height: '100%',
              minHeight: 520,
            }}>
              <Empty
                description={
                  <span>
                    请从左侧选择一个本体模型版本<br />
                    <Text type="secondary" style={{ fontSize: 12 }}>或导入 Markdown 文件提取新的本体模型</Text>
                  </span>
                }
              >
                <Space>
                  <UnorderedListOutlined style={{ fontSize: 40, color: '#d9d9d9' }} />
                </Space>
              </Empty>
            </div>
          ) : graphLoading ? (
            <div style={{ textAlign: 'center', padding: 80 }}><Spin tip="加载本体数据..." size="large"><div style={{ padding: 20 }}>加载本体数据...</div></Spin></div>
          ) : browseClasses.length === 0 ? (
            <Empty description="该版本暂无本体数据" style={{ marginTop: 60 }} />
          ) : (
            <>
              <div style={{ position: 'relative' }}>
                {/* 图例 */}
                <div style={{
                  position: 'absolute', top: 8, right: 8, zIndex: 10,
                  background: 'rgba(255,255,255,0.92)', borderRadius: 6,
                  padding: '6px 12px', fontSize: 12, display: 'flex', gap: 14, alignItems: 'center',
                  boxShadow: '0 1px 4px rgba(0,0,0,0.1)',
                }}>
                  <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
                    <svg width="14" height="14"><circle cx="7" cy="7" r="6" fill="#fff" stroke="#1677ff" strokeWidth="2" /></svg>
                    <span style={{ color: '#555' }}>对象</span>
                  </span>
                  <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
                    <svg width="22" height="14"><line x1="2" y1="7" x2="20" y2="7" stroke="#666" strokeWidth="1.5" /><polygon points="18,4 22,7 18,10" fill="#666" /></svg>
                    <span style={{ color: '#555' }}>对象关系</span>
                  </span>
                  <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
                    <svg width="22" height="14"><line x1="2" y1="7" x2="20" y2="7" stroke="#888" strokeWidth="1.2" strokeDasharray="4,3" /></svg>
                    <span style={{ color: '#555' }}>继承</span>
                  </span>
                </div>
                <div
                  style={{
                    width: '100%',
                    height: 600,
                    border: '1px solid #f0f0f0',
                    borderRadius: 8,
                    background: 'linear-gradient(145deg, #f8f9fb 0%, #eef1f5 50%, #e8ecf1 100%)',
                    position: 'relative',
                    overflow: 'auto',
                  }}
                >
                  <div
                    ref={graphContainerRef}
                    id="ontology-graph-container-inner"
                    style={{
                      width: '100%',
                      height: '100%',
                    }}
                  />
                </div>
              </div>
              <div style={{ marginTop: 10, display: 'flex', gap: 24, color: '#666', fontSize: 12, alignItems: 'center' }}>
                <Text type="secondary">
                  {selectedVersion?.classCount || 0} 类 · {selectedVersion?.objectPropertyCount ?? 0} 对象属性 · {selectedVersion?.dataPropertyCount ?? 0} 数据属性 · {selectedVersion?.ruleCount ?? 0} 规则 · {selectedVersion?.individualCount ?? 0} 个体
                </Text>
                {selectedVersion?.versionName && <Text type="secondary">版本: {selectedVersion.versionName}</Text>}
                <Text type="secondary" style={{ fontStyle: 'italic', color: '#999' }}>
                  {browseViewMode === 'mindmap' ? '思维导图' : (browseClasses.some((c: any) => c.parentIri) ? '树形布局(继承)' : '力导向布局')}
                </Text>
              </div>
            </>
          )}
        </Card>
      </div>

      {/* TTL 校验 & 推理验证 Modal */}
      <Modal
        open={validateModalVisible}
        title={
          <Space>
            <SafetyCertificateOutlined />
            <span>TTL 校验 & 推理验证</span>
            {validateTarget && (
              <Tag color="blue">{validateTarget.name} {validateTarget.versionName}</Tag>
            )}
          </Space>
        }
        width="85%"
        onCancel={() => setValidateModalVisible(false)}
        footer={[
          <Button key="close" onClick={() => setValidateModalVisible(false)}>关闭</Button>,
        ]}
      >
        {validateTarget && (
          <Tabs
            activeKey={validateActiveTab}
            onChange={(key) => {
              setValidateActiveTab(key);
              if (key === 'protege') {
                setProtegeActiveTab('graph');
                loadProtegeData();
              }
            }}
            items={[
              {
                key: 'validate',
                label: (
                  <span>
                    <SafetyCertificateOutlined />
                    五层校验
                  </span>
                ),
                children: (
                  <div>
                    <div style={{ marginBottom: 16 }}>
                      <Alert
                        type="info"
                        showIcon
                        message="基于 OntologyConsistencyChecker 进行五层校验：基础结构、逻辑一致性、HermiT语义推理、IRI唯一性、循环继承检测"
                        style={{ marginBottom: 12 }}
                      />
                      <Button
                        type="primary"
                        icon={<SafetyCertificateOutlined />}
                        loading={validateLoading}
                        onClick={handleRunValidate}
                      >
                        执行校验
                      </Button>
                    </div>

                    {validateLoading && (
                      <div style={{ textAlign: 'center', padding: 40 }}>
                        <Spin size="large" tip="正在执行五层校验..." />
                      </div>
                    )}

                    {validateResult && !validateLoading && (
                      <div>
                        {/* 五层校验流程图 */}
                        <Steps
                          size="small"
                          current={Array.isArray(validateResult.layers) ? validateResult.layers.filter((l: any) => l.passed).length : (validateResult.valid ? 5 : -1)}
                          status={validateResult.valid ? 'finish' : 'error'}
                          items={[
                            { title: '基础结构', description: '名称、标签、IRI完整性', status: getLayerStatus(validateResult, 0) },
                            { title: '逻辑一致性', description: '定义域/值域有效性', status: getLayerStatus(validateResult, 1) },
                            { title: 'HermiT语义推理', description: 'OWL 2 DL 完整一致性检查', status: getLayerStatus(validateResult, 2) },
                            { title: 'IRI唯一性', description: '检测重复IRI', status: getLayerStatus(validateResult, 3) },
                            { title: '循环继承', description: '检测循环依赖', status: getLayerStatus(validateResult, 4) },
                          ]}
                          style={{ marginBottom: 16 }}
                        />

                        {/* 校验结果概览 */}
                        <Descriptions bordered size="small" column={2} style={{ marginBottom: 16 }}>
                          <Descriptions.Item label="本体名称">{validateResult.ontologyName}</Descriptions.Item>
                          <Descriptions.Item label="校验结果">
                            {validateResult.valid ? (
                              <Tag color="success" icon={<CheckCircleOutlined />}>通过</Tag>
                            ) : (
                              <Tag color="error" icon={<CloseCircleOutlined />}>未通过</Tag>
                            )}
                          </Descriptions.Item>
                          <Descriptions.Item label="检查时间">{validateResult.checkedAt ? new Date(validateResult.checkedAt).toLocaleString() : '-'}</Descriptions.Item>
                          <Descriptions.Item label="本体规模">{validateResult.classCount || 0} 类 / {validateResult.propertyCount || 0} 属性</Descriptions.Item>
                          <Descriptions.Item label="错误">{(validateResult.errors || []).length} 项</Descriptions.Item>
                          <Descriptions.Item label="警告">{(validateResult.warnings || []).length} 项</Descriptions.Item>
                        </Descriptions>

                        {/* 分层详细检查结果 */}
                        <div style={{ fontWeight: 600, marginBottom: 8, fontSize: 14 }}>各层检查详情</div>
                        {Array.isArray(validateResult.layers) && validateResult.layers.map((layer: any, layerIdx: number) => (
                          <Card
                            key={layerIdx}
                            size="small"
                            style={{ marginBottom: 12 }}
                            title={
                              <Space>
                                {layer.passed ? (
                                  <CheckCircleOutlined style={{ color: '#52c41a' }} />
                                ) : (
                                  <CloseCircleOutlined style={{ color: '#ff4d4f' }} />
                                )}
                                <span style={{ fontWeight: 600 }}>第{layerIdx + 1}层：{layer.name}</span>
                              </Space>
                            }
                            extra={
                              <Space>
                                {Array.isArray(layer.errors) && layer.errors.length > 0 && (
                                  <Tag color="error">{layer.errors.length} 错误</Tag>
                                )}
                                {Array.isArray(layer.warnings) && layer.warnings.length > 0 && (
                                  <Tag color="warning">{layer.warnings.length} 警告</Tag>
                                )}
                                {!layer.errors?.length && !layer.warnings?.length && (
                                  <Tag color="success">全部通过</Tag>
                                )}
                              </Space>
                            }
                          >
                            <div style={{ color: '#666', marginBottom: 8, fontSize: 13 }}>{layer.description}</div>

                            {/* 详细检查项 */}
                            {Array.isArray(layer.details) && layer.details.length > 0 && (
                              <div style={{ marginBottom: (layer.errors?.length || layer.warnings?.length) ? 12 : 0 }}>
                                <div style={{ fontSize: 12, color: '#999', marginBottom: 4, fontWeight: 600 }}>检查详情：</div>
                                {layer.details.map((detail: string, dIdx: number) => (
                                  <div key={dIdx} style={{
                                    padding: '3px 8px',
                                    marginBottom: 2,
                                    fontSize: 12,
                                    color: '#333',
                                    background: detail.includes('✗') || detail.includes('失败') ? '#fff2f0' : '#f6f8fa',
                                    borderRadius: 3,
                                    lineHeight: '22px',
                                  }}>
                                    {detail.includes('✓') ? <CheckCircleOutlined style={{ color: '#52c41a', marginRight: 6, fontSize: 11 }} /> : null}
                                    {detail.includes('✗') ? <CloseCircleOutlined style={{ color: '#ff4d4f', marginRight: 6, fontSize: 11 }} /> : null}
                                    {!detail.includes('✓') && !detail.includes('✗') ? <span style={{ color: '#1890ff', marginRight: 6 }}>•</span> : null}
                                    {detail}
                                  </div>
                                ))}
                              </div>
                            )}

                            {/* 本层错误 */}
                            {Array.isArray(layer.errors) && layer.errors.length > 0 && (
                              <div style={{ marginBottom: 8 }}>
                                <div style={{ fontSize: 12, color: '#999', marginBottom: 4, fontWeight: 600 }}>错误：</div>
                                {layer.errors.map((err: string, eIdx: number) => (
                                  <div key={eIdx} style={{
                                    padding: '5px 10px',
                                    marginBottom: 3,
                                    background: '#fff2f0',
                                    border: '1px solid #ffccc7',
                                    borderRadius: 4,
                                    fontSize: 12,
                                    color: '#cf1322',
                                  }}>
                                    <CloseCircleOutlined style={{ marginRight: 6 }} />{err}
                                  </div>
                                ))}
                              </div>
                            )}

                            {/* 本层警告 */}
                            {Array.isArray(layer.warnings) && layer.warnings.length > 0 && (
                              <div>
                                <div style={{ fontSize: 12, color: '#999', marginBottom: 4, fontWeight: 600 }}>警告：</div>
                                {layer.warnings.map((warn: string, wIdx: number) => (
                                  <div key={wIdx} style={{
                                    padding: '5px 10px',
                                    marginBottom: 3,
                                    background: '#fff7e6',
                                    border: '1px solid #ffe58f',
                                    borderRadius: 4,
                                    fontSize: 12,
                                    color: '#ad6800',
                                  }}>
                                    <WarningOutlined style={{ marginRight: 6 }} />{warn}
                                  </div>
                                ))}
                              </div>
                            )}
                          </Card>
                        ))}

                        {/* 汇总 */}
                        {validateResult.valid && (!validateResult.errors || validateResult.errors.length === 0) && (!validateResult.warnings || validateResult.warnings.length === 0) && (
                          <Alert type="success" showIcon message="TTL 校验通过，本体结构完整、逻辑一致。" />
                        )}
                        {!validateResult.valid && Array.isArray(validateResult.errors) && validateResult.errors.length > 0 && (
                          <div>
                            <Alert type="error" showIcon
                              message={`校验未通过，共 ${validateResult.errors.length} 个错误需要修复。`}
                              style={{ marginBottom: 12 }} />
                            <Card size="small" title={<span><CloseCircleOutlined style={{ color: '#ff4d4f', marginRight: 6 }} />错误清单与修复建议</span>}
                              extra={
                                <Button
                                  type="primary"
                                  icon={<ToolOutlined />}
                                  onClick={() => {
                                    setSelectedFixIndices(validateResult.errors.map((_: any, i: number) => i));
                                    setSelectedWarningIndices([]);
                                    setAutoFixModalVisible(true);
                                  }}
                                >
                                  自动修复
                                </Button>
                              }
                              style={{ marginBottom: 12 }}>
                              <List
                                size="small"
                                dataSource={validateResult.errors}
                                renderItem={(err: string, idx: number) => {
                                  const parts = err.split('→');
                                  return (
                                    <List.Item style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
                                      <div style={{ width: '100%' }}>
                                        <div style={{ display: 'flex', alignItems: 'flex-start', gap: 8 }}>
                                          <Tag color="error" style={{ flexShrink: 0, marginTop: 2 }}>#{idx + 1}</Tag>
                                          <div style={{ flex: 1 }}>
                                            <div style={{ color: '#cf1322', fontWeight: 500, fontSize: 13, marginBottom: parts.length > 1 ? 4 : 0 }}>
                                              {parts[0].trim()}
                                            </div>
                                            {parts.length > 1 && (
                                              <div style={{
                                                background: '#f6ffed',
                                                border: '1px solid #b7eb8f',
                                                borderRadius: 4,
                                                padding: '4px 10px',
                                                fontSize: 12,
                                                color: '#389e0d',
                                              }}>
                                                修复建议: {parts.slice(1).join('→').trim()}
                                              </div>
                                            )}
                                          </div>
                                        </div>
                                      </div>
                                    </List.Item>
                                  );
                                }}
                              />
                            </Card>
                          </div>
                        )}

                        {/* 警告清单与修复建议 */}
                        {Array.isArray(validateResult.warnings) && validateResult.warnings.length > 0 && (
                          <div style={{ marginTop: 12 }}>
                            <Alert type="warning" showIcon
                              message={`共 ${validateResult.warnings.length} 个警告，建议处理以优化本体结构。`}
                              style={{ marginBottom: 12 }} />
                            <Card size="small" title={<span><WarningOutlined style={{ color: '#faad14', marginRight: 6 }} />警告清单与修复建议</span>}
                              extra={
                                <Button
                                  type="primary"
                                  ghost
                                  icon={<ToolOutlined />}
                                  onClick={() => {
                                    setSelectedFixIndices([]);
                                    setSelectedWarningIndices(validateResult.warnings.map((_: any, i: number) => i));
                                    setAutoFixModalVisible(true);
                                  }}
                                >
                                  处理警告
                                </Button>
                              }
                              style={{ marginBottom: 12 }}>
                              <List
                                size="small"
                                dataSource={validateResult.warnings}
                                renderItem={(warn: string, idx: number) => {
                                  const parts = warn.split('→');
                                  return (
                                    <List.Item style={{ padding: '8px 12px', borderBottom: '1px solid #f0f0f0' }}>
                                      <div style={{ width: '100%' }}>
                                        <div style={{ display: 'flex', alignItems: 'flex-start', gap: 8 }}>
                                          <Tag color="warning" style={{ flexShrink: 0, marginTop: 2 }}>#{idx + 1}</Tag>
                                          <div style={{ flex: 1 }}>
                                            <div style={{ color: '#ad6800', fontWeight: 500, fontSize: 13, marginBottom: parts.length > 1 ? 4 : 0 }}>
                                              {parts[0].trim()}
                                            </div>
                                            {parts.length > 1 && (
                                              <div style={{
                                                background: '#fffbe6',
                                                border: '1px solid #ffe58f',
                                                borderRadius: 4,
                                                padding: '4px 10px',
                                                fontSize: 12,
                                                color: '#d48806',
                                              }}>
                                                修复建议: {parts.slice(1).join('→').trim()}
                                              </div>
                                            )}
                                          </div>
                                        </div>
                                      </div>
                                    </List.Item>
                                  );
                                }}
                              />
                            </Card>
                          </div>
                        )}

                        {/* 自动修复 Modal */}
                        <Modal
                          title={<span><ToolOutlined style={{ marginRight: 8 }} />自动修复 - 选择要修复的项目</span>}
                          open={autoFixModalVisible}
                          onCancel={() => setAutoFixModalVisible(false)}
                          onOk={async () => {
                            if (selectedFixIndices.length === 0 && selectedWarningIndices.length === 0) {
                              message.warning('请至少选择一个要修复的项目');
                              return;
                            }
                            if (!validateTarget) return;
                            setAutoFixLoading(true);
                            try {
                              const result = await autoFixOntology(validateTarget.id, selectedFixIndices, selectedWarningIndices);
                              if (result.fixed) {
                                message.success(`自动修复完成！成功修复 ${result.fixCount} 项，跳过 ${result.skippedCount} 项`);
                                // 更新校验结果为修复后的结果
                                if (result.afterValidation) {
                                  setValidateResult(result.afterValidation);
                                }
                                if (result.fixDetails && result.fixDetails.length > 0) {
                                  Modal.success({
                                    title: '自动修复结果',
                                    width: 560,
                                    content: (
                                      <div>
                                        <p style={{ marginBottom: 8, color: '#52c41a', fontWeight: 600 }}>
                                          成功修复 {result.fixCount} 项：
                                        </p>
                                        <ul style={{ marginBottom: 12, paddingLeft: 20 }}>
                                          {result.fixDetails.map((d: string, i: number) => (
                                            <li key={i} style={{ fontSize: 13, marginBottom: 4, color: '#389e0d' }}>{d}</li>
                                          ))}
                                        </ul>
                                        {result.skippedCount > 0 && (
                                          <>
                                            {result.skippedErrors && result.skippedErrors.length > 0 && (
                                              <>
                                                <p style={{ marginBottom: 8, color: '#faad14', fontWeight: 600 }}>
                                                  跳过 {result.skippedErrors.length} 个错误（需手动修复）：
                                                </p>
                                                <ul style={{ paddingLeft: 20 }}>
                                                  {result.skippedErrors.map((e: string, i: number) => (
                                                    <li key={i} style={{ fontSize: 13, marginBottom: 4, color: '#cf1322' }}>{e}</li>
                                                  ))}
                                                </ul>
                                              </>
                                            )}
                                            {result.skippedWarnings && result.skippedWarnings.length > 0 && (
                                              <>
                                                <p style={{ marginBottom: 8, color: '#faad14', fontWeight: 600 }}>
                                                  跳过 {result.skippedWarnings.length} 个警告（需手动处理）：
                                                </p>
                                                <ul style={{ paddingLeft: 20 }}>
                                                  {result.skippedWarnings.map((w: string, i: number) => (
                                                    <li key={i} style={{ fontSize: 13, marginBottom: 4, color: '#ad6800' }}>{w}</li>
                                                  ))}
                                                </ul>
                                              </>
                                            )}
                                          </>
                                        )}
                                        {result.afterValidation && result.afterValidation.valid && (
                                          <Alert type="success" showIcon message="修复后重新校验通过，本体结构完整、逻辑一致。" style={{ marginTop: 12 }} />
                                        )}
                                        {result.afterValidation && !result.afterValidation.valid && (
                                          <Alert type="warning" showIcon
                                            message={`修复后仍有 ${result.afterValidation.errors?.length || 0} 个错误，建议再次尝试自动修复或手动处理。`}
                                            style={{ marginTop: 12 }} />
                                        )}
                                      </div>
                                    ),
                                  });
                                }
                                setAutoFixModalVisible(false);
                              } else {
                                message.info(result.message || '没有需要修复的内容');
                              }
                            } catch (e: any) {
                              message.error('自动修复失败: ' + (e.message || '未知错误'));
                            } finally {
                              setAutoFixLoading(false);
                            }
                          }}
                          confirmLoading={autoFixLoading}
                          okText="执行修复"
                          cancelText="取消"
                          width={720}
                        >
                          {/* 错误选择区域 */}
                          {validateResult?.errors && validateResult.errors.length > 0 && (
                            <div style={{ marginBottom: 16 }}>
                              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
                                <span style={{ fontSize: 13, fontWeight: 600, color: '#cf1322' }}>
                                  <CloseCircleOutlined style={{ marginRight: 4 }} />
                                  错误 ({validateResult.errors.length} 项)，已选 <b>{selectedFixIndices.length}</b> 项
                                </span>
                                <Space size={8}>
                                  <Button size="small" onClick={() => setSelectedFixIndices(validateResult?.errors?.map((_: any, i: number) => i) || [])}>全选</Button>
                                  <Button size="small" onClick={() => setSelectedFixIndices([])}>清空</Button>
                                </Space>
                              </div>
                              <div style={{ maxHeight: 200, overflowY: 'auto', border: '1px solid #ffccc7', borderRadius: 6, padding: 8 }}>
                                <Checkbox.Group
                                  value={selectedFixIndices}
                                  onChange={(vals) => setSelectedFixIndices(vals as number[])}
                                  style={{ width: '100%' }}
                                >
                                  {validateResult.errors.map((err: string, idx: number) => {
                                    const parts = err.split('→');
                                    return (
                                      <div key={idx} style={{
                                        padding: '6px 10px',
                                        marginBottom: 4,
                                        border: selectedFixIndices.includes(idx) ? '1px solid #1677ff' : '1px solid #f0f0f0',
                                        borderRadius: 4,
                                        background: selectedFixIndices.includes(idx) ? '#f0f5ff' : '#fff',
                                        transition: 'all 0.2s',
                                      }}>
                                        <Checkbox value={idx} style={{ width: '100%' }}>
                                          <div style={{ display: 'inline-block', verticalAlign: 'top', marginLeft: 8 }}>
                                            <div style={{ color: '#cf1322', fontWeight: 500, fontSize: 12 }}>
                                              <Tag color="error" style={{ marginRight: 4, fontSize: 11 }}>#{idx + 1}</Tag>
                                              {parts[0].trim()}
                                            </div>
                                            {parts.length > 1 && (
                                              <div style={{ fontSize: 11, color: '#389e0d', marginTop: 2 }}>
                                                修复建议: {parts.slice(1).join('→').trim()}
                                              </div>
                                            )}
                                          </div>
                                        </Checkbox>
                                      </div>
                                    );
                                  })}
                                </Checkbox.Group>
                              </div>
                            </div>
                          )}

                          {/* 警告选择区域 */}
                          {validateResult?.warnings && validateResult.warnings.length > 0 && (
                            <div>
                              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
                                <span style={{ fontSize: 13, fontWeight: 600, color: '#ad6800' }}>
                                  <WarningOutlined style={{ marginRight: 4 }} />
                                  警告 ({validateResult.warnings.length} 项)，已选 <b>{selectedWarningIndices.length}</b> 项
                                </span>
                                <Space size={8}>
                                  <Button size="small" onClick={() => setSelectedWarningIndices(validateResult?.warnings?.map((_: any, i: number) => i) || [])}>全选</Button>
                                  <Button size="small" onClick={() => setSelectedWarningIndices([])}>清空</Button>
                                </Space>
                              </div>
                              <div style={{ maxHeight: 200, overflowY: 'auto', border: '1px solid #ffe58f', borderRadius: 6, padding: 8 }}>
                                <Checkbox.Group
                                  value={selectedWarningIndices}
                                  onChange={(vals) => setSelectedWarningIndices(vals as number[])}
                                  style={{ width: '100%' }}
                                >
                                  {validateResult.warnings.map((warn: string, idx: number) => {
                                    const parts = warn.split('→');
                                    return (
                                      <div key={idx} style={{
                                        padding: '6px 10px',
                                        marginBottom: 4,
                                        border: selectedWarningIndices.includes(idx) ? '1px solid #faad14' : '1px solid #f0f0f0',
                                        borderRadius: 4,
                                        background: selectedWarningIndices.includes(idx) ? '#fffbe6' : '#fff',
                                        transition: 'all 0.2s',
                                      }}>
                                        <Checkbox value={idx} style={{ width: '100%' }}>
                                          <div style={{ display: 'inline-block', verticalAlign: 'top', marginLeft: 8 }}>
                                            <div style={{ color: '#ad6800', fontWeight: 500, fontSize: 12 }}>
                                              <Tag color="warning" style={{ marginRight: 4, fontSize: 11 }}>#{idx + 1}</Tag>
                                              {parts[0].trim()}
                                            </div>
                                            {parts.length > 1 && (
                                              <div style={{ fontSize: 11, color: '#d48806', marginTop: 2 }}>
                                                修复建议: {parts.slice(1).join('→').trim()}
                                              </div>
                                            )}
                                          </div>
                                        </Checkbox>
                                      </div>
                                    );
                                  })}
                                </Checkbox.Group>
                              </div>
                            </div>
                          )}
                        </Modal>
                      </div>
                    )}
                  </div>
                ),
              },
              {
                key: 'hermit',
                label: (
                  <span>
                    <NodeIndexOutlined />
                    HermiT 推理验证
                  </span>
                ),
                children: (
                  <div>
                    <Alert
                      type="info"
                      showIcon
                      message="使用 HermiT 推理器执行 OWL 2 DL 完整语义推理：一致性检查、分类推断、发现隐含关系"
                      style={{ marginBottom: 12 }}
                    />
                    <Space style={{ marginBottom: 16 }}>
                      <Button
                        type="primary"
                        icon={<NodeIndexOutlined />}
                        loading={hermitLoading}
                        onClick={handleHermitReason}
                      >
                        执行 HermiT 推理
                      </Button>
                    </Space>

                    {hermitLoading && (
                      <div style={{ textAlign: 'center', padding: 20 }}><Spin tip="HermiT 推理中，可能需要数秒..."><div style={{ padding: 20 }}>HermiT 推理中，可能需要数秒...</div></Spin></div>
                    )}

                    {hermitResult && !hermitLoading && (
                      <div>
                        {hermitResult.error ? (
                          <Alert type="error" showIcon message="推理失败" description={hermitResult.message} />
                        ) : (
                          <>
                            {/* 推理概览 */}
                            <Descriptions size="small" bordered column={4} style={{ marginBottom: 16 }}>
                              <Descriptions.Item label="一致性">{hermitResult.consistent ? <Tag color="success">一致</Tag> : <Tag color="error">不一致</Tag>}</Descriptions.Item>
                              <Descriptions.Item label="推理器">{String(hermitResult.reasonerName ?? '-')} {String(hermitResult.reasonerVersion ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="推理耗时">{String(hermitResult.preparationTimeMs ?? '-')}ms</Descriptions.Item>
                              <Descriptions.Item label="公理总数">{String(hermitResult.totalAxioms ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="类总数">{String(hermitResult.totalClasses ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="对象属性">{String(hermitResult.totalObjectProperties ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="数据属性">{String(hermitResult.totalDatatypeProperties ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="个体总数">{String(hermitResult.totalIndividuals ?? 0)}</Descriptions.Item>
                            </Descriptions>

                            {/* ========== 能力1: 本体一致性检测 ========== */}
                            <Card size="small" title={<Space><SafetyCertificateOutlined style={{ color: '#f5222d' }} /><span>能力1：本体一致性检测</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>检测本体中是否存在逻辑矛盾，如不可满足类、互斥冲突等</div>
                              {Array.isArray(hermitResult.inconsistencies) && hermitResult.inconsistencies.length > 0 ? (
                                hermitResult.inconsistencies.map((item: any, idx: number) => (
                                  <Alert key={idx} type="error" showIcon message={String(item)} style={{ marginBottom: 4 }} />
                                ))
                              ) : (
                                <Alert type="success" showIcon message="本体一致，未检测到逻辑矛盾" />
                              )}
                              {Array.isArray(hermitResult.unsatisfiableClasses) && hermitResult.unsatisfiableClasses.length > 0 && (
                                <div style={{ marginTop: 8 }}>
                                  <Text type="danger" strong>不可满足类（等同于 owl:Nothing）：</Text>
                                  <ul style={{ margin: '4px 0 0', paddingLeft: 20 }}>
                                    {hermitResult.unsatisfiableClasses.map((cls: any, idx: number) => (
                                      <li key={idx}><Text code>{String(cls)}</Text></li>
                                    ))}
                                  </ul>
                                </div>
                              )}
                              {/* 等价类 */}
                              {hermitResult.equivalentClasses && typeof hermitResult.equivalentClasses === 'object' && Object.keys(hermitResult.equivalentClasses).length > 0 && (
                                <div style={{ marginTop: 8 }}>
                                  <Text strong>推断等价类：</Text>
                                  {Object.entries(hermitResult.equivalentClasses).map(([cls, equivs]: [string, any], idx: number) => (
                                    <div key={idx} style={{ padding: '2px 8px', fontSize: 12, color: '#1890ff' }}>
                                      <Tag>{cls}</Tag> 等价于 <Tag color="blue">{Array.isArray(equivs) ? equivs.join('、') : String(equivs)}</Tag>
                                    </div>
                                  ))}
                                </div>
                              )}
                              {/* 互斥类 */}
                              {hermitResult.disjointClasses && typeof hermitResult.disjointClasses === 'object' && Object.keys(hermitResult.disjointClasses).length > 0 && (
                                <div style={{ marginTop: 8 }}>
                                  <Text strong style={{ color: '#fa8c16' }}>互斥类关系：</Text>
                                  {Object.entries(hermitResult.disjointClasses).map(([cls, disjoints]: [string, any], idx: number) => (
                                    <div key={idx} style={{ padding: '2px 8px', fontSize: 12, color: '#fa8c16' }}>
                                      <Tag>{cls}</Tag> 互斥于 <Tag color="orange">{Array.isArray(disjoints) ? disjoints.join('、') : String(disjoints)}</Tag>
                                    </div>
                                  ))}
                                </div>
                              )}
                            </Card>

                            {/* ========== 能力2: 类层级关系推理 ========== */}
                            <Card size="small" title={<Space><ApartmentOutlined style={{ color: '#722ed1' }} /><span>能力2：类层级关系推理</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>自动推断并完善概念之间的继承关系，发现隐含的父类和子类</div>
                              {/* 推断子类（已有） */}
                              {hermitResult.inferredHierarchy && typeof hermitResult.inferredHierarchy === 'object' && Object.keys(hermitResult.inferredHierarchy).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>推断子类层次：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(hermitResult.inferredHierarchy).map(([parent, children]: [string, any], idx: number) => ({
                                      key: idx, parent, inferredChildren: Array.isArray(children) ? children.join('、') : String(children ?? ''),
                                    }))}
                                    columns={[
                                      { title: '父类', dataIndex: 'parent', key: 'parent', width: 200 },
                                      { title: '推断子类', dataIndex: 'inferredChildren', key: 'inferredChildren' },
                                    ]}
                                  />
                                </div>
                              ) : (
                                <div style={{ marginBottom: 8 }}><Empty description="无推断的子类层次" image={Empty.PRESENTED_IMAGE_SIMPLE} /></div>
                              )}
                              {/* 推断超类（新增） */}
                              {hermitResult.inferredSuperClasses && typeof hermitResult.inferredSuperClasses === 'object' && Object.keys(hermitResult.inferredSuperClasses).length > 0 ? (
                                <div>
                                  <Text strong>推断超类层次（隐含父类）：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(hermitResult.inferredSuperClasses).map(([cls, supers]: [string, any], idx: number) => ({
                                      key: idx, className: cls, superClassNames: Array.isArray(supers) ? supers.join('、') : String(supers ?? ''),
                                    }))}
                                    columns={[
                                      { title: '类', dataIndex: 'className', key: 'className', width: 200 },
                                      { title: '推断超类', dataIndex: 'superClassNames', key: 'superClassNames' },
                                    ]}
                                  />
                                </div>
                              ) : null}
                            </Card>

                            {/* ========== 能力3: 实例归属判断 ========== */}
                            <Card size="small" title={<Space><NodeIndexOutlined style={{ color: '#13c2c2' }} /><span>能力3：实例归属判断</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>判断个体是否属于特定概念，自动补全隐含的类型归属</div>
                              {(hermitResult.totalIndividuals ?? 0) === 0 ? (
                                <Empty description="当前本体未定义任何个体（Named Individual），如需实例推理请在 TTL 中声明个体" image={Empty.PRESENTED_IMAGE_SIMPLE} />
                              ) : (
                                <>
                                  {hermitResult.inferredIndividualTypes && typeof hermitResult.inferredIndividualTypes === 'object' && Object.keys(hermitResult.inferredIndividualTypes).length > 0 ? (
                                    <div style={{ marginBottom: 8 }}>
                                      <Text strong>个体类型归属推断：</Text>
                                      <Table
                                        size="small" bordered pagination={{ defaultPageSize: 5 }}
                                        dataSource={Object.entries(hermitResult.inferredIndividualTypes).map(([individual, types]: [string, any], idx: number) => ({
                                          key: idx, individual, typeNames: Array.isArray(types) ? types.join('、') : String(types ?? ''),
                                        }))}
                                        columns={[
                                          { title: '个体', dataIndex: 'individual', key: 'individual', width: 200 },
                                          { title: '推断归属类型', dataIndex: 'typeNames', key: 'typeNames' },
                                        ]}
                                      />
                                    </div>
                                  ) : null}
                                  {hermitResult.classInstances && typeof hermitResult.classInstances === 'object' && Object.keys(hermitResult.classInstances).length > 0 ? (
                                    <div>
                                      <Text strong>各类实例分布：</Text>
                                      <Table
                                        size="small" bordered pagination={{ defaultPageSize: 5 }}
                                        dataSource={Object.entries(hermitResult.classInstances).map(([cls, instances]: [string, any], idx: number) => ({
                                          key: idx, className: cls, instanceNames: Array.isArray(instances) ? instances.join('、') : String(instances ?? ''),
                                        }))}
                                        columns={[
                                          { title: '类', dataIndex: 'className', key: 'className', width: 200 },
                                          { title: '包含实例', dataIndex: 'instanceNames', key: 'instanceNames' },
                                        ]}
                                      />
                                    </div>
                                  ) : null}
                                </>
                              )}
                            </Card>

                            {/* ========== 能力4: 属性与关系推导 ========== */}
                            <Card size="small" title={<Space><LinkOutlined style={{ color: '#eb2f96' }} /><span>能力4：属性与关系推导</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>推导属性特征（传递性、对称性等）、逆属性关系、等价属性</div>
                              {/* 属性特征 */}
                              {hermitResult.propertyCharacteristics && typeof hermitResult.propertyCharacteristics === 'object' && Object.keys(hermitResult.propertyCharacteristics).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>属性特征推导：</Text>
                                  {Object.entries(hermitResult.propertyCharacteristics).map(([prop, chars]: [string, any], idx: number) => (
                                    <div key={idx} style={{ padding: '2px 8px', fontSize: 12 }}>
                                      <Tag color="magenta">{prop}</Tag>
                                      {Array.isArray(chars) ? chars.map((c: string, ci: number) => (
                                        <Tag key={ci} style={{ fontSize: 11 }}>{c}</Tag>
                                      )) : <Tag style={{ fontSize: 11 }}>{String(chars)}</Tag>}
                                    </div>
                                  ))}
                                </div>
                              ) : (
                                <div style={{ marginBottom: 8 }}><Text type="secondary" style={{ fontSize: 12 }}>未推断出额外的属性特征</Text></div>
                              )}
                              {/* 逆属性 */}
                              {hermitResult.inverseProperties && typeof hermitResult.inverseProperties === 'object' && Object.keys(hermitResult.inverseProperties).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>逆属性关系：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(hermitResult.inverseProperties).map(([prop, inverse]: [string, any], idx: number) => ({
                                      key: idx, property: prop, inverseProperty: String(inverse ?? ''),
                                    }))}
                                    columns={[
                                      { title: '属性', dataIndex: 'property', key: 'property', width: 200 },
                                      { title: '逆属性', dataIndex: 'inverseProperty', key: 'inverseProperty' },
                                    ]}
                                  />
                                </div>
                              ) : null}
                              {/* 等价属性 */}
                              {hermitResult.equivalentProperties && typeof hermitResult.equivalentProperties === 'object' && Object.keys(hermitResult.equivalentProperties).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>等价属性：</Text>
                                  {Object.entries(hermitResult.equivalentProperties).map(([prop, equivs]: [string, any], idx: number) => (
                                    <div key={idx} style={{ padding: '2px 8px', fontSize: 12 }}>
                                      <Tag color="magenta">{prop}</Tag> 等价于 <Tag color="volcano">{Array.isArray(equivs) ? equivs.join('、') : String(equivs)}</Tag>
                                    </div>
                                  ))}
                                </div>
                              ) : null}
                              {/* 隐含属性层次 */}
                              {hermitResult.inferredPropertyHierarchy && typeof hermitResult.inferredPropertyHierarchy === 'object' && Object.keys(hermitResult.inferredPropertyHierarchy).length > 0 ? (
                                <div>
                                  <Text strong>隐含属性层次：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    scroll={{ y: 300 }}
                                    dataSource={Object.entries(hermitResult.inferredPropertyHierarchy).map(([parent, children]: [string, any], idx: number) => ({
                                      key: idx, parent, inferredChildren: Array.isArray(children) ? children.join('、') : String(children ?? ''),
                                    }))}
                                    columns={[
                                      { title: '父属性', dataIndex: 'parent', key: 'parent', width: 200 },
                                      { title: '推断子属性', dataIndex: 'inferredChildren', key: 'inferredChildren' },
                                    ]}
                                  />
                                </div>
                              ) : (
                                <div><Empty description="无推断的属性层次关系" image={Empty.PRESENTED_IMAGE_SIMPLE} /></div>
                              )}
                            </Card>

                            {/* ========== 能力5: 数据属性推导 ========== */}
                            <Card size="small" title={<Space><DatabaseOutlined style={{ color: '#52c41a' }} /><span>能力5：数据属性推导</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>推导数据属性层次关系和数据属性所属类</div>
                              {hermitResult.inferredDataPropertyHierarchy && typeof hermitResult.inferredDataPropertyHierarchy === 'object' && Object.keys(hermitResult.inferredDataPropertyHierarchy).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>数据属性层次：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(hermitResult.inferredDataPropertyHierarchy).map(([parent, children]: [string, any], idx: number) => ({
                                      key: idx, parent, inferredChildren: Array.isArray(children) ? children.join('、') : String(children ?? ''),
                                    }))}
                                    columns={[
                                      { title: '父数据属性', dataIndex: 'parent', key: 'parent', width: 200 },
                                      { title: '推断子数据属性', dataIndex: 'inferredChildren', key: 'inferredChildren' },
                                    ]}
                                  />
                                </div>
                              ) : (
                                <div style={{ marginBottom: 8 }}><Text type="secondary" style={{ fontSize: 12 }}>未推断出数据属性层次关系</Text></div>
                              )}
                              {hermitResult.dataPropertyDomains && typeof hermitResult.dataPropertyDomains === 'object' && Object.keys(hermitResult.dataPropertyDomains).length > 0 ? (
                                <div>
                                  <Text strong>数据属性定义域：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(hermitResult.dataPropertyDomains).map(([dp, domains]: [string, any], idx: number) => ({
                                      key: idx, dataProperty: dp, domainClasses: Array.isArray(domains) ? domains.join('、') : String(domains ?? ''),
                                    }))}
                                    columns={[
                                      { title: '数据属性', dataIndex: 'dataProperty', key: 'dataProperty', width: 200 },
                                      { title: '定义域类', dataIndex: 'domainClasses', key: 'domainClasses' },
                                    ]}
                                  />
                                </div>
                              ) : null}
                            </Card>

                            {/* ========== 能力6: SWRL 规则推导 ========== */}
                            <Card size="small" title={<Space><ThunderboltOutlined style={{ color: '#722ed1' }} /><span>能力6：SWRL 规则推导</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>检查本体中的 SWRL 规则定义和推导结果</div>
                              {hermitResult.swrlRuleResults && Array.isArray(hermitResult.swrlRuleResults) && hermitResult.swrlRuleResults.length > 0 ? (
                                hermitResult.swrlRuleResults.map((item: any, idx: number) => (
                                  <Alert key={idx} type={String(item).includes('未定义') ? 'warning' : 'info'} showIcon message={String(item)} style={{ marginBottom: 4 }} />
                                ))
                              ) : (
                                <Alert type="warning" showIcon message="当前本体未定义 SWRL 规则，如需规则推理请在 TTL 中声明 SWRL 规则" />
                              )}
                            </Card>
                          </>
                        )}
                      </div>
                    )}
                  </div>
                ),
              },
              {
                key: 'pellet',
                label: (
                  <span>
                    <ExperimentOutlined />
                    Pellet 推理验证
                  </span>
                ),
                children: (
                  <div>
                    <Alert
                      type="info"
                      showIcon
                      message="使用 Pellet OWL 2 DL 推理器进行完整语义推理：一致性检查、分类、发现隐含关系"
                      style={{ marginBottom: 12 }}
                    />

                    <Space style={{ marginBottom: 16 }}>
                      <Button
                        type="primary"
                        icon={<ExperimentOutlined />}
                        loading={pelletLoading}
                        onClick={handlePelletReason}
                      >
                        执行 Pellet 推理
                      </Button>
                    </Space>

                    {pelletLoading && (
                      <div style={{ textAlign: 'center', padding: 20 }}><Spin tip="Pellet 推理中，可能需要数秒..."><div style={{ padding: 20 }}>Pellet 推理中，可能需要数秒...</div></Spin></div>
                    )}

                    {pelletResult && !pelletLoading && (
                      <div>
                        {pelletResult.error ? (
                          <Alert type="error" showIcon message="推理失败" description={pelletResult.message} />
                        ) : (
                          <>
                            <Descriptions size="small" bordered column={4} style={{ marginBottom: 16 }}>
                              <Descriptions.Item label="一致性">{pelletResult.consistent ? <Tag color="success">一致</Tag> : <Tag color="error">不一致</Tag>}</Descriptions.Item>
                              <Descriptions.Item label="推理器">{String(pelletResult.reasonerName ?? '-')} {String(pelletResult.reasonerVersion ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="推理耗时">{String(pelletResult.preparationTimeMs ?? '-')}ms</Descriptions.Item>
                              <Descriptions.Item label="公理总数">{String(pelletResult.totalAxioms ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="类总数">{String(pelletResult.totalClasses ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="对象属性">{String(pelletResult.totalObjectProperties ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="数据属性">{String(pelletResult.totalDatatypeProperties ?? '-')}</Descriptions.Item>
                              <Descriptions.Item label="个体总数">{String(pelletResult.totalIndividuals ?? 0)}</Descriptions.Item>
                            </Descriptions>

                            <Card size="small" title={<Space><SafetyCertificateOutlined style={{ color: '#f5222d' }} /><span>能力1：本体一致性检测</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>检测本体中是否存在逻辑矛盾，如不可满足类、互斥冲突等</div>
                              {Array.isArray(pelletResult.inconsistencies) && pelletResult.inconsistencies.length > 0 ? (
                                pelletResult.inconsistencies.map((item: any, idx: number) => (
                                  <Alert key={idx} type="error" showIcon message={String(item)} style={{ marginBottom: 4 }} />
                                ))
                              ) : (
                                <Alert type="success" showIcon message="本体一致，未检测到逻辑矛盾" />
                              )}
                              {Array.isArray(pelletResult.unsatisfiableClasses) && pelletResult.unsatisfiableClasses.length > 0 && (
                                <div style={{ marginTop: 8 }}>
                                  <Text type="danger" strong>不可满足类（等同于 owl:Nothing）：</Text>
                                  <ul style={{ margin: '4px 0 0', paddingLeft: 20 }}>
                                    {pelletResult.unsatisfiableClasses.map((cls: any, idx: number) => (
                                      <li key={idx}><Text code>{String(cls)}</Text></li>
                                    ))}
                                  </ul>
                                </div>
                              )}
                              {pelletResult.equivalentClasses && typeof pelletResult.equivalentClasses === 'object' && Object.keys(pelletResult.equivalentClasses).length > 0 && (
                                <div style={{ marginTop: 8 }}>
                                  <Text strong>推断等价类：</Text>
                                  {Object.entries(pelletResult.equivalentClasses).map(([cls, equivs]: [string, any], idx: number) => (
                                    <div key={idx} style={{ padding: '2px 8px', fontSize: 12, color: '#1890ff' }}>
                                      <Tag>{cls}</Tag> 等价于 <Tag color="blue">{Array.isArray(equivs) ? equivs.join('、') : String(equivs)}</Tag>
                                    </div>
                                  ))}
                                </div>
                              )}
                              {pelletResult.disjointClasses && typeof pelletResult.disjointClasses === 'object' && Object.keys(pelletResult.disjointClasses).length > 0 && (
                                <div style={{ marginTop: 8 }}>
                                  <Text strong style={{ color: '#fa8c16' }}>互斥类关系：</Text>
                                  {Object.entries(pelletResult.disjointClasses).map(([cls, disjoints]: [string, any], idx: number) => (
                                    <div key={idx} style={{ padding: '2px 8px', fontSize: 12, color: '#fa8c16' }}>
                                      <Tag>{cls}</Tag> 互斥于 <Tag color="orange">{Array.isArray(disjoints) ? disjoints.join('、') : String(disjoints)}</Tag>
                                    </div>
                                  ))}
                                </div>
                              )}
                            </Card>

                            <Card size="small" title={<Space><ApartmentOutlined style={{ color: '#722ed1' }} /><span>能力2：类层级关系推理</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>自动推断并完善概念之间的继承关系，发现隐含的父类和子类</div>
                              {pelletResult.inferredHierarchy && typeof pelletResult.inferredHierarchy === 'object' && Object.keys(pelletResult.inferredHierarchy).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>推断子类层次：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(pelletResult.inferredHierarchy).map(([parent, children]: [string, any], idx: number) => ({
                                      key: idx, parent, inferredChildren: Array.isArray(children) ? children.join('、') : String(children ?? ''),
                                    }))}
                                    columns={[
                                      { title: '父类', dataIndex: 'parent', key: 'parent', width: 200 },
                                      { title: '推断子类', dataIndex: 'inferredChildren', key: 'inferredChildren' },
                                    ]}
                                  />
                                </div>
                              ) : (
                                <div style={{ marginBottom: 8 }}><Empty description="无推断的子类层次" image={Empty.PRESENTED_IMAGE_SIMPLE} /></div>
                              )}
                              {pelletResult.inferredSuperClasses && typeof pelletResult.inferredSuperClasses === 'object' && Object.keys(pelletResult.inferredSuperClasses).length > 0 ? (
                                <div>
                                  <Text strong>推断超类层次（隐含父类）：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(pelletResult.inferredSuperClasses).map(([cls, supers]: [string, any], idx: number) => ({
                                      key: idx, className: cls, superClassNames: Array.isArray(supers) ? supers.join('、') : String(supers ?? ''),
                                    }))}
                                    columns={[
                                      { title: '类', dataIndex: 'className', key: 'className', width: 200 },
                                      { title: '推断超类', dataIndex: 'superClassNames', key: 'superClassNames' },
                                    ]}
                                  />
                                </div>
                              ) : null}
                            </Card>

                            <Card size="small" title={<Space><NodeIndexOutlined style={{ color: '#13c2c2' }} /><span>能力3：实例归属判断</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>判断个体是否属于特定概念，自动补全隐含的类型归属</div>
                              {(pelletResult.totalIndividuals ?? 0) === 0 ? (
                                <Empty description="当前本体未定义任何个体（Named Individual），如需实例推理请在 TTL 中声明个体" image={Empty.PRESENTED_IMAGE_SIMPLE} />
                              ) : (
                                <>
                                  {pelletResult.inferredIndividualTypes && typeof pelletResult.inferredIndividualTypes === 'object' && Object.keys(pelletResult.inferredIndividualTypes).length > 0 ? (
                                    <div style={{ marginBottom: 8 }}>
                                      <Text strong>个体类型归属推断：</Text>
                                      <Table
                                        size="small" bordered pagination={{ defaultPageSize: 5 }}
                                        dataSource={Object.entries(pelletResult.inferredIndividualTypes).map(([individual, types]: [string, any], idx: number) => ({
                                          key: idx, individual, typeNames: Array.isArray(types) ? types.join('、') : String(types ?? ''),
                                        }))}
                                        columns={[
                                          { title: '个体', dataIndex: 'individual', key: 'individual', width: 200 },
                                          { title: '推断归属类型', dataIndex: 'typeNames', key: 'typeNames' },
                                        ]}
                                      />
                                    </div>
                                  ) : null}
                                  {pelletResult.classInstances && typeof pelletResult.classInstances === 'object' && Object.keys(pelletResult.classInstances).length > 0 ? (
                                    <div>
                                      <Text strong>各类实例分布：</Text>
                                      <Table
                                        size="small" bordered pagination={{ defaultPageSize: 5 }}
                                        dataSource={Object.entries(pelletResult.classInstances).map(([cls, instances]: [string, any], idx: number) => ({
                                          key: idx, className: cls, instanceNames: Array.isArray(instances) ? instances.join('、') : String(instances ?? ''),
                                        }))}
                                        columns={[
                                          { title: '类', dataIndex: 'className', key: 'className', width: 200 },
                                          { title: '包含实例', dataIndex: 'instanceNames', key: 'instanceNames' },
                                        ]}
                                      />
                                    </div>
                                  ) : null}
                                </>
                              )}
                            </Card>

                            <Card size="small" title={<Space><LinkOutlined style={{ color: '#eb2f96' }} /><span>能力4：属性与关系推导</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>推导属性特征（传递性、对称性等）、逆属性关系、等价属性</div>
                              {pelletResult.propertyCharacteristics && typeof pelletResult.propertyCharacteristics === 'object' && Object.keys(pelletResult.propertyCharacteristics).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>属性特征推导：</Text>
                                  {Object.entries(pelletResult.propertyCharacteristics).map(([prop, chars]: [string, any], idx: number) => (
                                    <div key={idx} style={{ padding: '2px 8px', fontSize: 12 }}>
                                      <Tag color="magenta">{prop}</Tag>
                                      {Array.isArray(chars) ? chars.map((c: string, ci: number) => (
                                        <Tag key={ci} style={{ fontSize: 11 }}>{c}</Tag>
                                      )) : <Tag style={{ fontSize: 11 }}>{String(chars)}</Tag>}
                                    </div>
                                  ))}
                                </div>
                              ) : (
                                <div style={{ marginBottom: 8 }}><Text type="secondary" style={{ fontSize: 12 }}>未推断出额外的属性特征</Text></div>
                              )}
                              {pelletResult.inverseProperties && typeof pelletResult.inverseProperties === 'object' && Object.keys(pelletResult.inverseProperties).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>逆属性关系：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(pelletResult.inverseProperties).map(([prop, inverse]: [string, any], idx: number) => ({
                                      key: idx, property: prop, inverseProperty: String(inverse ?? ''),
                                    }))}
                                    columns={[
                                      { title: '属性', dataIndex: 'property', key: 'property', width: 200 },
                                      { title: '逆属性', dataIndex: 'inverseProperty', key: 'inverseProperty' },
                                    ]}
                                  />
                                </div>
                              ) : null}
                              {pelletResult.equivalentProperties && typeof pelletResult.equivalentProperties === 'object' && Object.keys(pelletResult.equivalentProperties).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>等价属性：</Text>
                                  {Object.entries(pelletResult.equivalentProperties).map(([prop, equivs]: [string, any], idx: number) => (
                                    <div key={idx} style={{ padding: '2px 8px', fontSize: 12 }}>
                                      <Tag color="magenta">{prop}</Tag> 等价于 <Tag color="volcano">{Array.isArray(equivs) ? equivs.join('、') : String(equivs)}</Tag>
                                    </div>
                                  ))}
                                </div>
                              ) : null}
                              {pelletResult.inferredPropertyHierarchy && typeof pelletResult.inferredPropertyHierarchy === 'object' && Object.keys(pelletResult.inferredPropertyHierarchy).length > 0 ? (
                                <div>
                                  <Text strong>隐含属性层次：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    scroll={{ y: 300 }}
                                    dataSource={Object.entries(pelletResult.inferredPropertyHierarchy).map(([parent, children]: [string, any], idx: number) => ({
                                      key: idx, parent, inferredChildren: Array.isArray(children) ? children.join('、') : String(children ?? ''),
                                    }))}
                                    columns={[
                                      { title: '父属性', dataIndex: 'parent', key: 'parent', width: 200 },
                                      { title: '推断子属性', dataIndex: 'inferredChildren', key: 'inferredChildren' },
                                    ]}
                                  />
                                </div>
                              ) : (
                                <div><Empty description="无推断的属性层次关系" image={Empty.PRESENTED_IMAGE_SIMPLE} /></div>
                              )}
                            </Card>

                            {/* ========== 能力5: 数据属性推导 ========== */}
                            <Card size="small" title={<Space><DatabaseOutlined style={{ color: '#52c41a' }} /><span>能力5：数据属性推导</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>推导数据属性层次关系和数据属性所属类</div>
                              {pelletResult.inferredDataPropertyHierarchy && typeof pelletResult.inferredDataPropertyHierarchy === 'object' && Object.keys(pelletResult.inferredDataPropertyHierarchy).length > 0 ? (
                                <div style={{ marginBottom: 8 }}>
                                  <Text strong>数据属性层次：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(pelletResult.inferredDataPropertyHierarchy).map(([parent, children]: [string, any], idx: number) => ({
                                      key: idx, parent, inferredChildren: Array.isArray(children) ? children.join('、') : String(children ?? ''),
                                    }))}
                                    columns={[
                                      { title: '父数据属性', dataIndex: 'parent', key: 'parent', width: 200 },
                                      { title: '推断子数据属性', dataIndex: 'inferredChildren', key: 'inferredChildren' },
                                    ]}
                                  />
                                </div>
                              ) : (
                                <div style={{ marginBottom: 8 }}><Text type="secondary" style={{ fontSize: 12 }}>未推断出数据属性层次关系</Text></div>
                              )}
                              {pelletResult.dataPropertyDomains && typeof pelletResult.dataPropertyDomains === 'object' && Object.keys(pelletResult.dataPropertyDomains).length > 0 ? (
                                <div>
                                  <Text strong>数据属性定义域：</Text>
                                  <Table
                                    size="small" bordered pagination={{ defaultPageSize: 5 }}
                                    dataSource={Object.entries(pelletResult.dataPropertyDomains).map(([dp, domains]: [string, any], idx: number) => ({
                                      key: idx, dataProperty: dp, domainClasses: Array.isArray(domains) ? domains.join('、') : String(domains ?? ''),
                                    }))}
                                    columns={[
                                      { title: '数据属性', dataIndex: 'dataProperty', key: 'dataProperty', width: 200 },
                                      { title: '定义域类', dataIndex: 'domainClasses', key: 'domainClasses' },
                                    ]}
                                  />
                                </div>
                              ) : null}
                            </Card>

                            {/* ========== 能力6: SWRL 规则推导 ========== */}
                            <Card size="small" title={<Space><ThunderboltOutlined style={{ color: '#722ed1' }} /><span>能力6：SWRL 规则推导</span></Space>} style={{ marginBottom: 12 }}>
                              <div style={{ color: '#666', marginBottom: 8, fontSize: 12 }}>检查本体中的 SWRL 规则定义和推导结果</div>
                              {pelletResult.swrlRuleResults && Array.isArray(pelletResult.swrlRuleResults) && pelletResult.swrlRuleResults.length > 0 ? (
                                pelletResult.swrlRuleResults.map((item: any, idx: number) => (
                                  <Alert key={idx} type={String(item).includes('未定义') ? 'warning' : 'info'} showIcon message={String(item)} style={{ marginBottom: 4 }} />
                                ))
                              ) : (
                                <Alert type="warning" showIcon message="当前本体未定义 SWRL 规则，如需规则推理请在 TTL 中声明 SWRL 规则" />
                              )}
                            </Card>
                          </>
                        )}
                      </div>
                    )}
                  </div>
                ),
              },
              {
                key: 'protege',
                label: (
                  <span>
                    <NodeIndexOutlined />
                    Protégé 精修
                  </span>
                ),
                children: (
                  <div>
                    <Alert
                      type="info"
                      showIcon
                      message="Protégé 风格本体精修 — 通过类层次、对象属性、业务规则和可视化图形管理本体模型"
                      style={{ marginBottom: 12 }}
                    />
                    <Space style={{ marginBottom: 12 }}>
                      <Button icon={<RedoOutlined />} onClick={loadProtegeData}>刷新数据</Button>
                      <Button type="primary" icon={<SaveOutlined />} loading={protegeSaving} onClick={handleSaveTtl}>保存 TTL</Button>
                      <Button icon={<DownloadOutlined />} onClick={handleExportForProtege}>导出 TTL</Button>
                    </Space>

                    <Tabs
                      activeKey={protegeActiveTab}
                      onChange={(key) => {
                        setProtegeActiveTab(key);
                        if (key === 'graph') {
                          // 切换到可视化时，延迟渲染确保 DOM 已挂载
                          setTimeout(() => renderProtegeGraph(), 100);
                        }
                      }}
                      type="card"
                      size="small"
                      items={[
                        {
                          key: 'classes',
                          label: <span><ApartmentOutlined /> 类层次（对象实体）</span>,
                          children: (
                            <div>
                              <div style={{ marginBottom: 12, display: 'flex', justifyContent: 'space-between' }}>
                                <Text type="secondary">管理本体的 OWL 类层次结构，支持添加、编辑、删除类及其继承关系</Text>
                                <Button size="small" type="primary" icon={<PlusOutlined />} onClick={handleAddClass}>添加类（对象）</Button>
                              </div>
                              {(() => {
                                const { columns, dataSource } = buildClassColumns(protegeClasses);
                                return (
                                  <>
                                    <div style={{ marginBottom: 8 }}>
                                      <Text type="secondary" style={{ fontSize: 12 }}>共 <Text strong>{protegeClasses.length}</Text> 个类</Text>
                                    </div>
                                    <Table
                                      size="small"
                                      bordered
                                      dataSource={dataSource}
                                      rowKey="id"
                                      pagination={{ size: 'small', showSizeChanger: false, defaultPageSize: 20, showTotal: (total) => `共 ${total} 条` }}
                                      scroll={{ y: 420 }}
                                      columns={columns}
                                    />
                                  </>
                                );
                              })()}
                            </div>
                          ),
                        },
                        {
                          key: 'properties',
                          label: <span><LinkOutlined /> 对象属性关系（Link）</span>,
                          children: (
                            <div>
                              <div style={{ marginBottom: 12, display: 'flex', justifyContent: 'space-between' }}>
                                <Text type="secondary">管理本体的 OWL 对象属性，定义类与类之间的关系</Text>
                                <Button size="small" type="primary" icon={<PlusOutlined />} onClick={handleAddLink}>添加对象属性关系</Button>
                              </div>

                              {/* 关系统计概览 */}
                              {protegeProperties.length > 0 && (
                                <Card size="small" style={{ marginBottom: 12 }} title={<Text strong style={{ fontSize: 13 }}>关系连接概览</Text>}>
                                  <Row gutter={16}>
                                    <Col span={6}>
                                      <Statistic title="关系总数" value={protegeProperties.length} valueStyle={{ fontSize: 20, color: '#1677ff' }} />
                                    </Col>
                                    <Col span={6}>
                                      <Statistic
                                        title="起始类数"
                                        value={new Set(protegeProperties.map((p: any) => p.sourceType).filter(Boolean)).size}
                                        valueStyle={{ fontSize: 20, color: '#52c41a' }}
                                      />
                                    </Col>
                                    <Col span={6}>
                                      <Statistic
                                        title="目标类数"
                                        value={new Set(protegeProperties.map((p: any) => p.targetType).filter(Boolean)).size}
                                        valueStyle={{ fontSize: 20, color: '#fa8c16' }}
                                      />
                                    </Col>
                                    <Col span={6}>
                                      <Statistic
                                        title="涉及类总数"
                                        value={new Set([...protegeProperties.map((p: any) => p.sourceType), ...protegeProperties.map((p: any) => p.targetType)].filter(Boolean)).size}
                                        valueStyle={{ fontSize: 20, color: '#722ed1' }}
                                      />
                                    </Col>
                                  </Row>
                                </Card>
                              )}

                              {/* 按起始类分组的关系视图 */}
                              {protegeProperties.length > 0 && (() => {
                                const groupedBySource: Record<string, any[]> = {};
                                protegeProperties.forEach((prop: any) => {
                                  const src = prop.sourceType || '未指定';
                                  if (!groupedBySource[src]) groupedBySource[src] = [];
                                  groupedBySource[src].push(prop);
                                });
                                return (
                                  <Collapse
                                    size="small"
                                    defaultActiveKey={Object.keys(groupedBySource).slice(0, 5)}
                                    style={{ marginBottom: 12 }}
                                    items={Object.entries(groupedBySource).map(([sourceIri, rels]: [string, any[]], idx: number) => {
                                      const srcClass = protegeClasses.find((c: any) => c.iri === sourceIri || c.label === sourceIri);
                                      const srcLabel = srcClass?.label || sourceIri?.split('/').pop() || sourceIri;
                                      const outDegree = rels.length;
                                      const inDegree = protegeProperties.filter((p: any) => p.targetType === sourceIri).length;
                                      return {
                                        key: `group-${idx}`,
                                        label: (
                                          <Space>
                                            <Tag color={NODE_COLORS[protegeClasses.indexOf(srcClass) % NODE_COLORS.length]}>{srcLabel}</Tag>
                                            <Text type="secondary" style={{ fontSize: 11 }}>出度: {outDegree}</Text>
                                            <Text type="secondary" style={{ fontSize: 11 }}>入度: {inDegree}</Text>
                                          </Space>
                                        ),
                                        children: (
                                          <Table
                                            size="small"
                                            bordered
                                            dataSource={rels.map((r: any, rIdx: number) => ({
                                              ...r,
                                              _rKey: `${sourceIri}-${rIdx}`,
                                            }))}
                                            rowKey="_rKey"
                                            pagination={{ size: 'small', showSizeChanger: false, defaultPageSize: 10, showTotal: (total) => `共 ${total} 条` }}
                                            columns={[
                                              {
                                                title: '起始类', dataIndex: 'sourceType', key: 'src', width: 160,
                                                render: (text: string) => {
                                                  const c = protegeClasses.find((cls: any) => cls.iri === text || cls.label === text);
                                                  return c ? <Tag color={NODE_COLORS[protegeClasses.indexOf(c) % NODE_COLORS.length]}>{c.label}</Tag> : <Text style={{ fontSize: 12 }}>{text || '-'}</Text>;
                                                },
                                              },
                                              {
                                                title: '关系', key: 'relation', width: 180,
                                                render: (_: any, record: any) => (
                                                  <Space>
                                                    <ArrowRightOutlined style={{ color: '#1677ff' }} />
                                                    <Tag color="purple">{record.label || '-'}</Tag>
                                                  </Space>
                                                ),
                                              },
                                              {
                                                title: '目标类', dataIndex: 'targetType', key: 'tgt', width: 160,
                                                render: (text: string) => {
                                                  const c = protegeClasses.find((cls: any) => cls.iri === text || cls.label === text);
                                                  return c ? <Tag color={NODE_COLORS[protegeClasses.indexOf(c) % NODE_COLORS.length]}>{c.label}</Tag> : <Text style={{ fontSize: 12 }}>{text || '-'}</Text>;
                                                },
                                              },
                                              {
                                                title: 'IRI', dataIndex: 'iri', key: 'iri', ellipsis: true,
                                                render: (text: string) => <Tooltip title={text}><Text copyable style={{ fontSize: 11 }}>{text}</Text></Tooltip>,
                                              },
                                              {
                                                title: '描述', dataIndex: 'description', key: 'desc', ellipsis: true,
                                                render: (text: string) => <Text type="secondary" style={{ fontSize: 11 }}>{text || '-'}</Text>,
                                              },
                                              {
                                                title: '操作', key: 'actions', width: 140,
                                                render: (_: any, record: any) => (
                                                  <Space size="small">
                                                    <Button size="small" type="link" onClick={() => { setSelectedEdge(record); handleEditLink(); }}>编辑</Button>
                                                    <Popconfirm title={`确认删除关系「${record.label}」？`} onConfirm={() => handleDeleteLinkById(record.id)} okText="删除" cancelText="取消">
                                                      <Button size="small" type="link" danger>删除</Button>
                                                    </Popconfirm>
                                                  </Space>
                                                ),
                                              },
                                            ]}
                                          />
                                        ),
                                      };
                                    })}
                                  />
                                );
                              })()}

                            </div>
                          ),
                        },
                        {
                          key: 'dataProperties',
                          label: <span><DatabaseOutlined /> 数据属性 (DatatypeProperty)</span>,
                          children: (
                            <div>
                              <div style={{ marginBottom: 12, display: 'flex', justifyContent: 'space-between' }}>
                                <Text type="secondary">管理本体的 OWL 数据属性（DatatypeProperty），定义类到 XML Schema 数据类型的属性</Text>
                                <Button size="small" type="primary" icon={<PlusOutlined />} onClick={handleAddDataProperty}>添加数据属性</Button>
                              </div>
                              {(() => {
                                const groupedByDomain: Record<string, { cls: any; props: any[] }> = {};
                                (protegeClasses || []).forEach((cls: any) => {
                                  if (cls.propertiesJson) {
                                    try {
                                      const props = typeof cls.propertiesJson === 'string' ? JSON.parse(cls.propertiesJson) : cls.propertiesJson;
                                      if (props && props.length > 0) {
                                        groupedByDomain[cls.id] = { cls, props };
                                      }
                                    } catch { /* ignore */ }
                                  }
                                });
                                const domainKeys = Object.keys(groupedByDomain);
                                if (domainKeys.length === 0) {
                                  return <Empty description="暂无数据属性" image={Empty.PRESENTED_IMAGE_SIMPLE} />;
                                }
                                const totalProps = domainKeys.reduce((sum, k) => sum + groupedByDomain[k].props.length, 0);
                                return (
                                  <>
                                    <div style={{ marginBottom: 8 }}>
                                      <Text type="secondary" style={{ fontSize: 12 }}>共 <Text strong>{domainKeys.length}</Text> 个类，<Text strong>{totalProps}</Text> 个数据属性</Text>
                                    </div>
                                    <Collapse
                                      size="small"
                                      defaultActiveKey={domainKeys.slice(0, 5)}
                                      items={domainKeys.map((classId, idx) => {
                                        const { cls, props } = groupedByDomain[classId];
                                        const colorIdx = protegeClasses.indexOf(cls);
                                        return {
                                          key: classId,
                                          label: (
                                            <Space>
                                              <Tag color={NODE_COLORS[colorIdx % NODE_COLORS.length]}>{cls.label || cls.iri?.split('/').pop()}</Tag>
                                              <Text type="secondary" style={{ fontSize: 11 }}>{props.length} 个属性</Text>
                                            </Space>
                                          ),
                                          children: (
                                            <Table
                                              size="small"
                                              bordered
                                              dataSource={props.map((p: any, pIdx: number) => ({ ...p, _key: `${classId}-${pIdx}` }))}
                                              rowKey="_key"
                                              pagination={false}
                                              columns={[
                                                {
                                                  title: '属性名称', dataIndex: 'label', key: 'label', width: 160,
                                                  render: (text: string) => <Tag color="cyan">{text || '-'}</Tag>,
                                                },
                                                {
                                                  title: 'IRI', dataIndex: 'iri', key: 'iri', ellipsis: true,
                                                  render: (text: string) => <Tooltip title={text}><Text copyable style={{ fontSize: 12 }}>{text}</Text></Tooltip>,
                                                },
                                                {
                                                  title: '值域 (Range)', dataIndex: 'range', key: 'range', width: 140,
                                                  render: (text: string) => {
                                                    if (!text) return <Tag>xsd:string</Tag>;
                                                    return <Tag color="volcano">{text.replace(/^xsd:/, 'xsd:')}</Tag>;
                                                  },
                                                },
                                                {
                                                  title: '描述', dataIndex: 'description', key: 'desc', ellipsis: true,
                                                  render: (text: string) => <Text type="secondary" style={{ fontSize: 12 }}>{text || '-'}</Text>,
                                                },
                                                {
                                                  title: '操作', key: 'actions', width: 140,
                                                  render: (_: any, record: any) => (
                                                    <Space size="small">
                                                      <Button size="small" type="link" onClick={() => handleEditDataProperty(record, classId)}>编辑</Button>
                                                      <Popconfirm title={`确认删除数据属性「${record.label}」？`} onConfirm={() => handleDeleteDataProperty(record, classId)} okText="删除" cancelText="取消">
                                                        <Button size="small" type="link" danger>删除</Button>
                                                      </Popconfirm>
                                                    </Space>
                                                  ),
                                                },
                                              ]}
                                            />
                                          ),
                                        };
                                      })}
                                    />
                                  </>
                                );
                              })()}
                            </div>
                          ),
                        },
                        {
                          key: 'subClassOf',
                          label: <span><ApartmentOutlined /> 继承类 (subClassOf)</span>,
                          children: (
                            <div>
                              <div style={{ marginBottom: 12, display: 'flex', justifyContent: 'space-between' }}>
                                <Text type="secondary">管理本体的 OWL 类继承关系（rdfs:subClassOf），定义类之间的父子层级结构</Text>
                                <Button size="small" type="primary" icon={<PlusOutlined />} onClick={handleAddSubClassOf}>添加继承关系</Button>
                              </div>
                              {(() => {
                                // 从 protegeClasses 中提取所有有 parentIri 的继承关系
                                const subClassOfList = (protegeClasses || [])
                                  .filter((cls: any) => cls.parentIri)
                                  .map((cls: any) => {
                                    const parent = protegeClasses.find((c: any) => iriMatches(c.iri, cls.parentIri));
                                    return {
                                      key: cls.id,
                                      childId: cls.id,
                                      childIri: cls.iri,
                                      childLabel: cls.label || cls.iri?.split('/').pop() || '-',
                                      parentId: parent?.id || '',
                                      parentIri: cls.parentIri,
                                      parentLabel: parent?.label || cls.parentIri?.split('/').pop() || '-',
                                      childDescription: cls.description || '',
                                      parentDescription: parent?.description || '',
                                    };
                                  });
                                if (subClassOfList.length === 0) {
                                  return <Empty description="暂无继承关系" image={Empty.PRESENTED_IMAGE_SIMPLE} />;
                                }
                                return (
                                  <>
                                    <div style={{ marginBottom: 8 }}>
                                      <Text type="secondary" style={{ fontSize: 12 }}>共 <Text strong>{subClassOfList.length}</Text> 条继承关系 (rdfs:subClassOf)</Text>
                                    </div>
                                    <Table
                                      size="small"
                                      bordered
                                      dataSource={subClassOfList}
                                      rowKey="key"
                                      pagination={{ size: 'small', showSizeChanger: false, defaultPageSize: 10, showTotal: (total) => `共 ${total} 条` }}
                                      scroll={{ y: 420 }}
                                      columns={[
                                        {
                                          title: '序号', key: 'index', width: 60, align: 'center',
                                          render: (_: any, __: any, index: number) => index + 1,
                                        },
                                        {
                                          title: '子类 (SubClass)', key: 'child', width: 180,
                                          render: (_: any, record: any) => {
                                            const colorIdx = protegeClasses.findIndex((c: any) => c.iri === record.childIri);
                                            return (
                                              <Tooltip title={record.childDescription || record.childIri}>
                                                <Tag color={NODE_COLORS[colorIdx % NODE_COLORS.length]}>{record.childLabel}</Tag>
                                              </Tooltip>
                                            );
                                          },
                                        },
                                        {
                                          title: 'IRI', key: 'childIri', width: 200, ellipsis: true,
                                          render: (_: any, record: any) => (
                                            <Tooltip title={record.childIri}><Text copyable style={{ fontSize: 12 }}>{record.childIri}</Text></Tooltip>
                                          ),
                                        },
                                        {
                                          title: '继承关系', key: 'relation', width: 100, align: 'center',
                                          render: () => (
                                            <Space>
                                              <ArrowRightOutlined style={{ color: '#722ed1' }} />
                                              <Text strong style={{ color: '#722ed1', fontSize: 12 }}>rdfs:subClassOf</Text>
                                            </Space>
                                          ),
                                        },
                                        {
                                          title: '父类 (SuperClass)', key: 'parent', width: 180,
                                          render: (_: any, record: any) => {
                                            const colorIdx = protegeClasses.findIndex((c: any) => c.iri === record.parentIri);
                                            return (
                                              <Tooltip title={record.parentDescription || record.parentIri}>
                                                <Tag color={NODE_COLORS[colorIdx % NODE_COLORS.length]}>{record.parentLabel}</Tag>
                                              </Tooltip>
                                            );
                                          },
                                        },
                                        {
                                          title: '父类 IRI', key: 'parentIri', ellipsis: true,
                                          render: (_: any, record: any) => (
                                            <Tooltip title={record.parentIri}><Text copyable style={{ fontSize: 12 }}>{record.parentIri}</Text></Tooltip>
                                          ),
                                        },
                                        {
                                          title: '操作', key: 'actions', width: 140,
                                          render: (_: any, record: any) => (
                                            <Space size="small">
                                              <Button size="small" type="link" onClick={() => handleEditSubClassOf(record)}>编辑</Button>
                                              <Popconfirm title={`确认删除继承关系「${record.childLabel} → ${record.parentLabel}」？`} onConfirm={() => handleDeleteSubClassOf(record)} okText="删除" cancelText="取消">
                                                <Button size="small" type="link" danger>删除</Button>
                                              </Popconfirm>
                                            </Space>
                                          ),
                                        },
                                      ]}
                                    />
                                  </>
                                );
                              })()}
                            </div>
                          ),
                        },
                        {
                          key: 'rules',
                          label: <span><ThunderboltOutlined /> 业务规则 (Rule)</span>,
                          children: (
                            <div>
                              <div style={{ marginBottom: 12, display: 'flex', justifyContent: 'space-between' }}>
                                <Text type="secondary">管理本体的业务规则，包括条件规则、事件规则、时序规则和组合规则</Text>
                                <Button size="small" type="primary" icon={<PlusOutlined />} onClick={handleAddRule}>添加规则</Button>
                              </div>
                              <Table
                                size="small"
                                bordered
                                loading={rulesLoading}
                                dataSource={protegeRules}
                                rowKey="id"
                                pagination={{ size: 'small', showSizeChanger: false, defaultPageSize: 10, showTotal: (total) => `共 ${total} 条` }}
                                scroll={{ y: 420 }}
                                columns={[
                                  {
                                    title: '规则名称', dataIndex: 'name', key: 'name', width: 180,
                                    render: (text: string) => <Text strong>{text || '-'}</Text>,
                                  },
                                  {
                                    title: '描述', dataIndex: 'description', key: 'description', width: 150, ellipsis: true,
                                    render: (text: string) => text ? <Text style={{ fontSize: 12 }}>{text}</Text> : <Text type="secondary" style={{ fontSize: 12 }}>-</Text>,
                                  },
                                  {
                                    title: '类型', dataIndex: 'type', key: 'type', width: 100,
                                    render: (text: string) => {
                                      const map: Record<string, { label: string; color: string }> = {
                                        CONDITION: { label: '条件规则', color: 'blue' },
                                        EVENT: { label: '事件规则', color: 'orange' },
                                        TEMPORAL: { label: '时序规则', color: 'purple' },
                                        COMPOSITE: { label: '组合规则', color: 'cyan' },
                                        SWRL: { label: 'SWRL规则', color: 'geekblue' },
                                      };
                                      const info = map[text] || { label: text, color: 'default' };
                                      return <Tag color={info.color}>{info.label}</Tag>;
                                    },
                                  },
                                  {
                                    title: '优先级', dataIndex: 'priority', key: 'priority', width: 80,
                                    render: (text: string) => {
                                      const map: Record<string, { label: string; color: string }> = {
                                        CRITICAL: { label: '严重', color: 'red' },
                                        HIGH: { label: '高', color: 'orange' },
                                        MEDIUM: { label: '中', color: 'blue' },
                                        LOW: { label: '低', color: 'default' },
                                      };
                                      const info = map[text] || { label: text, color: 'default' };
                                      return <Tag color={info.color}>{info.label}</Tag>;
                                    },
                                  },
                                  {
                                    title: '状态', dataIndex: 'status', key: 'status', width: 80,
                                    render: (text: string, record: any) => {
                                      const map: Record<string, { label: string; color: string }> = {
                                        DRAFT: { label: '草稿', color: 'default' },
                                        ACTIVE: { label: '已激活', color: 'success' },
                                        DEPRECATED: { label: '已弃用', color: 'error' },
                                      };
                                      const info = map[text] || { label: text, color: 'default' };
                                      return (
                                        <Tag
                                          color={info.color}
                                          style={{ cursor: 'pointer' }}
                                          onClick={() => handleToggleRuleStatus(record)}
                                        >
                                          {info.label}
                                        </Tag>
                                      );
                                    },
                                  },
                                  {
                                    title: '置信度', dataIndex: 'confidence', key: 'confidence', width: 70,
                                    render: (val: number) => val != null ? <Text style={{ fontSize: 12 }}>{(val * 100).toFixed(0)}%</Text> : '-',
                                  },
                                  {
                                    title: 'SWRL 规则', dataIndex: 'swrlRule', key: 'swrlRule', ellipsis: true,
                                    render: (text: string) => {
                                      if (!text) return <Text type="secondary" style={{ fontSize: 12 }}>-</Text>;
                                      return (
                                        <Tooltip
                                          title={
                                            <pre style={{ margin: 0, fontSize: 11, maxHeight: 300, overflow: 'auto', whiteSpace: 'pre-wrap', wordBreak: 'break-all' }}>
                                              {text}
                                            </pre>
                                          }
                                        >
                                          <Text code copyable={{ text }} style={{ fontSize: 11 }}>
                                            {text.length > 80 ? text.substring(0, 80) + '...' : text}
                                          </Text>
                                        </Tooltip>
                                      );
                                    },
                                  },
                                  {
                                    title: '涉及的类', dataIndex: 'involvedClasses', key: 'involvedClasses', width: 180,
                                    render: (text: string) => {
                                      if (!text) return <Text type="secondary" style={{ fontSize: 12 }}>-</Text>;
                                      try {
                                        const arr = typeof text === 'string' ? JSON.parse(text) : text;
                                        if (Array.isArray(arr) && arr.length > 0) {
                                          return <span>{arr.map((c: string, i: number) => <Tag key={i} color="blue" style={{ fontSize: 11, marginBottom: 2 }}>{c.split('#').pop() || c.split('/').pop() || c}</Tag>)}</span>;
                                        }
                                        return <Text type="secondary" style={{ fontSize: 12 }}>-</Text>;
                                      } catch { return <Text type="secondary" style={{ fontSize: 12 }}>{text}</Text>; }
                                    },
                                  },
                                  {
                                    title: '涉及的数据属性', dataIndex: 'involvedDataProperties', key: 'involvedDataProperties', width: 180,
                                    render: (text: string) => {
                                      if (!text) return <Text type="secondary" style={{ fontSize: 12 }}>-</Text>;
                                      try {
                                        const arr = typeof text === 'string' ? JSON.parse(text) : text;
                                        if (Array.isArray(arr) && arr.length > 0) {
                                          return <span>{arr.map((p: string, i: number) => <Tag key={i} color="green" style={{ fontSize: 11, marginBottom: 2 }}>{p.split('#').pop() || p.split('/').pop() || p}</Tag>)}</span>;
                                        }
                                        return <Text type="secondary" style={{ fontSize: 12 }}>-</Text>;
                                      } catch { return <Text type="secondary" style={{ fontSize: 12 }}>{text}</Text>; }
                                    },
                                  },
                                  {
                                    title: '条件', dataIndex: 'conditionJson', key: 'conditionJson', ellipsis: true,
                                    render: (text: string) => {
                                      if (!text) return <Text type="secondary" style={{ fontSize: 12 }}>-</Text>;
                                      try {
                                        const obj = JSON.parse(text);
                                        return <Tooltip title={JSON.stringify(obj, null, 2)}><Text style={{ fontSize: 12 }} ellipsis>{{ ...obj, _preview: '点击查看' }.toString()}</Text></Tooltip>;
                                      } catch {
                                        return <Text type="secondary" style={{ fontSize: 12 }} ellipsis>{text}</Text>;
                                      }
                                    },
                                  },
                                  {
                                    title: '操作', key: 'actions', width: 160,
                                    render: (_: any, record: any) => (
                                      <Space size="small">
                                        <Button size="small" type="link" onClick={() => handleEditRule(record)}>编辑</Button>
                                        <Button size="small" type="link" onClick={() => handleToggleRuleStatus(record)}>
                                          {record.status === 'ACTIVE' ? '停用' : '激活'}
                                        </Button>
                                        <Popconfirm title={`确认删除规则「${record.name}」？`} onConfirm={() => handleDeleteRule(record.id)} okText="删除" cancelText="取消">
                                          <Button size="small" type="link" danger>删除</Button>
                                        </Popconfirm>
                                      </Space>
                                    ),
                                  },
                                ]}
                              />
                            </div>
                          ),
                        },
                        {
                          key: 'individuals',
                          label: <span><UserOutlined /> 个体 (Individual)</span>,
                          children: (
                            <div>
                              <div style={{ marginBottom: 12 }}>
                                <Text type="secondary">管理本体的 OWL 命名个体（Named Individual），个体是类的具体实例</Text>
                              </div>
                              <div style={{ marginBottom: 8 }}>
                                <Text type="secondary" style={{ fontSize: 12 }}>共 <Text strong>{protegeIndividuals.length}</Text> 个个体</Text>
                              </div>
                              {protegeIndividuals.length > 0 ? (
                                <Table
                                  size="small"
                                  bordered
                                  dataSource={protegeIndividuals.map((ind: any, idx: number) => ({ ...ind, key: idx }))}
                                  pagination={{ size: 'small', showSizeChanger: false, defaultPageSize: 20, showTotal: (total) => `共 ${total} 条` }}
                                  scroll={{ y: 420 }}
                                  columns={[
                                    {
                                      title: 'IRI', dataIndex: 'iri', key: 'iri', ellipsis: true,
                                      render: (text: string) => <Text code style={{ fontSize: 11 }}>{text}</Text>,
                                    },
                                    {
                                      title: '标签', dataIndex: 'label', key: 'label', width: 150,
                                      render: (text: string) => <Text strong>{text || '-'}</Text>,
                                    },
                                    {
                                      title: '所属类', dataIndex: 'types', key: 'types', width: 250,
                                      render: (types: string[]) => {
                                        if (!types || types.length === 0) return <Text type="secondary">-</Text>;
                                        return <span>{types.map((t: string, i: number) => <Tag key={i} color="blue" style={{ fontSize: 11, marginBottom: 2 }}>{t.split('#').pop() || t.split('/').pop() || t}</Tag>)}</span>;
                                      },
                                    },
                                  ]}
                                />
                              ) : (
                                <Empty description="当前本体未定义任何个体（Named Individual），可通过 Markdown 自动提取或编辑 TTL 文件添加个体" image={Empty.PRESENTED_IMAGE_SIMPLE} />
                              )}
                            </div>
                          ),
                        },
                        {
                          key: 'graph',
                          label: <span><TableOutlined /> 本体可视化</span>,
                          children: (
                            <div>
                              <div style={{ marginBottom: 12, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                <Text type="secondary">
                                  以{protegeViewMode === 'mindmap' ? '思维导图' : '图形'}方式浏览本体模型的类层次结构和对象属性关系（点击节点/边查看详情）
                                </Text>
                                <Space>
                                  <Segmented
                                    size="small"
                                    value={protegeViewMode}
                                    onChange={(v) => setProtegeViewMode(v as 'graph' | 'mindmap')}
                                    options={[
                                      { label: <span><TableOutlined /> 本体视图</span>, value: 'graph' },
                                      { label: <span><ApartmentOutlined /> 思维导图</span>, value: 'mindmap' },
                                    ]}
                                  />
                                  <Button
                                    size="small"
                                    icon={<DownloadOutlined />}
                                    onClick={handleExportProtegeGraph}
                                    disabled={protegeClasses.length === 0}
                                  >
                                    导出本体视图
                                  </Button>
                                  <Button
                                    size="small"
                                    icon={<DownloadOutlined />}
                                    onClick={handleExportProtegeMindmap}
                                    disabled={protegeClasses.length === 0}
                                  >
                                    导出思维导图
                                  </Button>
                                  <Button size="small" icon={<PlusOutlined />} onClick={handleAddClass}>添加类</Button>
                                  <Button size="small" icon={<PlusOutlined />} onClick={handleAddLink}>添加关系</Button>
                                </Space>
                              </div>
                              <Spin spinning={protegeLoading}>
                                <Row gutter={16}>
                                  <Col span={selectedNode || selectedEdge ? 16 : 24}>
                                    <div style={{ position: 'relative' }}>
                                      {/* 图例 */}
                                      <div style={{
                                        position: 'absolute', top: 8, right: 8, zIndex: 10,
                                        background: 'rgba(255,255,255,0.92)', borderRadius: 6,
                                        padding: '6px 12px', fontSize: 12, display: 'flex', gap: 14, alignItems: 'center',
                                        boxShadow: '0 1px 4px rgba(0,0,0,0.1)',
                                      }}>
                                        <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
                                          <svg width="14" height="14"><circle cx="7" cy="7" r="6" fill="#fff" stroke="#1677ff" strokeWidth="2" /></svg>
                                          <span style={{ color: '#555' }}>对象</span>
                                        </span>
                                        <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
                                          <svg width="22" height="14"><line x1="2" y1="7" x2="20" y2="7" stroke="#666" strokeWidth="1.5" /><polygon points="18,4 22,7 18,10" fill="#666" /></svg>
                                          <span style={{ color: '#555' }}>对象关系</span>
                                        </span>
                                        <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
                                          <svg width="22" height="14"><line x1="2" y1="7" x2="20" y2="7" stroke="#888" strokeWidth="1.2" strokeDasharray="4,3" /></svg>
                                          <span style={{ color: '#555' }}>继承</span>
                                        </span>
                                      </div>
                                      {/* 缩放控制 */}
                                      <div style={{
                                        position: 'absolute', bottom: 12, right: 12, zIndex: 10,
                                        background: 'rgba(255,255,255,0.92)', borderRadius: 6,
                                        padding: '4px 8px', display: 'flex', gap: 4, alignItems: 'center',
                                        boxShadow: '0 1px 4px rgba(0,0,0,0.1)',
                                      }}>
                                        <Button size="small" icon={<PlusOutlined />} onClick={handleZoomIn} title="放大" />
                                        <Text style={{ fontSize: 12, minWidth: 40, textAlign: 'center' }}>{Math.round(graphZoom * 100)}%</Text>
                                        <Button size="small" icon={<MinusOutlined />} onClick={handleZoomOut} title="缩小" />
                                        <Button size="small" onClick={handleZoomReset} title="重置">重置</Button>
                                      </div>
                                      {/* 画布容器 - 使用 overflow:hidden 依赖 G6 内置拖拽和缩放 */}
                                      <div
                                        style={{
                                          position: 'relative',
                                          width: '100%', height: 650, border: '1px solid #f0f0f0',
                                          borderRadius: 8, background: '#fafafa', overflow: 'hidden',
                                        }}
                                      >
                                        {/* 连线模式提示条 */}
                                        {edgeCreating && contextMenuNode && (
                                          <div style={{
                                            position: 'absolute',
                                            top: 8,
                                            left: '50%',
                                            transform: 'translateX(-50%)',
                                            zIndex: 100,
                                            background: '#1677ff',
                                            color: '#fff',
                                            padding: '6px 16px',
                                            borderRadius: 4,
                                            fontSize: 13,
                                            display: 'flex',
                                            alignItems: 'center',
                                            gap: 8,
                                            boxShadow: '0 2px 6px rgba(22,119,255,0.3)',
                                          }}>
                                            <LinkOutlined />
                                            <span>
                                              连线模式：请点击目标节点以创建关系
                                            </span>
                                            <Button
                                              size="small"
                                              type="text"
                                              style={{ color: '#fff', marginLeft: 8 }}
                                              onClick={() => {
                                                // 清除源节点的选中状态
                                                if (protegeGraphInstRef.current && contextMenuNode?.id) {
                                                  try {
                                                    protegeGraphInstRef.current.setElementState(contextMenuNode.id, 'selected', false);
                                                  } catch {}
                                                }
                                                setEdgeCreating(false);
                                                setContextMenuNode(null);
                                              }}
                                            >
                                              取消
                                            </Button>
                                          </div>
                                        )}
                                        <div
                                          ref={protegeGraphRef}
                                          id="protege-graph-container-inner"
                                          style={{
                                            width: '100%',
                                            height: '100%',
                                          }}
                                        />
                                      </div>
                                    </div>
                                  </Col>
                                  {(selectedNode || selectedEdge) && (
                                    <Col span={8}>
                                      {selectedNode && (
                                        <Card
                                          size="small"
                                          title={
                                            <Space>
                                              <Tag color={selectedNode.color || NODE_COLORS[selectedNode.colorIndex % NODE_COLORS.length]}>
                                                {selectedNode.label || '未命名类'}
                                              </Tag>
                                              <span style={{ fontSize: 12, color: '#888' }}>对象类型</span>
                                            </Space>
                                          }
                                          extra={
                                            <Space>
                                              <Button size="small" type="link" icon={<EditOutlined />} onClick={handleEditClass}>编辑</Button>
                                              <Popconfirm title="确认删除该对象类型？" onConfirm={handleDeleteClass} okText="删除" cancelText="取消">
                                                <Button size="small" type="link" danger icon={<DeleteOutlined />}>删除</Button>
                                              </Popconfirm>
                                            </Space>
                                          }
                                          style={{ marginBottom: 12 }}
                                        >
                                          <Descriptions size="small" column={1}>
                                            <Descriptions.Item label="IRI">
                                              <Tooltip title={selectedNode.iri}>
                                                <Text copyable style={{ fontSize: 12, maxWidth: 180, display: 'inline-block', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                                  {selectedNode.iri}
                                                </Text>
                                              </Tooltip>
                                            </Descriptions.Item>
                                            <Descriptions.Item label="名称">{selectedNode.label || '-'}</Descriptions.Item>
                                            {selectedNode.parentIri && (
                                              <Descriptions.Item label="父类">
                                                <Tooltip title={selectedNode.parentIri}>
                                                  <Text style={{ fontSize: 12 }}>{selectedNode.parentIri?.split('/').pop()}</Text>
                                                </Tooltip>
                                              </Descriptions.Item>
                                            )}
                                            <Descriptions.Item label="描述">{selectedNode.description || '-'}</Descriptions.Item>
                                          </Descriptions>
                                        </Card>
                                      )}
                                      {selectedEdge && (
                                        <Card
                                          size="small"
                                          title={
                                            <Space>
                                              <LinkOutlined />
                                              <span>{selectedEdge.label || '未命名关系'}</span>
                                              <span style={{ fontSize: 12, color: '#888' }}>对象属性</span>
                                            </Space>
                                          }
                                          extra={
                                            <Space>
                                              <Button size="small" type="link" icon={<EditOutlined />} onClick={handleEditLink}>编辑</Button>
                                              <Popconfirm title="确认删除该关系？" onConfirm={handleDeleteLink} okText="删除" cancelText="取消">
                                                <Button size="small" type="link" danger icon={<DeleteOutlined />}>删除</Button>
                                              </Popconfirm>
                                            </Space>
                                          }
                                          style={{ marginBottom: 12 }}
                                        >
                                          <Descriptions size="small" column={1}>
                                            <Descriptions.Item label="IRI">
                                              <Tooltip title={selectedEdge.iri}>
                                                <Text copyable style={{ fontSize: 12, maxWidth: 180, display: 'inline-block', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                                  {selectedEdge.iri}
                                                </Text>
                                              </Tooltip>
                                            </Descriptions.Item>
                                            <Descriptions.Item label="名称">{selectedEdge.label || '-'}</Descriptions.Item>
                                            <Descriptions.Item label="定义域">{selectedEdge.sourceType || '-'}</Descriptions.Item>
                                            <Descriptions.Item label="值域">{selectedEdge.targetType || '-'}</Descriptions.Item>
                                            <Descriptions.Item label="描述">{selectedEdge.description || '-'}</Descriptions.Item>
                                          </Descriptions>
                                        </Card>
                                      )}
                                    </Col>
                                  )}
                                </Row>
                              </Spin>
                            </div>
                          ),
                        },
                      ]}
                    />
                  </div>
                ),
              }
            ]}
          />
        )}
      </Modal>

      {/* 重命名 Modal */}
      <Modal
        open={renameVisible}
        title="重命名版本"
        onCancel={() => setRenameVisible(false)}
        onOk={handleSaveRename}
        confirmLoading={renameSaving}
        destroyOnHidden
      >
        <Space direction="vertical" style={{ width: '100%' }} size={12}>
          <div>
            <Text strong style={{ fontSize: 13 }}>本体模型名称</Text>
            <Input
              style={{ marginTop: 4 }}
              placeholder="本体模型名称（相同名称的版本归为一组）"
              value={renameName}
              onChange={e => setRenameName(e.target.value)}
              maxLength={100}
            />
          </div>
          <div>
            <Text strong style={{ fontSize: 13 }}>版本号名称</Text>
            <Input
              style={{ marginTop: 4 }}
              placeholder="版本号名称"
              value={renameVersionName}
              onChange={e => setRenameVersionName(e.target.value)}
              maxLength={50}
            />
          </div>
        </Space>
      </Modal>

      {/* TTL 查看 Modal */}
      <Modal
        open={ttlVisible}
        title="TTL 内容"
        width="80%"
        onCancel={() => { setTtlVisible(false); setTtlContent(''); }}
        footer={[
          <Button key="close" onClick={() => { setTtlVisible(false); setTtlContent(''); }}>关闭</Button>,
          <Button key="copy" icon={<CopyOutlined />} onClick={() => { navigator.clipboard.writeText(ttlContent); message.success('已复制'); }}>复制</Button>,
        ]}
      >
        {ttlLoading ? <div style={{ textAlign: 'center', padding: 40 }}><Spin /></div> : (
          <pre style={{
            background: '#fafafa', color: '#333', padding: 16, borderRadius: 8,
            fontSize: 12, lineHeight: 1.6, maxHeight: '60vh', overflow: 'auto',
            fontFamily: 'Consolas, Monaco, "Courier New", monospace',
            border: '1px solid #e8e8e8',
          }}>
            {ttlContent}
          </pre>
        )}
      </Modal>

      {/* TTL 在线编辑 Modal */}
      <Modal
        open={editTtlVisible}
        title={
          <Space>
            <EditOutlined />
            <span>在线编辑 TTL 文件</span>
          </Space>
        }
        width="80%"
        maskClosable={false}
        onCancel={() => { if (!editTtlSaving) { setEditTtlVisible(false); setEditTtlContent(''); } }}
        footer={[
          <Button key="cancel" onClick={() => { setEditTtlVisible(false); setEditTtlContent(''); }} disabled={editTtlSaving}>取消</Button>,
          <Button key="save" type="primary" icon={<SaveOutlined />} loading={editTtlSaving} onClick={handleSaveEditTtl}>
            保存
          </Button>,
        ]}
      >
        {editTtlLoading ? <div style={{ textAlign: 'center', padding: 40 }}><Spin /></div> : (
          <Input.TextArea
            value={editTtlContent}
            onChange={e => setEditTtlContent(e.target.value)}
            style={{
              fontFamily: 'Consolas, Monaco, "Courier New", monospace',
              fontSize: 13,
              lineHeight: 1.6,
            }}
            autoSize={{ minRows: 20, maxRows: 35 }}
            placeholder="TTL 文件内容"
          />
        )}
      </Modal>

      {/* 提取模型查看 Modal */}
      <Modal
        open={extractModelVisible}
        title={
          <Space>
            <BlockOutlined />
            <span>提取模型</span>
            {extractModelName && <Tag color="blue">{extractModelName}</Tag>}
          </Space>
        }
        width="80%"
        onCancel={() => { setExtractModelVisible(false); }}
        footer={[
          <Button key="close" onClick={() => { setExtractModelVisible(false); }}>关闭</Button>,
        ]}
      >
        {extractModelLoading ? (
          <div style={{ textAlign: 'center', padding: 60 }}><Spin size="large" tip="加载模型数据..."><div style={{ padding: 20 }}>加载模型数据...</div></Spin></div>
        ) : (
          <Tabs
            defaultActiveKey="classes"
            items={[
              {
                key: 'classes',
                label: <span>类 ({extractModelClasses.length})</span>,
                children: extractModelClasses.length === 0 ? (
                  <Empty description="暂无类定义" image={Empty.PRESENTED_IMAGE_SIMPLE} />
                ) : (
                  <Table
                    dataSource={extractModelClasses}
                    rowKey={(r: any) => r.id || r.iri}
                    size="small"
                    pagination={{ defaultPageSize: 20, size: 'small' }}
                    columns={[
                      { title: 'IRI', dataIndex: 'iri', key: 'iri', ellipsis: true, width: 200 },
                      { title: '标签', dataIndex: 'label', key: 'label', width: 120 },
                      { title: '父类', dataIndex: 'parentIri', key: 'parentIri', ellipsis: true, width: 200, render: (v: string) => v || '-' },
                      { title: '描述', dataIndex: 'description', key: 'description', ellipsis: true, render: (v: string) => v || '-' },
                    ]}
                  />
                ),
              },
              {
                key: 'objProps',
                label: <span>对象属性 ({extractModelObjProps.length})</span>,
                children: extractModelObjProps.length === 0 ? (
                  <Empty description="暂无对象属性" image={Empty.PRESENTED_IMAGE_SIMPLE} />
                ) : (
                  <Table
                    dataSource={extractModelObjProps}
                    rowKey={(r: any) => r.id || r.iri}
                    size="small"
                    pagination={{ defaultPageSize: 20, size: 'small' }}
                    columns={[
                      { title: 'IRI', dataIndex: 'iri', key: 'iri', ellipsis: true, width: 200 },
                      { title: '标签', dataIndex: 'label', key: 'label', width: 120 },
                      { title: 'Domain', dataIndex: 'sourceType', key: 'sourceType', ellipsis: true, width: 180, render: (v: string) => v || '-' },
                      { title: 'Range', dataIndex: 'targetType', key: 'targetType', ellipsis: true, width: 180, render: (v: string) => v || '-' },
                      { title: '描述', dataIndex: 'description', key: 'description', ellipsis: true, render: (v: string) => v || '-' },
                    ]}
                  />
                ),
              },
              {
                key: 'dataProps',
                label: <span>数据属性 ({extractModelDataProps.length})</span>,
                children: extractModelDataProps.length === 0 ? (
                  <Empty description="暂无数据属性" image={Empty.PRESENTED_IMAGE_SIMPLE} />
                ) : (
                  <Table
                    dataSource={extractModelDataProps}
                    rowKey={(r: any) => r.id || r.iri}
                    size="small"
                    pagination={{ defaultPageSize: 20, size: 'small' }}
                    columns={[
                      { title: 'IRI', dataIndex: 'iri', key: 'iri', ellipsis: true, width: 200 },
                      { title: '标签', dataIndex: 'label', key: 'label', width: 120 },
                      { title: 'Domain', dataIndex: 'sourceType', key: 'sourceType', ellipsis: true, width: 180, render: (v: string) => v || '-' },
                      { title: 'Range', dataIndex: 'targetType', key: 'targetType', ellipsis: true, width: 180, render: (v: string) => v || '-' },
                      { title: '描述', dataIndex: 'description', key: 'description', ellipsis: true, render: (v: string) => v || '-' },
                    ]}
                  />
                ),
              },
              {
                key: 'rules',
                label: <span>规则 ({extractModelRules.length})</span>,
                children: extractModelRules.length === 0 ? (
                  <Empty description="暂无业务规则" image={Empty.PRESENTED_IMAGE_SIMPLE} />
                ) : (
                  <Table
                    dataSource={extractModelRules}
                    rowKey={(r: any) => r.id}
                    size="small"
                    pagination={{ defaultPageSize: 20, size: 'small' }}
                    columns={[
                      { title: '名称', dataIndex: 'name', key: 'name', width: 140 },
                      { title: '描述', dataIndex: 'description', key: 'description', width: 160, ellipsis: true, render: (v: string) => v || '-' },
                      { title: '类型', dataIndex: 'type', key: 'type', width: 80, render: (v: string) => <Tag>{v}</Tag> },
                      { title: '条件', dataIndex: 'conditionJson', key: 'conditionJson', ellipsis: true, width: 200, render: (v: string) => v || '-' },
                      { title: '动作', dataIndex: 'actionJson', key: 'actionJson', ellipsis: true, width: 200, render: (v: string) => v || '-' },
                      { title: 'SWRL', dataIndex: 'swrlRule', key: 'swrlRule', ellipsis: true, width: 300, render: (v: string) => v ? <code style={{ fontSize: 11 }}>{v}</code> : '-' },
                    ]}
                  />
                ),
              },
              {
                key: 'individuals',
                label: <span>个体 ({extractModelIndividuals.length})</span>,
                children: extractModelIndividuals.length === 0 ? (
                  <Empty description="暂无个体实例" image={Empty.PRESENTED_IMAGE_SIMPLE} />
                ) : (
                  <Table
                    dataSource={extractModelIndividuals}
                    rowKey={(r: any) => r.iri}
                    size="small"
                    pagination={{ defaultPageSize: 20, size: 'small' }}
                    columns={[
                      { title: 'IRI', dataIndex: 'iri', key: 'iri', ellipsis: true, width: 180 },
                      { title: '标签', dataIndex: 'label', key: 'label', width: 120 },
                      { title: '所属类', dataIndex: 'classIri', key: 'classIri', ellipsis: true, width: 180, render: (v: string) => v || '-' },
                      { title: '属性值', dataIndex: 'dataPropertyValues', key: 'dataPropertyValues', width: 300, render: (vals: any[]) => {
                        if (!vals || vals.length === 0) return '-';
                        return (
                          <Space size={2} wrap>
                            {vals.map((dp: any, i: number) => (
                              <Tag key={i} style={{ fontSize: 11 }}>{dp.property}={dp.value}</Tag>
                            ))}
                          </Space>
                        );
                      }},
                    ]}
                  />
                ),
              },
            ]}
          />
        )}
      </Modal>

      {/* 编辑对象类型 Modal */}
      <Modal
        open={editClassModalVisible}
        title="编辑对象类型"
        onCancel={() => setEditClassModalVisible(false)}
        onOk={handleSaveEditClass}
        confirmLoading={editClassSaving}
        destroyOnHidden
      >
        <Form form={form} layout="vertical">
          <Form.Item name="iri" label="IRI" rules={[{ required: true, message: '请输入 IRI' }]}>
            <Input placeholder="http://example.org/ontology#ClassName" />
          </Form.Item>
          <Form.Item name="label" label="名称（标签）" rules={[{ required: true, message: '请输入名称' }]}>
            <Input placeholder="类名称" />
          </Form.Item>
          <Form.Item name="parentIri" label="父类 IRI">
            <Select
              allowClear
              placeholder="选择父类（留空表示顶级类）"
              options={protegeClasses
                .filter((c: any) => c.iri !== selectedNode?.iri && c.id !== selectedNode?.id)
                .map((c: any) => ({ label: c.label || c.iri?.split('/').pop(), value: c.iri || c.id }))
              }
            />
          </Form.Item>
          <Form.Item name="description" label="描述">
            <Input.TextArea rows={3} placeholder="类的描述信息" />
          </Form.Item>
        </Form>
      </Modal>

      {/* 添加对象类型 Modal */}
      <Modal
        open={addClassModalVisible}
        title="添加对象类型"
        onCancel={() => setAddClassModalVisible(false)}
        onOk={handleSaveAddClass}
        confirmLoading={editClassSaving}
        destroyOnHidden
      >
        <Form form={form} layout="vertical">
          <Form.Item name="iri" label="IRI" rules={[{ required: true, message: '请输入 IRI' }]}>
            <Input placeholder="http://example.org/ontology#NewClass" />
          </Form.Item>
          <Form.Item name="label" label="名称（标签）" rules={[{ required: true, message: '请输入名称' }]}>
            <Input placeholder="类名称" />
          </Form.Item>
          <Form.Item name="parentIri" label="父类 IRI">
            <Select
              allowClear
              placeholder="选择父类（留空表示顶级类）"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.iri || c.id,
              }))}
            />
          </Form.Item>
          <Form.Item name="description" label="描述">
            <Input.TextArea rows={3} placeholder="类的描述信息" />
          </Form.Item>
        </Form>
      </Modal>

      {/* 编辑关系 Modal */}
      <Modal
        open={editLinkModalVisible}
        title="编辑对象属性（关系）"
        onCancel={() => setEditLinkModalVisible(false)}
        onOk={handleSaveEditLink}
        confirmLoading={editLinkSaving}
        destroyOnHidden
      >
        <Form form={linkForm} layout="vertical">
          <Form.Item name="iri" label="IRI" rules={[{ required: true, message: '请输入 IRI' }]}>
            <Input placeholder="http://example.org/ontology#hasRelation" />
          </Form.Item>
          <Form.Item name="label" label="名称（标签）" rules={[{ required: true, message: '请输入名称' }]}>
            <Input placeholder="关系名称" />
          </Form.Item>
          <Form.Item name="sourceType" label="定义域（Domain）" rules={[{ required: true, message: '请选择定义域' }]}>
            <Select
              placeholder="选择起始类"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.iri || c.id,
              }))}
            />
          </Form.Item>
          <Form.Item name="targetType" label="值域（Range）" rules={[{ required: true, message: '请选择值域' }]}>
            <Select
              placeholder="选择目标类"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.iri || c.id,
              }))}
            />
          </Form.Item>
          <Form.Item name="description" label="描述">
            <Input.TextArea rows={3} placeholder="关系的描述信息" />
          </Form.Item>
        </Form>
      </Modal>

      {/* 添加关系 Modal */}
      <Modal
        open={addLinkModalVisible}
        title="添加对象属性（关系）"
        onCancel={() => setAddLinkModalVisible(false)}
        onOk={handleSaveAddLink}
        confirmLoading={editLinkSaving}
        destroyOnHidden
      >
        <Form form={linkForm} layout="vertical">
          <Form.Item name="iri" label="IRI" rules={[{ required: true, message: '请输入 IRI' }]}>
            <Input placeholder="http://example.org/ontology#newRelation" />
          </Form.Item>
          <Form.Item name="label" label="名称（标签）" rules={[{ required: true, message: '请输入名称' }]}>
            <Input placeholder="关系名称" />
          </Form.Item>
          <Form.Item name="sourceType" label="定义域（Domain）" rules={[{ required: true, message: '请选择定义域' }]}>
            <Select
              placeholder="选择起始类"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.iri || c.id,
              }))}
            />
          </Form.Item>
          <Form.Item name="targetType" label="值域（Range）" rules={[{ required: true, message: '请选择值域' }]}>
            <Select
              placeholder="选择目标类"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.iri || c.id,
              }))}
            />
          </Form.Item>
          <Form.Item name="description" label="描述">
            <Input.TextArea rows={3} placeholder="关系的描述信息" />
          </Form.Item>
        </Form>
      </Modal>

      {/* 添加数据属性 Modal */}
      <Modal
        open={addDataPropModalVisible}
        title="添加数据属性（DatatypeProperty）"
        onCancel={() => setAddDataPropModalVisible(false)}
        onOk={handleSaveAddDataProperty}
        confirmLoading={dataPropSaving}
        destroyOnHidden
      >
        <Form form={dataPropForm} layout="vertical">
          <Form.Item name="domainClassId" label="定义域（Domain）— 所属类" rules={[{ required: true, message: '请选择所属类' }]}>
            <Select
              placeholder="选择该数据属性所属的类"
              showSearch
              optionFilterProp="label"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.id,
              }))}
            />
          </Form.Item>
          <Form.Item name="iri" label="IRI" rules={[{ required: true, message: '请输入 IRI' }]}>
            <Input placeholder="http://example.org/ontology#hasName" />
          </Form.Item>
          <Form.Item name="label" label="属性名称" rules={[{ required: true, message: '请输入属性名称' }]}>
            <Input placeholder="如：名称、年龄、编号" />
          </Form.Item>
          <Form.Item name="range" label="值域（Range）— 数据类型" rules={[{ required: true, message: '请选择数据类型' }]}>
            <Select
              placeholder="选择 XML Schema 数据类型"
              options={[
                { label: 'xsd:string（字符串）', value: 'xsd:string' },
                { label: 'xsd:integer（整数）', value: 'xsd:integer' },
                { label: 'xsd:int（整型）', value: 'xsd:int' },
                { label: 'xsd:float（浮点数）', value: 'xsd:float' },
                { label: 'xsd:double（双精度）', value: 'xsd:double' },
                { label: 'xsd:boolean（布尔）', value: 'xsd:boolean' },
                { label: 'xsd:date（日期）', value: 'xsd:date' },
                { label: 'xsd:dateTime（日期时间）', value: 'xsd:dateTime' },
                { label: 'xsd:anyURI（URI）', value: 'xsd:anyURI' },
                { label: 'xsd:decimal（十进制）', value: 'xsd:decimal' },
                { label: 'xsd:long（长整型）', value: 'xsd:long' },
              ]}
            />
          </Form.Item>
          <Form.Item name="description" label="描述">
            <Input.TextArea rows={3} placeholder="属性的描述信息" />
          </Form.Item>
        </Form>
      </Modal>

      {/* 编辑数据属性 Modal */}
      <Modal
        open={editDataPropModalVisible}
        title="编辑数据属性（DatatypeProperty）"
        onCancel={() => { setEditDataPropModalVisible(false); setEditingDataProp(null); setEditingDataPropClassId(''); }}
        onOk={handleSaveEditDataProperty}
        confirmLoading={dataPropSaving}
        destroyOnHidden
      >
        <Form form={dataPropForm} layout="vertical">
          <Form.Item name="domainClassId" label="定义域（Domain）— 所属类">
            <Select
              disabled
              placeholder="选择该数据属性所属的类"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.id,
              }))}
            />
          </Form.Item>
          <Form.Item name="iri" label="IRI" rules={[{ required: true, message: '请输入 IRI' }]}>
            <Input placeholder="http://example.org/ontology#hasName" />
          </Form.Item>
          <Form.Item name="label" label="属性名称" rules={[{ required: true, message: '请输入属性名称' }]}>
            <Input placeholder="如：名称、年龄、编号" />
          </Form.Item>
          <Form.Item name="range" label="值域（Range）— 数据类型" rules={[{ required: true, message: '请选择数据类型' }]}>
            <Select
              placeholder="选择 XML Schema 数据类型"
              options={[
                { label: 'xsd:string（字符串）', value: 'xsd:string' },
                { label: 'xsd:integer（整数）', value: 'xsd:integer' },
                { label: 'xsd:int（整型）', value: 'xsd:int' },
                { label: 'xsd:float（浮点数）', value: 'xsd:float' },
                { label: 'xsd:double（双精度）', value: 'xsd:double' },
                { label: 'xsd:boolean（布尔）', value: 'xsd:boolean' },
                { label: 'xsd:date（日期）', value: 'xsd:date' },
                { label: 'xsd:dateTime（日期时间）', value: 'xsd:dateTime' },
                { label: 'xsd:anyURI（URI）', value: 'xsd:anyURI' },
                { label: 'xsd:decimal（十进制）', value: 'xsd:decimal' },
                { label: 'xsd:long（长整型）', value: 'xsd:long' },
              ]}
            />
          </Form.Item>
          <Form.Item name="description" label="描述">
            <Input.TextArea rows={3} placeholder="属性的描述信息" />
          </Form.Item>
        </Form>
      </Modal>

      {/* 添加/编辑继承关系(subClassOf) Modal */}
      <Modal
        open={addSubClassModalVisible}
        title={editingSubClassRecord ? '编辑继承关系（rdfs:subClassOf）' : '添加继承关系（rdfs:subClassOf）'}
        onCancel={() => { setAddSubClassModalVisible(false); setEditingSubClassRecord(null); }}
        onOk={handleSaveAddSubClassOf}
        confirmLoading={subClassSaving}
        destroyOnHidden
      >
        <Form form={subClassForm} layout="vertical">
          <Form.Item name="childIri" label="子类（SubClass）" rules={[{ required: true, message: '请选择子类' }]}>
            <Select
              disabled={!!editingSubClassRecord}
              placeholder="选择需要添加继承关系的子类"
              showSearch
              optionFilterProp="label"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.iri || c.id,
              }))}
            />
          </Form.Item>
          <Form.Item name="parentIri" label="父类（SuperClass）" rules={[{ required: true, message: '请选择父类' }]}>
            <Select
              placeholder="选择要继承的父类"
              showSearch
              optionFilterProp="label"
              options={protegeClasses.map((c: any) => ({
                label: c.label || c.iri?.split('/').pop(),
                value: c.iri || c.id,
              }))}
            />
          </Form.Item>
        </Form>
        <div style={{ background: '#f6f6f6', borderRadius: 6, padding: '8px 12px', marginTop: 8 }}>
          <Text type="secondary" style={{ fontSize: 12 }}>
            <strong>OWL 2 说明：</strong>在 OWL 2 中，rdfs:subClassOf 声明子类与父类之间的继承关系。
            子类自动继承父类的所有属性和约束。继承关系必须是严格的层次结构（无循环继承）。
          </Text>
        </div>
      </Modal>

      {/* 添加业务规则 Modal */}
      <Modal
        open={addRuleModalVisible}
        title="添加业务规则"
        onCancel={() => setAddRuleModalVisible(false)}
        onOk={handleSaveAddRule}
        confirmLoading={ruleSaving}
        width={680}
        destroyOnHidden
      >
        <Form form={ruleForm} layout="vertical">
          <Form.Item name="name" label="规则名称" rules={[{ required: true, message: '请输入规则名称' }]}>
            <Input placeholder="例：高价值客户识别规则" />
          </Form.Item>
          <Form.Item name="description" label="规则描述">
            <Input.TextArea rows={2} placeholder="简要描述该规则的业务含义..." style={{ fontSize: 12 }} />
          </Form.Item>
          <Row gutter={12}>
            <Col span={12}>
              <Form.Item name="type" label="规则类型" rules={[{ required: true }]}>
                <Select
                  options={[
                    { label: '条件规则', value: 'CONDITION' },
                    { label: '事件规则', value: 'EVENT' },
                    { label: '时序规则', value: 'TEMPORAL' },
                    { label: '组合规则', value: 'COMPOSITE' },
                    { label: 'SWRL 语义规则', value: 'SWRL' },
                  ]}
                />
              </Form.Item>
            </Col>
            <Col span={12}>
              <Form.Item name="priority" label="优先级">
                <Select
                  options={[
                    { label: '严重', value: 'CRITICAL' },
                    { label: '高', value: 'HIGH' },
                    { label: '中', value: 'MEDIUM' },
                    { label: '低', value: 'LOW' },
                  ]}
                />
              </Form.Item>
            </Col>
          </Row>
          <Form.Item name="swrlRule" label="SWRL 规则表达式">
            <Input.TextArea
              rows={5}
              placeholder={'例：Person(?x) ^ hasAge(?x, ?age) ^ swrlb:greaterThan(?age, 18) -> Adult(?x)\n\n' +
                '语法：Body(?var1) ^ Body(?var2) ... -> Head(?var1)'}
              style={{ fontFamily: 'Consolas, Monaco, "Courier New", monospace', fontSize: 12 }}
            />
          </Form.Item>
          <Form.Item name="conditionJson" label="条件 (JSON)">
            <Input.TextArea rows={3} placeholder='例：{"field": "客户等级", "operator": "==", "value": "VIP"}' style={{ fontFamily: 'monospace', fontSize: 12 }} />
          </Form.Item>
          <Form.Item name="actionJson" label="动作 (JSON)">
            <Input.TextArea rows={3} placeholder='例：{"action": "推荐产品", "params": {"category": "高端理财"}}' style={{ fontFamily: 'monospace', fontSize: 12 }} />
          </Form.Item>
          <Row gutter={12}>
            <Col span={12}>
              <Form.Item name="confidence" label="置信度">
                <Input type="number" step="0.1" min="0" max="1" placeholder="0.0 ~ 1.0" />
              </Form.Item>
            </Col>
            <Col span={12}>
              <Form.Item name="source" label="来源">
                <Select
                  options={[
                    { label: '人工', value: '人工' },
                    { label: '自动提取', value: '自动提取' },
                  ]}
                />
              </Form.Item>
            </Col>
          </Row>
        </Form>
      </Modal>

      {/* 编辑业务规则 Modal */}
      <Modal
        open={editRuleModalVisible}
        title="编辑业务规则"
        onCancel={() => { setEditRuleModalVisible(false); setSelectedRule(null); }}
        onOk={handleSaveEditRule}
        confirmLoading={ruleSaving}
        width={680}
        destroyOnHidden
      >
        <Form form={ruleForm} layout="vertical">
          <Form.Item name="name" label="规则名称" rules={[{ required: true, message: '请输入规则名称' }]}>
            <Input placeholder="例：高价值客户识别规则" />
          </Form.Item>
          <Form.Item name="description" label="规则描述">
            <Input.TextArea rows={2} placeholder="简要描述该规则的业务含义..." style={{ fontSize: 12 }} />
          </Form.Item>
          <Row gutter={12}>
            <Col span={12}>
              <Form.Item name="type" label="规则类型" rules={[{ required: true }]}>
                <Select
                  options={[
                    { label: '条件规则', value: 'CONDITION' },
                    { label: '事件规则', value: 'EVENT' },
                    { label: '时序规则', value: 'TEMPORAL' },
                    { label: '组合规则', value: 'COMPOSITE' },
                    { label: 'SWRL 语义规则', value: 'SWRL' },
                  ]}
                />
              </Form.Item>
            </Col>
            <Col span={12}>
              <Form.Item name="priority" label="优先级">
                <Select
                  options={[
                    { label: '严重', value: 'CRITICAL' },
                    { label: '高', value: 'HIGH' },
                    { label: '中', value: 'MEDIUM' },
                    { label: '低', value: 'LOW' },
                  ]}
                />
              </Form.Item>
            </Col>
          </Row>
          <Form.Item name="swrlRule" label="SWRL 规则表达式">
            <Input.TextArea
              rows={5}
              placeholder={'例：Person(?x) ^ hasAge(?x, ?age) ^ swrlb:greaterThan(?age, 18) -> Adult(?x)\n\n' +
                '语法：Body(?var1) ^ Body(?var2) ... -> Head(?var1)'}
              style={{ fontFamily: 'Consolas, Monaco, "Courier New", monospace', fontSize: 12 }}
            />
          </Form.Item>
          <Form.Item name="conditionJson" label="条件 (JSON)">
            <Input.TextArea rows={3} placeholder='例：{"field": "客户等级", "operator": "==", "value": "VIP"}' style={{ fontFamily: 'monospace', fontSize: 12 }} />
          </Form.Item>
          <Form.Item name="actionJson" label="动作 (JSON)">
            <Input.TextArea rows={3} placeholder='例：{"action": "推荐产品", "params": {"category": "高端理财"}}' style={{ fontFamily: 'monospace', fontSize: 12 }} />
          </Form.Item>
          <Row gutter={12}>
            <Col span={12}>
              <Form.Item name="confidence" label="置信度">
                <Input type="number" step="0.1" min="0" max="1" placeholder="0.0 ~ 1.0" />
              </Form.Item>
            </Col>
            <Col span={12}>
              <Form.Item name="source" label="来源">
                <Select
                  options={[
                    { label: '人工', value: '人工' },
                    { label: '自动提取', value: '自动提取' },
                  ]}
                />
              </Form.Item>
            </Col>
          </Row>
        </Form>
      </Modal>

      {/* 拖拽创建关系 Modal */}
      <Modal
        title="创建关系"
        open={createEdgeModalVisible}
        onOk={handleCreateEdge}
        onCancel={() => {
          setCreateEdgeModalVisible(false);
          createEdgeForm.resetFields();
          setEdgeDraft(null);
        }}
        confirmLoading={createEdgeSubmitting}
        okText="创建"
        cancelText="取消"
      >
        <Form form={createEdgeForm} layout="vertical" style={{ marginTop: 16 }}>
          <Form.Item label="关系名称" name="label" rules={[{ required: true, message: '请输入关系名称' }]}>
            <Input placeholder="如：hasAccount" />
          </Form.Item>
          <Form.Item label="IRI" name="iri" rules={[{ required: true, message: '请输入 IRI' }]}>
            <Input placeholder="自动生成，可修改" />
          </Form.Item>
          <Form.Item label="描述" name="description">
            <Input.TextArea placeholder="关系描述（可选）" rows={2} />
          </Form.Item>
          {edgeDraft && (
            <Alert
              type="info"
              message={`从 ${protegeClasses.find((c: any) => c.iri === edgeDraft.sourceId)?.label || edgeDraft.sourceId} 到 ${protegeClasses.find((c: any) => c.iri === edgeDraft.targetId)?.label || edgeDraft.targetId}`}
              style={{ marginBottom: 16 }}
            />
          )}
        </Form>
      </Modal>

      {/* 双击编辑关系 Modal */}
      <Modal
        title="编辑关系"
        open={dblclickEditEdgeModalVisible}
        onOk={handleDblclickEditEdge}
        onCancel={() => setDblclickEditEdgeModalVisible(false)}
        confirmLoading={dblclickEditEdgeSubmitting}
        okText="保存"
        cancelText="取消"
      >
        <Form form={dblclickEditEdgeForm} layout="vertical" style={{ marginTop: 16 }}>
          <Form.Item label="关系名称" name="label" rules={[{ required: true, message: '请输入关系名称' }]}>
            <Input />
          </Form.Item>
          <Form.Item label="IRI" name="iri" rules={[{ required: true, message: '请输入 IRI' }]}>
            <Input />
          </Form.Item>
          <Form.Item label="描述" name="description">
            <Input.TextArea rows={2} />
          </Form.Item>
        </Form>
      </Modal>

      {/* 版本对比 Modal */}
      <VersionDiff
        ontologyId={diffOntologyId}
        ontologyName={diffOntologyName}
        open={diffModalOpen}
        onClose={() => setDiffModalOpen(false)}
      />

      {/* 变更历史 Modal */}
      <ChangeHistory
        ontologyName={historyOntologyName}
        open={historyModalOpen}
        onClose={() => setHistoryModalOpen(false)}
      />
    </div>
  );
};

export default OntologyPage;
